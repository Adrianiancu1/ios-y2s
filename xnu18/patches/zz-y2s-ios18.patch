diff --git a/iokit/Kernel/arm/Y2SBattery.cpp b/iokit/Kernel/arm/Y2SBattery.cpp
new file mode 100644
index 0000000..cb24237
--- /dev/null
+++ b/iokit/Kernel/arm/Y2SBattery.cpp
@@ -0,0 +1,319 @@
+/*
+ * Built-in iOS battery bring-up service. Default: 100%, AC, not charging.
+ * y2sbattery=1: read-only PM6150 polling every 30 seconds; voltage-derived
+ * SOC is an UNCALIBRATED estimate, not a replacement for the Linux QG algo.
+ * See report.md for binary evidence, register provenance and integration.
+ */
+#if defined(ARM64_BOARD_CONFIG_Y2S)
+#include <device/device_types.h> /* io_buf_ptr_t for private OSKext headers */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <IOKit/pwr_mgt/IOPMPowerSource.h>
+#include <libkern/c++/OSCollectionIterator.h>
+#include <pexpert/pexpert.h>
+/* bsd/dev/y2s_spmi.c */
+extern "C" int y2s_spmi_init(void);
+extern "C" int y2s_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+
+class Y2SBattery : public IOPMPowerSource {
+	OSDeclareDefaultStructors(Y2SBattery);
+public:
+	bool init(OSDictionary *dictionary = NULL) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+private:
+	IOWorkLoop *fLoop;
+	IOTimerEventSource *fTimer;
+	bool fTimerAdded, fRunning, fReal;
+	int fLastMode;
+	void putNumber(const char *key, UInt32 value);
+	void putBool(const char *key, bool value);
+	void publish(unsigned percent, unsigned mv, int ma, bool external,
+	    bool capable, bool charging, bool full, bool measured, bool currentValid);
+	void poll(void);
+	static void timerFired(OSObject *owner, IOTimerEventSource *sender);
+	static IOReturn stopPolling(OSObject *owner, void *, void *, void *, void *);
+	static bool readWord(unsigned address, uint16_t *value);
+	static unsigned estimatePercent(unsigned mv);
+};
+OSDefineMetaClassAndStructors(Y2SBattery, IOPMPowerSource);
+
+bool
+Y2SBattery::init(OSDictionary *dictionary)
+{
+	/* IOCatalogue calls init(dictionary). This XNU's IOPMPowerSource only
+	 * overrides init(void): explicitly run it to allocate its PS dictionary
+	 * and symbols, then copy the matching personality into the registry. */
+	if (!IOPMPowerSource::init()) {
+		return false;
+	}
+	fLoop = NULL;
+	fTimer = NULL;
+	fTimerAdded = fRunning = fReal = false;
+	if (dictionary) {
+		OSCollectionIterator *it = OSCollectionIterator::withCollection(dictionary);
+		if (!it) {
+			return false;
+		}
+		OSObject *object;
+		bool ok = true;
+		while ((object = it->getNextObject())) {
+			const OSSymbol *key = OSDynamicCast(OSSymbol, object);
+			if (!key || !setProperty(key, dictionary->getObject(key))) {
+				ok = false;
+				break;
+			}
+		}
+		it->release();
+		if (!ok) {
+			return false;
+		}
+	}
+	fLastMode = -1;
+	return true;
+}
+
+void
+Y2SBattery::putNumber(const char *key, UInt32 value)
+{
+	const OSSymbol *symbol = OSSymbol::withCString(key);
+	OSNumber *number = OSNumber::withNumber(value, 32);
+	if (symbol && number) {
+		setPSProperty(symbol, number);
+	}
+	OSSafeReleaseNULL(number);
+	OSSafeReleaseNULL(symbol);
+}
+
+void
+Y2SBattery::putBool(const char *key, bool value)
+{
+	const OSSymbol *symbol = OSSymbol::withCString(key);
+	if (symbol) {
+		setPSProperty(symbol, value ? kOSBooleanTrue : kOSBooleanFalse);
+		symbol->release();
+	}
+}
+
+void
+Y2SBattery::publish(unsigned percent, unsigned mv, int ma, bool external,
+    bool capable, bool charging, bool full, bool measured, bool currentValid)
+{
+	/* Use consistent mAh units (DT nominal=5020). powerd computes C*100/M. */
+	const unsigned capacity = (5020u * percent + 50u) / 100u;
+	setBatteryInstalled(true);
+	setCurrentCapacity(capacity);
+	setMaxCapacity(5020);
+	setExternalConnected(external);
+	setExternalChargeCapable(capable);
+	setIsCharging(charging);
+	setAtWarnLevel(false);
+	/* An uncalibrated voltage curve must not assert a critical shutdown. */
+	setAtCriticalLevel(false);
+	setVoltage(mv);
+	setAmperage(ma);
+	setTimeRemaining(-1); /* Unknown; never publish zero minutes on error. */
+	setCycleCount(0);     /* Placeholder: cycle learning is not implemented. */
+	putBool("FullyCharged", full);
+	putBool("AppleRawExternalConnected", external);
+	putNumber("AppleRawCurrentCapacity", capacity);
+	putNumber("AppleRawMaxCapacity", 5020);
+	putNumber("DesignCapacity", 5020);
+	putNumber("InstantAmperage", (UInt32)ma);
+	/* iOS battery convention: centidegrees C; fixed 25 C, NOT measured. */
+	putNumber("Temperature", 2500);
+	putBool("Y2SBatteryHardwareSampleValid", measured);
+	putBool("Y2SBatteryCurrentValid", currentValid);
+	putBool("Y2SBatterySOCEstimated", measured);
+	putBool("Y2SBatteryTemperatureEstimated", true);
+	putBool("Y2SBatteryFallback", !measured);
+	putNumber("Y2SBatteryPercent", percent);
+
+	/* IOPMCopyBatteryInfo's per-source compatibility dictionary. */
+	OSDictionary *legacy = OSDictionary::withCapacity(7);
+	if (legacy) {
+		const char *keys[] = {kIOBatteryCurrentChargeKey, kIOBatteryCapacityKey,
+		    kIOBatteryVoltageKey, kIOBatteryAmperageKey, kIOBatteryCycleCountKey,
+		    kIOBatteryFlagsKey};
+		UInt32 values[] = {capacity, 5020, mv, (UInt32)ma, 0,
+		    (UInt32)(kIOBatteryInstalled | (external ? kIOBatteryChargerConnect : 0) |
+		    (charging ? kIOBatteryCharge : 0))};
+		for (unsigned i = 0; i < sizeof(values) / sizeof(values[0]); ++i) {
+			OSNumber *number = OSNumber::withNumber(values[i], 32);
+			if (number) {
+				legacy->setObject(keys[i], number);
+				number->release();
+			}
+		}
+		setLegacyIOBatteryInfo(legacy);
+		legacy->release();
+	}
+	updateStatus(); /* Flush PS properties and send 0xe0024100 on change. */
+	int mode = measured ? 1 : 0;
+	if (mode != fLastMode) {
+		IOLog("Y2S BATTERY: %s, %u%% %umV external=%d charging=%d\n",
+		    measured ? "PM6150 / estimated SOC" : "static fallback",
+		    percent, mv, external, charging);
+		fLastMode = mode;
+	}
+}
+
+/* Keep the proven single-byte observer command. Read two matching whole
+ * words to reject most torn ADC samples without writing the QG HOLD bit.
+ * This is a bounded consistency check, not a hardware snapshot guarantee. */
+bool
+Y2SBattery::readWord(unsigned address, uint16_t *value)
+{
+	uint16_t previous = 0;
+	for (unsigned attempt = 0; attempt < 4; ++attempt) {
+		uint8_t lo, hi;
+		if (y2s_spmi_read(0, address, &lo) ||
+		    y2s_spmi_read(0, address + 1, &hi)) {
+			return false;
+		}
+		uint16_t next = (uint16_t)((unsigned)lo | ((unsigned)hi << 8));
+		if (attempt && next == previous) {
+			*value = next;
+			return true;
+		}
+		previous = next;
+	}
+	return false;
+}
+
+unsigned
+Y2SBattery::estimatePercent(unsigned mv)
+{
+	/* Generic single-cell curve, intentionally NOT advertised as QG SOC.
+	 * Load sag, temperature, aging and charging introduce large errors. */
+	static const unsigned volts[] = {3400, 3500, 3600, 3700, 3800, 3900,
+	    4000, 4100, 4200, 4350};
+	static const unsigned soc[] = {1, 5, 10, 20, 40, 60, 75, 85, 93, 100};
+	if (mv <= volts[0]) {
+		return soc[0];
+	}
+	for (unsigned i = 1; i < sizeof(volts) / sizeof(volts[0]); ++i) {
+		if (mv < volts[i]) {
+			return soc[i - 1] + (mv - volts[i - 1]) * (soc[i] - soc[i - 1]) /
+			       (volts[i] - volts[i - 1]);
+		}
+	}
+	return 100;
+}
+
+void
+Y2SBattery::poll(void)
+{
+	uint8_t type, present, usb, path, charger, error, temperature;
+	uint16_t rawVoltage;
+	bool valid = fReal &&
+	    !y2s_spmi_read(0, 0x4804, &type) && type == 0x0d &&
+	    !y2s_spmi_read(0, 0x4808, &present) && (present & 1u) &&
+	    readWord(0x48c0, &rawVoltage) && rawVoltage != 0x8000 &&
+	    !y2s_spmi_read(0, 0x1310, &usb) &&
+	    !y2s_spmi_read(0, 0x110b, &path) &&
+	    !y2s_spmi_read(0, 0x1006, &charger) &&
+	    !y2s_spmi_read(0, 0x1007, &error) &&
+	    !y2s_spmi_read(0, 0x100d, &temperature);
+	unsigned mv = valid ? (unsigned)(((uint64_t)rawVoltage * 194637u) / 1000000u) : 0;
+	/* Zero, reset, floating, or implausible data cannot become 0% battery. */
+	valid = valid && mv >= 2800 && mv <= 4600;
+	if (!valid) {
+		publish(100, 4200, 0, true, true, false, true, false, false);
+		return;
+	}
+	bool external = (usb & 0x10u) != 0;
+	bool capable = external && (path & 0x10u) && (path & 1u) && !(path & 0x40u);
+	unsigned state = charger & 7u;
+	bool charging = capable && state >= 1 && state <= 4 &&
+	    !(error & 2u) && !(temperature & 0x0cu);
+	/* Inhibit (0) does not by itself establish full capacity. */
+	bool full = external && state == 5 && !(error & 2u);
+	int ma = 0;
+	uint8_t subtype;
+	uint16_t rawCurrent;
+	bool currentValid = !y2s_spmi_read(0, 0x4805, &subtype) &&
+	    (subtype == 3 || subtype == 4) && readWord(0x48c2, &rawCurrent) &&
+	    rawCurrent != 0x8000;
+	if (currentValid) {
+		int signedRaw = (rawCurrent & 0x8000u) ? (int)rawCurrent - 65536 : (int)rawCurrent;
+		/* Linux: negative=charging; IOPMPowerSource: positive=charging, mA. */
+		ma = (int)(-((int64_t)signedRaw * (subtype == 3 ? 152588 : 305176)) / 1000000);
+	}
+	publish(full ? 100 : estimatePercent(mv), mv, ma, external, capable,
+	    charging, full, true, currentValid);
+}
+
+void
+Y2SBattery::timerFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	Y2SBattery *self = OSDynamicCast(Y2SBattery, owner);
+	if (self && self->fRunning) {
+		self->poll();
+		sender->setTimeoutMS(30000);
+	}
+}
+
+bool
+Y2SBattery::start(IOService *provider)
+{
+	if (!IOPMPowerSource::start(provider)) {
+		return false;
+	}
+	int real = 0;
+	(void)PE_parse_boot_argn("y2sbattery", &real, sizeof(real));
+	fReal = real == 1 && y2s_spmi_init() == 0;
+	/* Publish a complete source BEFORE registerService wakes powerd. */
+	poll();
+	if (fReal) {
+		fLoop = IOWorkLoop::workLoop();
+		fTimer = IOTimerEventSource::timerEventSource(this, &Y2SBattery::timerFired);
+		if (fLoop && fTimer && fLoop->addEventSource(fTimer) == kIOReturnSuccess) {
+			fTimerAdded = true;
+			fRunning = true;
+			fTimer->setTimeoutMS(30000);
+		} else {
+			fReal = false;
+			poll();
+			IOLog("Y2S BATTERY: timer unavailable; static fallback\n");
+		}
+	}
+	registerService();
+	return true;
+}
+
+void
+Y2SBattery::stop(IOService *provider)
+{
+	if (fLoop && fTimerAdded) {
+		/* Serialize against a running timer callback, including rearming. */
+		(void)fLoop->runAction(&Y2SBattery::stopPolling, this);
+		fLoop->removeEventSource(fTimer);
+		fTimerAdded = false;
+	}
+	IOPMPowerSource::stop(provider);
+}
+
+IOReturn
+Y2SBattery::stopPolling(OSObject *owner, void *, void *, void *, void *)
+{
+	Y2SBattery *self = OSDynamicCast(Y2SBattery, owner);
+	if (!self) {
+		return kIOReturnBadArgument;
+	}
+	self->fRunning = false;
+	self->fTimer->cancelTimeout();
+	self->fTimer->disable();
+	return kIOReturnSuccess;
+}
+
+void
+Y2SBattery::free(void)
+{
+	OSSafeReleaseNULL(fTimer);
+	OSSafeReleaseNULL(fLoop);
+	IOPMPowerSource::free();
+}
+#endif /* ARM64_BOARD_CONFIG_Y2S */
diff --git a/iokit/Kernel/arm/Y2SCPU.cpp b/iokit/Kernel/arm/Y2SCPU.cpp
new file mode 100644
index 0000000..b1d0914
--- /dev/null
+++ b/iokit/Kernel/arm/Y2SCPU.cpp
@@ -0,0 +1,271 @@
+/*
+ * A55 SMP bring-up for y2s using XNU's legacy IOCPU interface and PSCI.
+ * The architected timer and SGI1 already enter through pe_fiq/sleh_irq.
+ * CPU_OFF, suspend and the A76 cores still require separate platform work.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(Y2S)
+#include <IOKit/IOCPU.h>
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+#include <arm64/proc_reg.h>
+#include <machine/atomic.h>
+#include <kern/clock.h>
+#include <kern/processor.h>
+#include <kern/thread.h>
+#include <mach/mach_time.h>
+#include <pexpert/pexpert.h>
+
+extern "C" void y2s_secondary_entry(void);
+extern "C" boolean_t y2s_cpu_signal_is_enabled(unsigned int cpu);
+extern "C" void y2s_gic_send_ipi(unsigned int cpu, uint64_t target_mpidr);
+
+class Y2SCPU;
+static Y2SCPU *y2s_cpus[MAX_CPUS];
+static uint32_t y2s_cpus_registered;
+
+/* SMCCC 1.0: x0 is the signed PSCI result; do not assume x1-x17 survive. */
+static int32_t
+y2s_psci_cpu_on(uint64_t target, uint64_t entry, uint64_t context)
+{
+	register uint64_t x0 __asm__("x0") = 0xC4000003ULL;
+	register uint64_t x1 __asm__("x1") = target;
+	register uint64_t x2 __asm__("x2") = entry;
+	register uint64_t x3 __asm__("x3") = context;
+	/*
+	 * Galaxy S20+: the live DT says psci { method = "hvc"; }. Samsung's
+	 * hypervisor (uH, EL2) forwards PSCI to EL3 and sets the new core up at
+	 * EL2; CPU_ON by smc directly returned 0 but the core never ran.
+	 */
+	__asm__ volatile("hvc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int32_t)x0;
+}
+
+class Y2SCPU : public IOCPU {
+	OSDeclareDefaultStructors(Y2SCPU);
+	const OSSymbol *cpuName = NULL;
+	uint32_t initialized = 0; /* release/acquire publication after initCPU sends SGI */
+
+public:
+	static void startAll(void *arg, wait_result_t result);
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	void initCPU(bool boot) APPLE_KEXT_OVERRIDE;
+	void quiesceCPU(void) APPLE_KEXT_OVERRIDE;
+	kern_return_t startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr) APPLE_KEXT_OVERRIDE;
+	void haltCPU(void) APPLE_KEXT_OVERRIDE;
+	void signalCPU(IOCPU *target) APPLE_KEXT_OVERRIDE;
+	const OSSymbol *getCPUName(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(Y2SCPU, IOCPU);
+
+bool
+Y2SCPU::start(IOService *provider)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	OSNumber *logical = OSDynamicCast(OSNumber, provider->getProperty("logical-cpu-id"));
+	OSData *reg = OSDynamicCast(OSData, provider->getProperty("reg"));
+
+	if (logical == NULL || reg == NULL || reg->getLength() != sizeof(uint32_t) ||
+	    logical->unsigned32BitValue() >= topology->num_cpus) {
+		return false;
+	}
+	const ml_topology_cpu_t *cpu = &topology->cpus[logical->unsigned32BitValue()];
+	if (*(const uint32_t *)reg->getBytesNoCopy() != cpu->phys_id) {
+		return false;
+	}
+	/*
+	 * Galaxy S20+ (Exynos 990, live DT): MPIDR Aff1:Aff0 0x000-0x003 A55,
+	 * 0x004-0x005 A76 (one DynamIQ cluster), 0x100-0x101 M5. Accept Aff1 0-1
+	 * and Aff0 0-15 (the GICv3 SGI target-list limit; GICv2 uses the CPU
+	 * interface mask instead).
+	 */
+	if ((cpu->phys_id & ~0x10fu) != 0 ||
+	    topology->num_cpus > Y2S_SMP_MAX_CPUS) {
+		panic("Y2S CPU: invalid topology cpu=%u mpidr=0x%x count=%u",
+		    cpu->cpu_id, cpu->phys_id, topology->num_cpus);
+	}
+	if (!IOCPU::start(provider)) {
+		return false;
+	}
+	cpuName = OSSymbol::withCStringNoCopy("Kryo 470");
+	if (cpuName == NULL) {
+		return false;
+	}
+	setCPUNumber(cpu->cpu_id);
+
+	ml_processor_info_t info = {};
+	info.cpu_id = reinterpret_cast<cpu_id_t>(this);
+	info.phys_id = cpu->phys_id;
+	info.log_id = cpu->cpu_id;
+	info.cluster_id = cpu->cluster_id;
+	info.cluster_type = cpu->cluster_type;
+	info.l2_cache_id = cpu->l2_cache_id;
+	info.l2_cache_size = cpu->l2_cache_size;
+	info.l3_cache_id = cpu->l3_cache_id;
+	info.l3_cache_size = cpu->l3_cache_size;
+	perfmon_interrupt_handler_func pmi_handler = NULL;
+	kern_return_t result = ml_processor_register(&info, &machProcessor, &ipi_handler, &pmi_handler);
+	if (result != KERN_SUCCESS) {
+		panic("Y2S CPU: ml_processor_register failed: %d", result);
+	}
+	if (pmi_handler != NULL) {
+		panic("Y2S CPU: PMI routing is not implemented");
+	}
+
+	registerService();
+	__atomic_store_n(&y2s_cpus[cpu->cpu_id], this, __ATOMIC_RELEASE);
+	__atomic_add_fetch(&y2s_cpus_registered, 1, __ATOMIC_ACQ_REL);
+	if (cpu == topology->boot_cpu) {
+		thread_t thread;
+		result = kernel_thread_start(&Y2SCPU::startAll, NULL, &thread);
+		if (result != KERN_SUCCESS) {
+			panic("Y2S CPU: cannot create startup thread: %d", result);
+		}
+		thread_deallocate(thread);
+	}
+	return true;
+}
+
+/* Do not wait in a nub's start(): matching can be asynchronous or serialized. */
+void
+Y2SCPU::startAll(void *arg __unused, wait_result_t result __unused)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	uint32_t requested = 1;
+	PE_parse_boot_argn("cpus", &requested, sizeof(requested));
+	IOLog("Y2S CPU: requested=%u selected=%u (limit=%u)\n",
+	    requested, topology->num_cpus, Y2S_SMP_MAX_CPUS);
+
+	uint64_t deadline;
+	nanoseconds_to_deadline(10 * NSEC_PER_SEC, &deadline);
+	while (__atomic_load_n(&y2s_cpus_registered, __ATOMIC_ACQUIRE) != topology->num_cpus) {
+		if (mach_absolute_time() > deadline) {
+			for (unsigned int i = 0; i < topology->num_cpus; i++) {
+				if (__atomic_load_n(&y2s_cpus[i], __ATOMIC_ACQUIRE) == NULL) {
+					IOLog("Y2S CPU: cpu=%u NOT registered (IOKit matching timeout)\n", i);
+				}
+			}
+			panic("Y2S CPU: CPU registration timeout");
+		}
+		IOSleep(1);
+	}
+	/* The supplied ADT has cpu0 as the boot CPU and ascending A55 nodes. */
+	if (topology->boot_cpu->cpu_id != 0 || topology->boot_cpu->phys_id != 0) {
+		panic("Y2S CPU: expected boot MPIDR 0 and logical CPU 0");
+	}
+	for (unsigned int i = 0; i < topology->num_cpus; i++) {
+		Y2SCPU *cpu = __atomic_load_n(&y2s_cpus[i], __ATOMIC_ACQUIRE);
+		kern_return_t kr = processor_start(cpu->machProcessor);
+		if (kr != KERN_SUCCESS) {
+			panic("Y2S CPU: cpu=%u processor_start failed: %d", i, kr);
+		}
+		/* processor_start() is asynchronous for secondaries in this XNU. */
+		nanoseconds_to_deadline(5 * NSEC_PER_SEC, &deadline);
+		while (__atomic_load_n(&cpu->initialized, __ATOMIC_ACQUIRE) == 0 ||
+		    !y2s_cpu_signal_is_enabled(i)) {
+			if (mach_absolute_time() > deadline) {
+				IOLog("Y2S CPU: cpu=%u mpidr=0x%x NOT alive after 5s\n",
+				    i, topology->cpus[i].phys_id);
+				panic("Y2S CPU: cpu=%u startup timeout (reset/MMU/GIC/SGI)", i);
+			}
+			IOSleep(1);
+		}
+		IOLog("Y2S CPU: cpu=%u mpidr=0x%x came alive; SGI1 OK\n",
+		    i, topology->cpus[i].phys_id);
+	}
+	/* Publish exactly once, after every selected CPU has completed initCPU(). */
+	ml_cpu_init_completed();
+	__atomic_load_n(&y2s_cpus[topology->boot_cpu->cpu_id], __ATOMIC_ACQUIRE)->cpusRunning();
+	IOService::publishResource(gIOAllCPUInitializedKey, kOSBooleanTrue);
+	ml_set_max_cpus(topology->max_cpu_id + 1);
+	IOLog("Y2S CPU: %u/%u CPUs initialized, SGI1 verified\n",
+	    topology->num_cpus, topology->num_cpus);
+	thread_terminate(current_thread());
+}
+
+void
+Y2SCPU::free(void)
+{
+	OSSafeReleaseNULL(cpuName);
+	IOCPU::free();
+}
+
+void
+Y2SCPU::initCPU(bool boot)
+{
+	if (!boot) {
+		panic("Y2S CPU: cpu=%u resume is not implemented", getCPUNumber());
+	}
+	assert(cpu_number() == (int)getCPUNumber());
+
+	ml_broadcast_cpu_event(CPU_BOOTED, getCPUNumber());
+
+	/* Secondary startup runs at splsched: queue the self-IPI and return.
+	 * startAll waits for its delivery after the startup thread unmasks IRQs.
+	 * Waiting here with DAIF.I set would deadlock every secondary. */
+	signalCPU(this);
+	setCPUState(kIOCPUStateRunning);
+	kprintf("Y2S CPU: cpu=%u entered initCPU mpidr=0x%llx EL%llu IRQs=%u\n",
+	    getCPUNumber(), __builtin_arm_rsr64("MPIDR_EL1") & 0xffffULL,
+	    __builtin_arm_rsr64("CurrentEL") >> 2, ml_get_interrupts_enabled());
+	__atomic_store_n(&initialized, 1, __ATOMIC_RELEASE);
+}
+
+void
+Y2SCPU::signalCPU(IOCPU *target)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	unsigned int logical = target->getCPUNumber();
+	if (logical >= topology->num_cpus) {
+		panic("Y2S CPU: invalid SGI target %u", logical);
+	}
+	/* GICv3: ICC_SGI1R_EL1 by target MPIDR; GICv2: GICD_SGIR by CPU interface. */
+	y2s_gic_send_ipi(logical, topology->cpus[logical].phys_id);
+}
+
+kern_return_t
+Y2SCPU::startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr)
+{
+	const ml_topology_cpu_t *cpu = &ml_get_topology_info()->cpus[getCPUNumber()];
+	/* cpu_start() passes NULL,NULL: x20/x21 are set by LowResetVectorBase. */
+	if (start_paddr != 0 || arg_paddr != 0 || cpu->phys_id == 0 ||
+	    __atomic_load_n(&initialized, __ATOMIC_ACQUIRE) != 0) {
+		panic("Y2S CPU: cpu=%u unsupported restart", getCPUNumber());
+	}
+	vm_offset_t entry = ml_static_vtop((vm_offset_t)&y2s_secondary_entry);
+	IOLog("Y2S CPU: cpu=%u CPU_ON target=0x%x entry_pa=0x%llx context=%u\n",
+	    getCPUNumber(), cpu->phys_id, (uint64_t)entry, getCPUNumber());
+	__builtin_arm_dsb(DSB_SY);
+	int32_t rc = y2s_psci_cpu_on(cpu->phys_id, entry, getCPUNumber());
+	IOLog("Y2S CPU: cpu=%u PSCI CPU_ON rc=%d\n", getCPUNumber(), rc);
+	/* cpu_start() discards PE_cpu_start's return; do not silently carry on. */
+	if (rc != 0) {
+		panic("Y2S CPU: cpu=%u NOT alive: PSCI CPU_ON rc=%d", getCPUNumber(), rc);
+	}
+	return KERN_SUCCESS;
+}
+
+void
+Y2SCPU::quiesceCPU(void)
+{
+	panic("Y2S CPU: CPU quiesce is not implemented");
+}
+
+void
+Y2SCPU::haltCPU(void)
+{
+	panic("Y2S CPU: CPU halt/suspend is not implemented");
+}
+
+const OSSymbol *
+Y2SCPU::getCPUName(void)
+{
+	return cpuName;
+}
+#endif /* Y2S */
diff --git a/iokit/Kernel/arm/Y2SEntitlements.cpp b/iokit/Kernel/arm/Y2SEntitlements.cpp
new file mode 100644
index 0000000..5b8a52e
--- /dev/null
+++ b/iokit/Kernel/arm/Y2SEntitlements.cpp
@@ -0,0 +1,184 @@
+/*
+ * Entitlements for the Y2S built-in AMFI interface (bsd/kern/y2s_amfi.c).
+ *
+ * Apple's AMFI keeps a CoreEntitlements context per code signature; that
+ * library is closed. Here each signature with an XML entitlements blob gets
+ * a Y2SEntitlements object: the blob parsed into an OSDictionary (the
+ * representation IOKit and the kernel KPIs hand out) plus the original XML,
+ * which csops(CS_OPS_ENTITLEMENTS_BLOB) returns. The blob was already
+ * checked against the code directory by csblob_get_entitlements().
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(Y2S)
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSUnserialize.h>
+#include <kern/cs_blobs.h>
+
+class Y2SEntitlements : public OSObject {
+	OSDeclareDefaultStructors(Y2SEntitlements);
+
+public:
+	OSDictionary *dict;
+	CS_GenericBlob *xml;            /* the signature's blob, header included */
+	size_t xml_len;
+
+	bool init(void) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(Y2SEntitlements, OSObject);
+
+bool
+Y2SEntitlements::init(void)
+{
+	return OSObject::init();
+}
+
+void
+Y2SEntitlements::free(void)
+{
+	OSSafeReleaseNULL(dict);
+	if (xml) {
+		kfree_data(xml, xml_len);
+		xml = NULL;
+	}
+	OSObject::free();
+}
+
+static Y2SEntitlements *
+y2s_ent(const void *obj)
+{
+	return OSDynamicCast(Y2SEntitlements, (OSObject *)(uintptr_t)obj);
+}
+
+extern "C" {
+/* Parsed entitlements for one XML blob (header included), or NULL. Retained. */
+void *
+y2s_entitlements_create(const CS_GenericBlob *blob, size_t blob_len)
+{
+	if (blob == NULL || blob_len <= sizeof(CS_GenericBlob) ||
+	    ntohl(blob->magic) != CSMAGIC_EMBEDDED_ENTITLEMENTS ||
+	    ntohl(blob->length) != blob_len) {
+		return NULL;
+	}
+
+	/* OSUnserializeXML needs a terminating NUL inside the buffer. */
+	size_t text_len = blob_len - sizeof(CS_GenericBlob);
+	char *text = (char *)kalloc_data(text_len + 1, Z_WAITOK);
+	if (text == NULL) {
+		return NULL;
+	}
+	memcpy(text, blob->data, text_len);
+	text[text_len] = '\0';
+	OSObject *parsed = OSUnserializeXML(text, text_len + 1);
+	kfree_data(text, text_len + 1);
+
+	OSDictionary *dict = OSDynamicCast(OSDictionary, parsed);
+	if (dict == NULL) {
+		OSSafeReleaseNULL(parsed);
+		return NULL;
+	}
+
+	Y2SEntitlements *ent = OSTypeAlloc(Y2SEntitlements);
+	CS_GenericBlob *xml = (CS_GenericBlob *)kalloc_data(blob_len, Z_WAITOK);
+	if (ent == NULL || !ent->init() || xml == NULL) {
+		OSSafeReleaseNULL(ent);
+		if (xml) {
+			kfree_data(xml, blob_len);
+		}
+		dict->release();
+		return NULL;
+	}
+	memcpy(xml, blob, blob_len);
+	ent->dict = dict;
+	ent->xml = xml;
+	ent->xml_len = blob_len;
+	return ent;
+}
+
+/* The entitlements as an OSDictionary. Retained. */
+void *
+y2s_entitlements_copy_dict(const void *obj)
+{
+	Y2SEntitlements *ent = y2s_ent(obj);
+	if (ent == NULL) {
+		return NULL;
+	}
+	ent->dict->retain();
+	return ent->dict;
+}
+
+/* A kalloc_data copy of the XML blob; the caller frees it (blob length). */
+bool
+y2s_entitlements_copy_xml(const void *obj, CS_GenericBlob **out)
+{
+	Y2SEntitlements *ent = y2s_ent(obj);
+	if (ent == NULL) {
+		return false;
+	}
+	CS_GenericBlob *copy = (CS_GenericBlob *)kalloc_data(ent->xml_len, Z_WAITOK);
+	if (copy == NULL) {
+		return false;
+	}
+	memcpy(copy, ent->xml, ent->xml_len);
+	*out = copy;
+	return true;
+}
+
+/* name is true (a boolean entitlement). */
+bool
+y2s_entitlements_bool(const void *obj, const char *name)
+{
+	Y2SEntitlements *ent = y2s_ent(obj);
+	return ent != NULL && ent->dict->getObject(name) == kOSBooleanTrue;
+}
+
+/* name is the string value, or an array containing it. */
+bool
+y2s_entitlements_string(const void *obj, const char *name, const char *value)
+{
+	Y2SEntitlements *ent = y2s_ent(obj);
+	if (ent == NULL || value == NULL) {
+		return false;
+	}
+	OSObject *v = ent->dict->getObject(name);
+	OSString *s = OSDynamicCast(OSString, v);
+	if (s != NULL) {
+		return s->isEqualTo(value);
+	}
+	OSArray *a = OSDynamicCast(OSArray, v);
+	for (unsigned int i = 0; a != NULL && i < a->getCount(); i++) {
+		s = OSDynamicCast(OSString, a->getObject(i));
+		if (s != NULL && s->isEqualTo(value)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Number of entitlements. */
+unsigned int
+y2s_entitlements_count(const void *obj)
+{
+	Y2SEntitlements *ent = y2s_ent(obj);
+	return ent != NULL ? ent->dict->getCount() : 0;
+}
+
+/* The value of name, or NULL. Retained. */
+void *
+y2s_entitlements_copy_object(const void *obj, const char *name)
+{
+	Y2SEntitlements *ent = y2s_ent(obj);
+	OSObject *v = ent != NULL ? ent->dict->getObject(name) : NULL;
+	if (v != NULL) {
+		v->retain();
+	}
+	return v;
+}
+}
+#endif /* Y2S */
diff --git a/iokit/Kernel/arm/Y2SFramebuffer.cpp b/iokit/Kernel/arm/Y2SFramebuffer.cpp
new file mode 100644
index 0000000..e28d464
--- /dev/null
+++ b/iokit/Kernel/arm/Y2SFramebuffer.cpp
@@ -0,0 +1,682 @@
+/*
+ * Built-in IOMobileFramebuffer for Y2S: the ABL's continuous-splash
+ * framebuffer (1080x2400 a8r8g8b8 in RAM, the panel scans it out by
+ * itself) as the main display, driven by CoreAnimation's CPU renderer.
+ *
+ * IOMobileFramebuffer.framework (iOS 16.7) counts /arm-io children with
+ * device_type "display-subsystem", waits for that many services matching
+ * IOServiceMatching("IOMobileFramebuffer"), opens each with type 0 and
+ * reads canvas-width/canvas-height from the service's provider. The class
+ * here (AppleCLCD, an IOMobileFramebuffer) matches the /arm-io/disp0 nub.
+ *
+ * User client selectors used by CoreAnimation:
+ *   3  GetLayerDefaultSurface [layer, ?] -> [IOSurface port name]
+ *   4  SwapBegin -> [swap id]
+ *   5  SwapEnd, struct 0x46c: +0x50 swap id, +0x54 IOSurface id per layer
+ *      (4 layers), +0x64 rect a / +0xc4 rect b per layer (int x,y,w,h),
+ *      +0x104 enabled layer mask
+ *   6  SwapWait, 7 GetID, 8 GetDisplaySize -> [w, h],
+ *   12 RequestPowerChange [state]: 0 = display off (backboardd, power
+ *      button / auto-lock), else on. Off fades the panel out over a few
+ *      vsyncs (halving each pixel) and keeps it black until on again;
+ *      the panel itself stays powered (AMOLED black pixels are off).
+ *   18 IsMainDisplay,
+ *   28 GetDotPitch, 72 Enable/DisableNotifications [func, refcon, type, 0]
+ * Everything else is accepted and logged once.
+ *
+ * SwapEnd copies the enabled layers' surfaces into the panel memory (no
+ * scaling, CPU copy). Vsync (notification type 5) is a 60 Hz timer that
+ * sends (count, mach_absolute_time, 0) as 32-bit halves to clients that
+ * enabled it, through the port they registered (IOConnectSetNotificationPort).
+ *
+ * The panel memory itself is published as an IOSurface and returned as the
+ * default framebuffer surface. The kernel text console keeps drawing over
+ * the GUI by default: boot-arg y2sfb_noconsole=1 stops drawing it from
+ * the first swap on (it still reaches the persistent log; panics draw).
+ */
+#include "Y2SSurface.h"
+
+extern "C" int y2s_console_muted;     /* osfmk/console/serial_console.c */
+
+#if defined(Y2S)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <IOKit/system.h>
+#include <pexpert/pexpert.h>
+#include <kern/clock.h>
+#include <sys/proc.h>
+
+enum {
+	kY2SFBGetLayerDefaultSurface  = 3,
+	kY2SFBSwapBegin               = 4,
+	kY2SFBSwapEnd                 = 5,
+	kY2SFBSwapWait                = 6,
+	kY2SFBGetID                   = 7,
+	kY2SFBGetDisplaySize          = 8,
+	kY2SFBRequestPowerChange      = 12,
+	kY2SFBIsMainDisplay           = 18,
+	kY2SFBGetDotPitch             = 28,
+	kY2SFBNotifications           = 72,
+};
+
+#define Y2S_FB_SWAP_REC_SIZE          0x46c
+#define Y2S_FB_LAYERS                 4
+#define Y2S_FB_NOTIFY_TYPES           8
+#define Y2S_FB_NOTIFY_VSYNC           5
+#define Y2S_FB_VSYNC_US               16667
+#define Y2S_FB_DOT_PITCH              458     /* ppi, as the iPhone X panel */
+/*
+ * The iOS userland only has status bar / layout data for real iPhone
+ * screens (UIKit: "No status bar visual provider for screen", the red
+ * rdar://45025538 bar for 360x800 points). The display is therefore
+ * presented as the iPhone X panel, 1125x2436 (375x812 points @3x), and the
+ * centered 1080x2400 part of it is shown on the 1080x2400 panel.
+ * Boot-arg y2sfb_native=1 presents the real panel size instead.
+ */
+#define Y2S_FB_LOGICAL_W              1125
+#define Y2S_FB_LOGICAL_H              2436
+#define Y2S_FB_FORMAT_BGRA            0x42475241
+
+class IOMobileFramebuffer : public IOService {
+	OSDeclareDefaultStructors(IOMobileFramebuffer);
+};
+
+OSDefineMetaClassAndStructors(IOMobileFramebuffer, IOService);
+
+class IOMobileFramebufferUserClient;
+
+class AppleCLCD : public IOMobileFramebuffer {
+	OSDeclareDefaultStructors(AppleCLCD);
+
+	IOWorkLoop         *fWorkLoop;
+	IOTimerEventSource *fVsync;
+	uint64_t            fVsyncCount;
+
+	static void vsyncFired(OSObject *owner, IOTimerEventSource *sender);
+
+public:
+	uint64_t      fPhys;
+	uint32_t      fWidth, fHeight, fRowBytes;
+	uint32_t      fLogicalW, fLogicalH;     /* size reported to userland */
+	int32_t       fOffX, fOffY;             /* logical origin of the panel */
+	bool          fScaled;                  /* 1125-wide logical -> 1440 panel, x32/25 */
+	bool          fPadCleared;
+	int32_t       fPadY;                    /* panel rows above the scaled image */
+	uintptr_t     fPixels;          /* kernel mapping of the panel memory */
+	IOMemoryMap  *fMap;
+	Y2SSurface *fSurface;         /* the panel memory as an IOSurface */
+	IOLock       *fLock;            /* swaps and client list */
+	OSArray      *fClients;
+	uint32_t      fSwapID;
+	bool          fConsolePaused;
+	uint8_t       fPending[Y2S_FB_SWAP_REC_SIZE];     /* latest swap, not yet shown */
+	bool          fDirty;
+	uint32_t      fFlushTicks;    /* vsync ticks between panel copies */
+	bool          fPowerOff;      /* RequestPowerChange(0) */
+	uint32_t      fFadeStep;      /* fade-out steps done while off */
+
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void addClient(IOMobileFramebufferUserClient *client);
+	void removeClient(IOMobileFramebufferUserClient *client);
+	void swap(const uint8_t *rec);
+	void present(const uint8_t *rec);
+	void presentScaled(Y2SSurface *s, uintptr_t src, uint32_t bpe, int32_t sx, int32_t sy,
+	    int32_t dx, int32_t dy, int32_t w, int32_t h);
+};
+
+OSDefineMetaClassAndStructors(AppleCLCD, IOMobileFramebuffer);
+
+class IOMobileFramebufferUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IOMobileFramebufferUserClient);
+
+public:
+	AppleCLCD          *fFB;
+	task_t              fTask;
+	mach_port_t         fPort;
+	io_user_reference_t fFunc[Y2S_FB_NOTIFY_TYPES];
+	io_user_reference_t fRefcon[Y2S_FB_NOTIFY_TYPES];
+
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn registerNotificationPort(mach_port_t port, UInt32 type,
+	    io_user_reference_t refCon) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+	void notify(uint32_t type, const uint64_t *values, uint32_t count);
+};
+
+OSDefineMetaClassAndStructors(IOMobileFramebufferUserClient, IOUserClient);
+
+bool
+AppleCLCD::start(IOService *provider)
+{
+	PE_Video video;
+
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	PE_current_console(&video);
+	fPhys = video.v_baseAddr;
+	fWidth = (uint32_t)video.v_width;
+	fHeight = (uint32_t)video.v_height;
+	fRowBytes = (uint32_t)video.v_rowBytes;
+	if (fPhys == 0 || fWidth == 0 || fHeight == 0 || fRowBytes < fWidth * 4) {
+		IOLog("Y2S FB: no boot framebuffer\n");
+		return false;
+	}
+	int native = 0;
+	PE_parse_boot_argn("y2sfb_native", &native, sizeof(native));
+	fLogicalW = fWidth;
+	fLogicalH = fHeight;
+	/*
+	 * Panels larger than the iPhone X (Galaxy S20+: 1440x3200) show the
+	 * presented 1125x2436 centred, with a black border; the copy below
+	 * clips both ways (negative fOffX/fOffY).
+	 */
+	if (!native) {
+		fLogicalW = Y2S_FB_LOGICAL_W;
+		fLogicalH = Y2S_FB_LOGICAL_H;
+	}
+	fOffX = (int32_t)(fLogicalW - fWidth) / 2;
+	/*
+	 * Galaxy S20+: stretch the presented 1125x2436 by 32/25 (= 1440/1125)
+	 * to 1440x3118, centred vertically. y2sfb_scale=0 keeps it 1:1 centred.
+	 */
+	{
+		int scale = 1;
+		PE_parse_boot_argn("y2sfb_scale", &scale, sizeof(scale));
+		fScaled = !native && scale != 0 && fLogicalW * 32 == fWidth * 25 &&
+		    (fLogicalH * 32 + 24) / 25 <= fHeight;
+		fPadY = fScaled ? (int32_t)(fHeight - (fLogicalH * 32 + 24) / 25) / 2 : 0;
+		fPadCleared = false;
+	}
+	fOffY = (int32_t)(fLogicalH - fHeight) / 2;
+	fLock = IOLockAlloc();
+	fClients = OSArray::withCapacity(4);
+	fSurface = y2s_surface_create_physical(fPhys, fWidth, fHeight, fRowBytes, Y2S_FB_FORMAT_BGRA);
+	fPixels = fSurface != NULL ? fSurface->kernelAddress() : 0;
+	fWorkLoop = IOWorkLoop::workLoop();
+	if (fLock == NULL || fClients == NULL || fPixels == 0 || fWorkLoop == NULL) {
+		IOLog("Y2S FB: setup failed\n");
+		OSSafeReleaseNULL(fSurface);    /* stays published: also held by the table */
+		OSSafeReleaseNULL(fWorkLoop);
+		return false;
+	}
+	fVsync = IOTimerEventSource::timerEventSource(this, &AppleCLCD::vsyncFired);
+	if (fVsync == NULL || fWorkLoop->addEventSource(fVsync) != kIOReturnSuccess) {
+		IOLog("Y2S FB: no vsync timer\n");
+		return false;
+	}
+	uint32_t hz = 10;
+	PE_parse_boot_argn("y2sfb_hz", &hz, sizeof(hz));
+	fFlushTicks = (hz == 0 || hz >= 60) ? 1 : 60 / hz;
+	fVsync->setTimeoutUS(Y2S_FB_VSYNC_US);
+
+	setProperty(kIOUserClientClassKey, "IOMobileFramebufferUserClient");
+	setProperty("external", false);
+	setProperty("DisplayPipePlaneBaseAlignment", 64ULL, 32);
+	registerService();
+	IOLog("Y2S FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u\n",
+	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH);
+	return true;
+}
+
+void
+AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	uint64_t now = mach_absolute_time();
+	uint64_t count = ++fb->fVsyncCount;
+	uint64_t values[6] = {
+		(uint32_t)count, (uint32_t)(count >> 32),
+		(uint32_t)now, (uint32_t)(now >> 32),
+		0, 0,
+	};
+
+	IOLockLock(fb->fLock);
+	for (unsigned int i = 0; i < fb->fClients->getCount(); i++) {
+		IOMobileFramebufferUserClient *client =
+		    (IOMobileFramebufferUserClient *)fb->fClients->getObject(i);
+		client->notify(Y2S_FB_NOTIFY_VSYNC, values, 6);
+	}
+	if (fb->fPowerOff) {
+		/* Fade out: halve every channel each vsync, then black, then idle. */
+		uint32_t step = fb->fFadeStep;
+		if (step <= 6) {
+			fb->fFadeStep = step + 1;
+		}
+		IOLockUnlock(fb->fLock);
+		if (step <= 6) {
+			for (uint32_t y = 0; y < fb->fHeight; y++) {
+				volatile uint32_t *row = (volatile uint32_t *)(fb->fPixels + (uint64_t)y * fb->fRowBytes);
+				for (uint32_t x = 0; x < fb->fWidth; x++) {
+					row[x] = step < 6 ? (row[x] >> 1) & 0x7f7f7f7f : 0;
+				}
+			}
+		}
+		sender->setTimeoutUS(Y2S_FB_VSYNC_US);
+		return;
+	}
+	bool flush = fb->fDirty && (count % fb->fFlushTicks) == 0;
+	uint8_t *rec = NULL;
+	if (flush) {
+		rec = (uint8_t *)IOMallocData(Y2S_FB_SWAP_REC_SIZE);
+		if (rec != NULL) {
+			memcpy(rec, fb->fPending, Y2S_FB_SWAP_REC_SIZE);
+			fb->fDirty = false;
+		}
+	}
+	IOLockUnlock(fb->fLock);
+	if (rec != NULL) {
+		fb->present(rec);
+		IOFreeData(rec, Y2S_FB_SWAP_REC_SIZE);
+	}
+	sender->setTimeoutUS(Y2S_FB_VSYNC_US);
+}
+
+void
+AppleCLCD::addClient(IOMobileFramebufferUserClient *client)
+{
+	IOLockLock(fLock);
+	fClients->setObject(client);
+	IOLockUnlock(fLock);
+}
+
+void
+AppleCLCD::removeClient(IOMobileFramebufferUserClient *client)
+{
+	IOLockLock(fLock);
+	unsigned int i = fClients->getNextIndexOfObject(client, 0);
+	if (i != (unsigned int)-1) {
+		fClients->removeObject(i);
+	}
+	IOLockUnlock(fLock);
+}
+
+static uint32_t
+get32(const uint8_t *p, uint32_t off)
+{
+	uint32_t v;
+	memcpy(&v, p + off, 4);
+	return v;
+}
+
+static uint32_t y2s_fb_swaps_logged;
+static uint64_t y2s_fb_swap_count;
+
+/* Copy each enabled layer's surface into the panel memory (no scaling). */
+/*
+ * A swap only records the frame: copying 10 MB into the panel on every
+ * swap (backboardd presents at 60 Hz) took the whole CPU. The vsync timer
+ * shows the latest frame every fFlushTicks ticks (boot-arg y2sfb_hz,
+ * default 10 Hz).
+ */
+void
+AppleCLCD::swap(const uint8_t *rec)
+{
+	IOLockLock(fLock);
+	memcpy(fPending, rec, Y2S_FB_SWAP_REC_SIZE);
+	fDirty = true;
+	IOLockUnlock(fLock);
+	if ((++y2s_fb_swap_count % 1000) == 0) {
+		IOLog("Y2S FB: %llu swaps\n", y2s_fb_swap_count);
+	}
+}
+
+void
+AppleCLCD::present(const uint8_t *rec)
+{
+	uint32_t mask = get32(rec, 0x104);
+
+
+	if (!fConsolePaused) {
+		int quiet = 0;
+		fConsolePaused = true;
+		if (PE_parse_boot_argn("y2sfb_noconsole", &quiet, sizeof(quiet)) && quiet != 0) {
+			/* Not PE_initialize_console(kPEDisableScreen): its console switch
+			 * writes the read-only-late cons_ops_index and panics. */
+			y2s_console_muted = 1;
+		}
+	}
+
+	for (uint32_t layer = 0; layer < Y2S_FB_LAYERS; layer++) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		const uint8_t *a = rec + 0x64 + 16 * layer;
+		const uint8_t *b = rec + 0xc4 + 16 * layer;
+		int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+		int32_t dx = (int32_t)get32(b, 0), dy = (int32_t)get32(b, 4);
+		int32_t w = (int32_t)get32(b, 8), h = (int32_t)get32(b, 12);
+
+		if (!(mask & (1u << layer)) || id == 0) {
+			continue;
+		}
+		Y2SSurface *s = y2s_surface_copy(id);
+		if (y2s_fb_swaps_logged < 16) {
+			y2s_fb_swaps_logged++;
+			IOLog("Y2S FB: swap %u layer %u surface %u %ux%u fmt 0x%x bpr %u a %d,%d %ux%u b %d,%d %dx%d\n",
+			    get32(rec, 0x50), layer, id, s ? s->width : 0, s ? s->height : 0,
+			    s ? s->pixelFormat : 0, s ? s->bytesPerRow : 0, sx, sy, get32(a, 8),
+			    get32(a, 12), dx, dy, w, h);
+		}
+		if (s == NULL || s == fSurface) {
+			OSSafeReleaseNULL(s);
+			continue;
+		}
+		uintptr_t src = s->kernelAddress();
+		uint32_t bpe = s->bytesPerElement ? s->bytesPerElement : 4;
+		if (w <= 0 || h <= 0) {
+			w = (int32_t)s->width;
+			h = (int32_t)s->height;
+		}
+		if (sx < 0 || sy < 0) {
+			sx = sy = 0;
+		}
+		if (dx < 0 || dy < 0) {
+			dx = dy = 0;
+		}
+		if (fScaled) {
+			presentScaled(s, src, bpe, sx, sy, dx, dy, w, h);
+			s->release();
+			continue;
+		}
+		/* Logical (presented) display coordinates -> panel coordinates. */
+		dx -= fOffX;
+		dy -= fOffY;
+		if (dx < 0) {
+			sx -= dx;
+			w += dx;
+			dx = 0;
+		}
+		if (dy < 0) {
+			sy -= dy;
+			h += dy;
+			dy = 0;
+		}
+		if (w > (int32_t)s->width - sx) {
+			w = (int32_t)s->width - sx;
+		}
+		if (h > (int32_t)s->height - sy) {
+			h = (int32_t)s->height - sy;
+		}
+		if (w > (int32_t)fWidth - dx) {
+			w = (int32_t)fWidth - dx;
+		}
+		if (h > (int32_t)fHeight - dy) {
+			h = (int32_t)fHeight - dy;
+		}
+		uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow +
+		    (uint64_t)(sx + w) * 4;
+		if (w <= 0 || h <= 0 || s->elementWidth != 1 || s->elementHeight != 1 ||
+		    s->memory == NULL || last > s->memory->getLength()) {
+			src = 0;
+		}
+		if (src != 0 && bpe == 4) {
+			for (int32_t y = 0; y < h; y++) {
+				memcpy((void *)(fPixels + (uint64_t)(dy + y) * fRowBytes + (uint64_t)dx * 4),
+				    (const void *)(src + s->offset + (uint64_t)(sy + y) * s->bytesPerRow + (uint64_t)sx * 4),
+				    (size_t)w * 4);
+			}
+		}
+		s->release();
+	}
+}
+
+/*
+ * Nearest-neighbour stretch of one layer by 32/25: panel pixel p shows
+ * logical pixel p * 25 / 32. Rows that repeat a logical row are copied
+ * from the panel row above.
+ */
+void
+AppleCLCD::presentScaled(Y2SSurface *s, uintptr_t src, uint32_t bpe, int32_t sx, int32_t sy,
+    int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	if (!fPadCleared) {
+		fPadCleared = true;
+		for (int32_t y = 0; y < (int32_t)fHeight; y++) {
+			if (y < fPadY || y >= (int32_t)fHeight - fPadY - 1) {
+				bzero((void *)(fPixels + (uint64_t)y * fRowBytes), (size_t)fWidth * 4);
+			}
+		}
+	}
+	if (src == 0 || bpe != 4 || s->elementWidth != 1 || s->elementHeight != 1 || s->memory == NULL) {
+		return;
+	}
+	/* Clip in logical coordinates: source surface and logical screen. */
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (w > (int32_t)fLogicalW - dx) {
+		w = (int32_t)fLogicalW - dx;
+	}
+	if (h > (int32_t)fLogicalH - dy) {
+		h = (int32_t)fLogicalH - dy;
+	}
+	if (w <= 0 || h <= 0) {
+		return;
+	}
+	uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow +
+	    (uint64_t)(sx + w) * 4;
+	if (last > s->memory->getLength()) {
+		return;
+	}
+	int32_t px0 = (dx * 32 + 24) / 25, px1 = ((dx + w) * 32 + 24) / 25;
+	int32_t py0 = fPadY + (dy * 32 + 24) / 25, py1 = fPadY + ((dy + h) * 32 + 24) / 25;
+	if (px1 > (int32_t)fWidth) {
+		px1 = (int32_t)fWidth;
+	}
+	if (py1 > (int32_t)fHeight) {
+		py1 = (int32_t)fHeight;
+	}
+	/*
+	 * Build each stretched row in a cached buffer and copy it to the panel
+	 * with one memcpy; repeated rows reuse the buffer. Per-pixel stores to
+	 * (and reads back from) the uncached framebuffer made every frame
+	 * visibly paint top to bottom on one CPU.
+	 */
+	static uint32_t rowbuf[2048];
+	static int32_t lxmap[2048];
+	if (px1 - px0 > 2048) {
+		px1 = px0 + 2048;
+	}
+	for (int32_t px = px0; px < px1; px++) {
+		int32_t lx = px * 25 / 32 - dx;
+		lxmap[px - px0] = lx < 0 ? 0 : (lx >= w ? w - 1 : lx);
+	}
+	const size_t rowlen = (size_t)(px1 - px0) * 4;
+	int32_t prev = -1;
+	for (int32_t py = py0; py < py1; py++) {
+		int32_t ly = (py - fPadY) * 25 / 32 - dy;
+		if (ly < 0) {
+			ly = 0;
+		} else if (ly >= h) {
+			ly = h - 1;
+		}
+		if (ly != prev) {
+			prev = ly;
+			const uint32_t *srow = (const uint32_t *)(src + s->offset + (uint64_t)(sy + ly) * s->bytesPerRow) + sx;
+			for (int32_t i = 0; i < px1 - px0; i++) {
+				rowbuf[i] = srow[lxmap[i]];
+			}
+		}
+		memcpy((void *)(fPixels + (uint64_t)py * fRowBytes + (uint64_t)px0 * 4), rowbuf, rowlen);
+	}
+}
+
+bool
+IOMobileFramebufferUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	return true;
+}
+
+bool
+IOMobileFramebufferUserClient::start(IOService *provider)
+{
+	fFB = OSDynamicCast(AppleCLCD, provider);
+	if (fFB == NULL || !IOUserClient::start(provider)) {
+		return false;
+	}
+	fFB->addClient(this);
+	return true;
+}
+
+IOReturn
+IOMobileFramebufferUserClient::clientClose(void)
+{
+	if (fFB != NULL) {
+		fFB->removeClient(this);
+		IOLockLock(fFB->fLock);
+		mach_port_t old = fPort;
+		fPort = MACH_PORT_NULL;
+		IOLockUnlock(fFB->fLock);
+		if (old != MACH_PORT_NULL) {
+			releaseNotificationPort(old);
+		}
+	}
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOMobileFramebufferUserClient::registerNotificationPort(mach_port_t port, __unused UInt32 type,
+    __unused io_user_reference_t refCon)
+{
+	mach_port_t old;
+	IOLockLock(fFB->fLock);
+	old = fPort;
+	fPort = port;
+	IOLockUnlock(fFB->fLock);
+	if (old != MACH_PORT_NULL) {
+		releaseNotificationPort(old);
+	}
+	return kIOReturnSuccess;
+}
+
+/* Called with the framebuffer lock held. */
+void
+IOMobileFramebufferUserClient::notify(uint32_t type, const uint64_t *values, uint32_t count)
+{
+	OSAsyncReference64 ref;
+
+	if (type >= Y2S_FB_NOTIFY_TYPES || fFunc[type] == 0 || fPort == MACH_PORT_NULL) {
+		return;
+	}
+	bzero(ref, sizeof(ref));
+	setAsyncReference64(ref, fPort, (mach_vm_address_t)fFunc[type], fRefcon[type], fTask);
+	sendAsyncResult64WithOptions(ref, kIOReturnSuccess, (io_user_reference_t *)values, count,
+	    kIOUserNotifyOptionCanDrop);
+}
+
+static uint64_t y2s_fb_logged;        /* selectors already logged (< 64) */
+
+IOReturn
+IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	IOReturn ret = kIOReturnSuccess;
+	uint64_t out[2] = { 0, 0 };
+	uint32_t outCount = 0;
+
+	switch (selector) {
+	case kY2SFBGetLayerDefaultSurface:
+		out[0] = y2s_surface_port_in_task(fFB->fSurface, fTask);
+		outCount = 1;
+		break;
+	case kY2SFBSwapBegin:
+		IOLockLock(fFB->fLock);
+		out[0] = ++fFB->fSwapID;
+		IOLockUnlock(fFB->fLock);
+		outCount = 1;
+		break;
+	case kY2SFBSwapEnd: {
+		uint8_t rec[Y2S_FB_SWAP_REC_SIZE];
+		if (args->structureInputDescriptor != NULL ||
+		    args->structureInputSize < Y2S_FB_SWAP_REC_SIZE) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		memcpy(rec, args->structureInput, sizeof(rec));
+		fFB->swap(rec);
+		break;
+	}
+	case kY2SFBGetID:
+		out[0] = 0;
+		outCount = 1;
+		break;
+	case kY2SFBGetDisplaySize:
+		out[0] = fFB->fLogicalW;
+		out[1] = fFB->fLogicalH;
+		outCount = 2;
+		break;
+	case kY2SFBIsMainDisplay:
+		out[0] = 1;
+		outCount = 1;
+		break;
+	case kY2SFBGetDotPitch:
+		out[0] = Y2S_FB_DOT_PITCH;
+		outCount = 1;
+		break;
+	case kY2SFBNotifications:
+		if (args->scalarInputCount >= 3 && args->scalarInput[2] < Y2S_FB_NOTIFY_TYPES) {
+			uint32_t type = (uint32_t)args->scalarInput[2];
+			IOLockLock(fFB->fLock);
+			fFunc[type] = args->scalarInput[0];
+			fRefcon[type] = args->scalarInput[1];
+			IOLockUnlock(fFB->fLock);
+			char name[32];
+			proc_selfname(name, sizeof(name));
+			IOLog("Y2S FB: %s notifications type %u %s\n", name, type,
+			    args->scalarInput[0] ? "on" : "off");
+		}
+		break;
+	case kY2SFBRequestPowerChange:
+		if (args->scalarInputCount >= 1) {
+			bool off = args->scalarInput[0] == 0;
+			IOLockLock(fFB->fLock);
+			if (off != fFB->fPowerOff) {
+				fFB->fPowerOff = off;
+				fFB->fFadeStep = 0;
+				fFB->fDirty = true;     /* on: redraw the latest frame */
+			}
+			IOLockUnlock(fFB->fLock);
+			IOLog("Y2S FB: display %s\n", off ? "off" : "on");
+		}
+		break;
+	case kY2SFBSwapWait:
+	default:
+		break;
+	}
+
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = i < outCount ? out[i] : 0;
+	}
+	if (args->structureOutputDescriptor == NULL && args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+	if (selector >= 64 || !(y2s_fb_logged & (1ULL << selector))) {
+		if (selector < 64) {
+			y2s_fb_logged |= 1ULL << selector;
+		}
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("Y2S FB: %s sel %u in %u/%u out %u/%u -> 0x%x\n", name, selector,
+		    args->scalarInputCount, args->structureInputSize,
+		    args->scalarOutputCount, args->structureOutputSize, ret);
+	}
+	return ret;
+}
+#endif /* Y2S */
diff --git a/iokit/Kernel/arm/Y2SKeyStore.cpp b/iokit/Kernel/arm/Y2SKeyStore.cpp
new file mode 100644
index 0000000..22652ed
--- /dev/null
+++ b/iokit/Kernel/arm/Y2SKeyStore.cpp
@@ -0,0 +1,241 @@
+/*
+ * Built-in AppleKeyStore for Y2S: a device without a passcode whose
+ * system keybag is always loaded and unlocked.
+ *
+ * Apple's AppleKeyStore kext (closed, SEP-backed) owns the keybags behind
+ * data protection. libaks (AppleKeyStore.framework, statically in keybagd)
+ * opens IOServiceMatching("AppleKeyStore") with type 0, calls selector 0,
+ * then one selector per aks_* function (iOS 16.7 numbering below). keybagd
+ * --init asks for the system bag (14) and only loads systembag.kb when the
+ * answer is kIOReturnNotFound; answering with a handle is the path a
+ * userspace reboot takes, so no bag file is needed.
+ *
+ * Every call is logged (selector, caller, argument shapes, result) so the
+ * next selectors the system needs show up on the console; unknown ones fail
+ * with kIOReturnUnsupported.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(Y2S)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <libkern/c++/OSString.h>
+#include <sys/proc.h>
+
+/* libaks selectors (AppleKeyStore.framework, iOS 16.7). */
+enum {
+	kAKSOpen             = 0,
+	kAKSCreateBag        = 2,
+	kAKSSaveBag          = 3,
+	kAKSUnloadBag        = 4,
+	kAKSSetSystem        = 5,
+	kAKSLoadBag          = 6,
+	kAKSGetLockState     = 7,
+	kAKSUnlockDevice     = 9,
+	kAKSWrapKey          = 10,
+	kAKSUnwrapKey        = 11,
+	kAKSUnlockBag        = 12,
+	kAKSLockBag          = 13,
+	kAKSGetSystem        = 14,
+	kAKSGetDeviceState   = 17,
+	kAKSGetExtDeviceState = 35,     /* aks_get_extended_device_state */
+	kAKSAssertHold       = 26,
+	kAKSAssertDrop       = 27,
+	kAKSUnloadSessionBags = 55,
+	kAKSNotifyStateSet   = 102,
+	kAKSNotifyStateIsSet = 103,
+	kAKSAssertConsume    = 101,     /* aks_assert_consume */
+};
+
+/* The system (device) bag handle. */
+#define Y2S_AKS_SYSTEM_HANDLE 0
+
+/*
+ * aks lock state bits (aks_get_lock_state): bit 2 is "unlocked since boot"
+ * (MobileKeyBag MKBDeviceUnlockedSinceBoot); clear lock bits = unlocked.
+ */
+#define Y2S_AKS_LOCK_STATE    0x4
+
+class AppleKeyStore : public IOService {
+	OSDeclareDefaultStructors(AppleKeyStore);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleKeyStore, IOService);
+
+bool
+AppleKeyStore::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleKeyStoreUserClient");
+	registerService();
+	IOLog("Y2S AKS: AppleKeyStore registered (no passcode, unlocked)\n");
+	return true;
+}
+
+class AppleKeyStoreUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleKeyStoreUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleKeyStoreUserClient, IOUserClient);
+
+IOReturn
+AppleKeyStoreUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+/* Copy len bytes to the caller's output structure (inband or descriptor). */
+static IOReturn
+y2s_aks_struct_out(IOExternalMethodArguments *args, const void *buf, uint32_t len)
+{
+	if (args->structureOutputDescriptor != NULL) {
+		if (len > args->structureOutputDescriptor->getLength()) {
+			return kIOReturnNoSpace;
+		}
+		args->structureOutputDescriptor->writeBytes(0, buf, len);
+		args->structureOutputDescriptorSize = len;
+		return kIOReturnSuccess;
+	}
+	if (args->structureOutput == NULL || len > args->structureOutputSize) {
+		return kIOReturnNoSpace;
+	}
+	memcpy(args->structureOutput, buf, len);
+	args->structureOutputSize = len;
+	return kIOReturnSuccess;
+}
+
+/* Append SEQUENCE { UTF8String key, INTEGER value } (short forms only). */
+static uint32_t
+y2s_aks_der_pair(uint8_t *p, const char *key, uint8_t value)
+{
+	uint32_t klen = (uint32_t)strlen(key);
+	uint32_t n = 0;
+	p[n++] = 0x30;
+	p[n++] = (uint8_t)(2 + klen + 3);
+	p[n++] = 0x0c;
+	p[n++] = (uint8_t)klen;
+	memcpy(p + n, key, klen);
+	n += klen;
+	p[n++] = 0x02;
+	p[n++] = 0x01;
+	p[n++] = value;
+	return n;
+}
+
+/*
+ * Device state (selector 17): a DER SET of key/INTEGER pairs that libaks
+ * decode_extended_state reads: ss state, sls lock state (MKBGetDeviceLockState:
+ * 0 = unlocked), sb backoff, sfa failed attempts, sgs generation, sas
+ * assertions, sgpe grace period, srcd recovery countdown.
+ */
+static IOReturn
+y2s_aks_device_state(IOExternalMethodArguments *args)
+{
+	static const struct {
+		const char *key;
+		uint8_t value;
+	} fields[] = {
+		{ "ss", Y2S_AKS_LOCK_STATE }, { "sls", 0 }, { "sb", 0 }, { "sfa", 0 },
+		{ "sgs", 0 }, { "sas", 0 }, { "sgpe", 0 }, { "srcd", 0 },
+	};
+	uint8_t buf[128];
+	uint32_t n = 2;
+	for (unsigned int i = 0; i < sizeof(fields) / sizeof(fields[0]); i++) {
+		n += y2s_aks_der_pair(buf + n, fields[i].key, fields[i].value);
+	}
+	buf[0] = 0x31;
+	buf[1] = (uint8_t)(n - 2);
+	return y2s_aks_struct_out(args, buf, n);
+}
+
+static uint32_t
+y2s_aks_struct_out_size(IOExternalMethodArguments *args)
+{
+	return args->structureOutputDescriptor != NULL ?
+	       (uint32_t)args->structureOutputDescriptor->getLength() : args->structureOutputSize;
+}
+
+IOReturn
+AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	IOReturn ret = kIOReturnSuccess;
+	uint32_t in_scalars = args->scalarInputCount;
+	uint32_t in_struct = args->structureInputDescriptor != NULL ?
+	    (uint32_t)args->structureInputDescriptor->getLength() : args->structureInputSize;
+	uint32_t out_scalars = args->scalarOutputCount;
+	uint32_t out_struct = y2s_aks_struct_out_size(args);
+	uint64_t arg0 = in_scalars > 0 ? args->scalarInput[0] : 0;
+
+	switch (selector) {
+	case kAKSOpen:
+	case kAKSUnloadBag:
+	case kAKSSetSystem:
+	case kAKSUnlockDevice:
+	case kAKSUnlockBag:
+	case kAKSLockBag:
+	case kAKSAssertHold:
+	case kAKSAssertDrop:
+	case kAKSAssertConsume:
+	case kAKSUnloadSessionBags:
+	case kAKSNotifyStateSet:
+		args->scalarOutputCount = 0;
+		break;
+	case kAKSGetSystem:
+		if (out_scalars < 1) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		args->scalarOutput[0] = Y2S_AKS_SYSTEM_HANDLE;
+		args->scalarOutputCount = 1;
+		break;
+	case kAKSGetLockState:
+		if (out_scalars < 1) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		args->scalarOutput[0] = Y2S_AKS_LOCK_STATE;
+		args->scalarOutputCount = 1;
+		break;
+	case kAKSNotifyStateIsSet:
+		/* Nothing was ever set: answer "not set". */
+		if (out_scalars < 1) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		args->scalarOutput[0] = 0;
+		args->scalarOutputCount = 1;
+		break;
+	case kAKSGetDeviceState:
+	case kAKSGetExtDeviceState:
+		args->scalarOutputCount = 0;
+		ret = y2s_aks_device_state(args);
+		break;
+	default:
+		ret = kIOReturnUnsupported;
+		break;
+	}
+
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	IOLog("Y2S AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n", name, selector,
+	    arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	return ret;
+}
+#endif /* Y2S */
diff --git a/iokit/Kernel/arm/Y2SPlatformExpert.cpp b/iokit/Kernel/arm/Y2SPlatformExpert.cpp
new file mode 100644
index 0000000..578d9ec
--- /dev/null
+++ b/iokit/Kernel/arm/Y2SPlatformExpert.cpp
@@ -0,0 +1,82 @@
+/*
+ * Minimal device-tree platform expert for Redmi Note 10 Pro (y2s).
+ * Uses XNU's normal platform, power-domain and nub initialization. Hardware
+ * interrupt and power-management services are supplied by separate drivers.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(Y2S)
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/IOLib.h>
+
+class Y2SPlatformExpert : public IODTPlatformExpert {
+	OSDeclareDefaultStructors(Y2SPlatformExpert);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void processTopLevel(IORegistryEntry *root) APPLE_KEXT_OVERRIDE;
+	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
+	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(Y2SPlatformExpert, IODTPlatformExpert);
+
+bool
+Y2SPlatformExpert::start(IOService *provider)
+{
+	IOLog("Y2S: starting device-tree platform expert\n");
+	if (!IODTPlatformExpert::start(provider)) {
+		return false;
+	}
+	registerService();
+	IOLog("Y2S: platform expert registered\n");
+	return true;
+}
+
+const char *
+Y2SPlatformExpert::deleteList(void)
+{
+	return "()";
+}
+
+const char *
+Y2SPlatformExpert::excludeList(void)
+{
+	return "('chosen', 'defaults', 'cpus', 'options')";
+}
+
+void
+Y2SPlatformExpert::processTopLevel(IORegistryEntry *root)
+{
+	/*
+	 * The stock implementation requires an Apple NVRAM /options node.
+	 * Y2S has no NVRAM controller; publish real CPU/device nodes without
+	 * inventing one. createNubs adds the topology's logical CPU/cluster IDs.
+	 */
+	IORegistryEntry *cpus = root->childFromPath("cpus", gIODTPlane);
+	if (cpus != NULL) {
+		createNubs(this, IODTFindMatchingEntries(cpus, kIODTExclusive, NULL));
+		cpus->release();
+	}
+	createNubs(this, IODTFindMatchingEntries(root, kIODTExclusive, excludeList()));
+
+	/*
+	 * No AppleARMIO driver publishes the /arm-io children: do it here so
+	 * built-in drivers (the display, AppleCLCD) can match them. The GIC is
+	 * driven by the platform code and gets no nub. The nubs hang off this
+	 * platform expert: IOPlatformDevice::compareName asks its provider.
+	 */
+	IORegistryEntry *armio = root->childFromPath("arm-io", gIODTPlane);
+	if (armio != NULL) {
+		createNubs(this, IODTFindMatchingEntries(armio, kIODTExclusive, "('gic')"));
+		armio->release();
+	}
+}
+
+/*
+ * hw.target / hw.product come from IODTPlatformExpert: the first root
+ * "compatible" string and "model" (D22AP / iPhone10,3 in the ADT), which
+ * is what the iPhone userland (MobileGestalt) expects.
+ */
+#endif /* Y2S */
