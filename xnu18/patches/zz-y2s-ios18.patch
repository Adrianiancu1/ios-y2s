+/*
+ * Board config for the Redmi Note 10 Pro ("y2s", Qualcomm SM7150 /
+ * Snapdragon 732G): Kryo 470 = Cortex-A76 + Cortex-A55, ARMv8.2, no PAC.
+ *
+ * Generic ARM like BCM2837 (no APPLE_ARM64_ARCH_FAMILY: none of Apple's
+ * implementation-defined system registers exist), 16K pages and GICv3 like
+ * VMAPPLE. Unlike VMAPPLE the GIC has two security states (GICD_TYPER
+ * SecurityExtn=1): Group 0 belongs to TrustZone, so every interrupt,
+ * including the timer, is a Group 1 IRQ taken through sleh_irq().
+ */
+
+#ifndef _PEXPERT_ARM64_Y2S_H
+#define _PEXPERT_ARM64_Y2S_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define Y2S                     1
+
+/*
+ * All eight cores (six A55 + two A76) as one homogeneous SMP cluster:
+ * cpus=N is clamped here. Same ISA level (ARMv8.2), 64-byte lines, PSCI
+ * CPU_ON; the scheduler does not know the A76s are faster (no AMP/P-E
+ * clusters yet).
+ */
+#define Y2S_SMP_MAX_CPUS         8
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#define __ARM_PAN_AVAILABLE__     1
+#define __ARM_16K_PG__            1
+
+#define HAS_GIC_V3                1
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+/*
+ * Qualcomm numbers the architected timer PPIs 1/2/3/0 (secure phys, phys,
+ * virt, hyp) instead of the usual 13/14/11/10: the virtual timer XNU uses
+ * (CNTV) is INTID 16 + 3 = 19.
+ */
+#define Y2S_VTIMER_INTID        19
+
+/*
+ * Galaxy S20+ (y2s, Exynos 990) boot framebuffer, as left by S-Boot
+ * (bootargs s3cfb.bootloaderfb=0xf1000000): 1440x3200 a8r8g8b8. The early
+ * console (y2s_early.c) and its bootstrap mappings use one 32MB L2 block
+ * (16K pages), so only the rows inside the block holding Y2S_FB_PA are used
+ * before the framebuffer driver takes over: (0xF2000000 - 0xF1000000) /
+ * 5760 = 2912 rows. The full mode is passed in boot_args.Video.
+ */
+#define Y2S_FB_PA               0xF1000000
+#define Y2S_FB_WIDTH            1440
+#define Y2S_FB_HEIGHT           3200
+#define Y2S_FB_STRIDE           (Y2S_FB_WIDTH * 4)
+#define Y2S_FB_BLOCK_SIZE       0x2000000       // ARM_TT_L2_SIZE with 16K pages
+#define Y2S_FB_BLOCK_PA         (Y2S_FB_PA & ~(Y2S_FB_BLOCK_SIZE - 1))
+#define Y2S_FB_BLOCK_OFFSET     (Y2S_FB_PA - Y2S_FB_BLOCK_PA)
+/* min(Y2S_FB_HEIGHT, rows left in the block); a literal so start.s can use it */
+#define Y2S_EARLY_FB_HEIGHT     2912
+#define Y2S_IPI_SGI             1       // SGI used for cross-CPU signals
+
+#define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
+
+#define GICR_PE_SIZE              0x20000 // Size of each redistributor region
+
+/* GICv3 register definitions; see GICv3 spec (Arm IHI 0069G) */
+#define GICD_CTLR                 0x0
+
+/* Non-secure view of GICD_CTLR (DS=0) */
+#define GICD_CTLR_ENABLEGRP1      0x1
+#define GICD_CTLR_ENABLEGRP1A     0x2
+#define GICD_CTLR_ARE_NS          0x10
+#define GICD_CTLR_RWP             0x80000000
+
+#define GICR_TYPER                              0x08
+#define GICR_WAKER                              0x14
+#define GICR_IGROUPR0                           0x10080
+#define GICR_ISENABLER0                         0x10100
+#define GICR_IPRIORITYR0                        0x10400
+
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT         32
+#define GICR_TYPER_LAST                         0x10
+
+#define GICR_WAKER_PROCESSORSLEEP               0x2
+#define GICR_WAKER_CHILDRENASLEEP               0x4
+
+#define ICC_CTLR_EOIMODE                        0x2
+
+#define ICC_SRE_SRE                             0x1
+/* End of GICv3 register definitions */
+
+/*
+ * GICv2 (GIC-400) register definitions, non-secure view; see GICv2 spec
+ * (Arm IHI 0048B) and the GIC-400 TRM. Used when /arm-io/gic is
+ * "arm,gic-400" (Exynos 990): reg = <GICD base, size, GICC base, size>.
+ */
+#define GICV2_MAX_CPU_IF          8       // GICv2 supports at most 8 CPU interfaces
+
+#define GICD_TYPER                0x004
+#define GICD_TYPER_CPUNUMBER_SHIFT 5      // bits [7:5]: number of CPU interfaces - 1
+#define GICD_ISENABLER            0x100   // banked word 0: SGIs + PPIs
+#define GICD_IPRIORITYR           0x400
+#define GICD_ITARGETSR            0x800   // words 0-7 banked, read-only
+#define GICD_SGIR                 0xF00
+#define GICD_SGIR_TARGET_SELF     (0x2U << 24) // TargetListFilter: requesting CPU only
+
+#define GICC_CTLR                 0x00
+#define GICC_PMR                  0x04
+#define GICC_BPR                  0x08
+#define GICC_IAR                  0x0C
+#define GICC_EOIR                 0x10
+
+#define GICC_CTLR_ENABLEGRP1      0x1     // NS view: bit 0 enables Group 1
+#define GICC_CTLR_BYPASS_MASK     0x1E0   // FIQ/IRQBypDisGrp0/1
+#define GICC_IAR_INTID_MASK       0x3FF
+/* End of GICv2 register definitions */
+
+#endif /* ! _PEXPERT_ARM64_Y2S_H */
