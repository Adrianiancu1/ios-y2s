+class IOSurfaceRootUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IOSurfaceRootUserClient);
+
+	task_t   fTask;
+	IOLock  *fLock;
+	OSArray *fRefs;
+
+	Y2SSurfaceRef *findRef(uint32_t id, unsigned int *index);
+	IOReturn addRef(Y2SSurface *s, Y2SSurfaceRef **refOut, bool *existing);
+	IOReturn returnSurface(Y2SSurface *s, IOExternalMethodArguments *args);
+	IOReturn create(IOExternalMethodArguments *args);
