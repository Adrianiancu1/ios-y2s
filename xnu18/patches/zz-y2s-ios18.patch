+/*
+ * Built-in IOSurface for Y2S.
+ *
+ * Apple's IOSurface kext is closed. IOSurface.framework (iOS 16.7) finds
+ * IOServiceNameMatching("IOCoreSurfaceRoot"), opens it with type 0 and
+ * talks to the user client below:
+ *
+ *   sel 13  limits: struct out 0x18, u16 at +0x16 must be 1 (ABI version),
+ *           +0 offset alignment mask, +4 bytes-per-row alignment mask
+ *   sel 0   create: scalar [parent id], struct in = serialized property
+ *           dictionary (binary or XML), struct out = lock result (0xa68)
+ *   sel 4   lookup by id: scalar [id], struct out = lock result
+ *   sel 34  lookup by mach port: scalar [port name], struct out = lock result
+ *   sel 35  create mach port: scalars [id, options], scalar out [port name]
+ *   traps   0/1 use count +/- (id, category), 2 lock / 3 unlock
+ *           (id, options, &seed), 4/5 release (id)
+ *
+ * The lock result tells the library where the surface lives in the
+ * caller's address space: +0 pixels, +8 shared state page (registry id,
+ * seed at +0xc), +0x10 timestamps, then id, sizes and geometry (layout in
+ * y2s_surface_fill_result). Every surface is wired kernel memory mapped
+ * into each task that creates or looks it up; mappings are counted per
+ * client and dropped on release or close.
+ *
+ * Values, notifications, accelerators and shared events are accepted and
+ * ignored (logged once per selector).
+ */
+#include "Y2SSurface.h"
+
+#if defined(Y2S)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/system.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSUnserialize.h>
+#include <sys/proc.h>
+
+enum {
+	kY2SSurfaceCreate             = 0,
+	kY2SSurfaceLookup             = 4,
+	kY2SSurfaceLimits             = 13,
+	kY2SSurfaceLookupFromPort     = 34,
+	kY2SSurfaceCreatePort         = 35,
+};
+
+enum {
+	kY2SSurfaceTrapIncrementUse   = 0,
+	kY2SSurfaceTrapDecrementUse   = 1,
+	kY2SSurfaceTrapLock           = 2,
+	kY2SSurfaceTrapUnlock         = 3,
+	kY2SSurfaceTrapRelease        = 4,
+	kY2SSurfaceTrapReleaseFailed  = 5,
+};
+
+#define Y2S_SURFACE_RESULT_SIZE       0xa68
+#define Y2S_SURFACE_MAX_ID            4096
+#define Y2S_SURFACE_MAX_DIM           16384
+#define Y2S_SURFACE_MAX_ALLOC         (256u << 20)
+#define Y2S_SURFACE_MAX_PROPS         (64u << 10)
+#define Y2S_SURFACE_ROW_ALIGN         64
+#define Y2S_SURFACE_TIMESTAMPS        0x800   /* offset in the state page */
+#define Y2S_SURFACE_STATE_SEED        0xc     /* u32 in the state page */
+#define kIOSurfaceLockReadOnly          0x1
+
+static IOLock       *y2s_surface_lock;
+static Y2SSurface *y2s_surface_table[Y2S_SURFACE_MAX_ID];
+static uint32_t      y2s_surface_users[Y2S_SURFACE_MAX_ID];
+static uint32_t      y2s_surface_next_id = 1;
+static uint32_t      y2s_surface_creates_logged;
+static uint64_t      y2s_surface_wired;       /* bytes of buffer surfaces */
+#define Y2S_SURFACE_WIRED_MAX         (1536ull << 20)
+
+OSDefineMetaClassAndStructors(Y2SSurface, OSObject);
+
+void
+Y2SSurface::free()
+{
+	if (OSDynamicCast(IOBufferMemoryDescriptor, memory) != NULL) {
+		OSAddAtomic64(-(SInt64)allocSize, (volatile SInt64 *)&y2s_surface_wired);
+	}
+	OSSafeReleaseNULL(kernelMap);
+	OSSafeReleaseNULL(memory);
+	OSSafeReleaseNULL(state);
+	OSObject::free();
+}
+
+uintptr_t
+Y2SSurface::kernelAddress()
+{
+	IOBufferMemoryDescriptor *buffer = OSDynamicCast(IOBufferMemoryDescriptor, memory);
+	if (buffer != NULL) {
+		return (uintptr_t)buffer->getBytesNoCopy();
+	}
+	IOLockLock(y2s_surface_lock);
+	if (kernelMap == NULL && memory != NULL) {
+		kernelMap = memory->map(kIOMapWriteCombineCache);
+	}
+	IOLockUnlock(y2s_surface_lock);
+	return kernelMap != NULL ? (uintptr_t)kernelMap->getVirtualAddress() : 0;
+}
+
+static uint32_t *
+y2s_surface_seed(Y2SSurface *s)
+{
+	return (uint32_t *)((uint8_t *)s->state->getBytesNoCopy() + Y2S_SURFACE_STATE_SEED);
+}
+
+/*
+ * Give the surface an id and a table slot; the table holds one retain and a
+ * user count (creators, client mappings, kernel holders). Lock held.
+ */
+static bool
+y2s_surface_insert_locked(Y2SSurface *s)
+{
+	for (uint32_t n = 0; n < Y2S_SURFACE_MAX_ID - 1; n++) {
+		uint32_t id = y2s_surface_next_id;
+		y2s_surface_next_id = id + 1 < Y2S_SURFACE_MAX_ID ? id + 1 : 1;
+		if (y2s_surface_table[id] == NULL) {
+			s->id = id;
+			s->retain();
+			y2s_surface_table[id] = s;
+			y2s_surface_users[id] = 1;
+			*(uint64_t *)s->state->getBytesNoCopy() = id;   /* registry id */
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Add a user to a surface that may have left the table (port lookups). */
+static bool
+y2s_surface_get(Y2SSurface *s)
+{
+	bool ok = true;
+	IOLockLock(y2s_surface_lock);
+	if (y2s_surface_table[s->id] == s) {
+		y2s_surface_users[s->id]++;
+	} else if (y2s_surface_table[s->id] == NULL) {
+		s->retain();
+		y2s_surface_table[s->id] = s;
+		y2s_surface_users[s->id] = 1;
+	} else {
+		ok = false;
+	}
+	IOLockUnlock(y2s_surface_lock);
+	return ok;
+}
+
+/* Drop a user; the last one removes the surface from the table. */
+static void
+y2s_surface_put(Y2SSurface *s)
+{
+	bool drop = false;
+	IOLockLock(y2s_surface_lock);
+	if (y2s_surface_table[s->id] == s && --y2s_surface_users[s->id] == 0) {
+		y2s_surface_table[s->id] = NULL;
+		drop = true;
+	}
+	IOLockUnlock(y2s_surface_lock);
+	if (drop) {
+		s->release();
+	}
+}
+
+Y2SSurface *
+y2s_surface_copy(uint32_t id)
+{
+	Y2SSurface *s = NULL;
+	if (id == 0 || id >= Y2S_SURFACE_MAX_ID || y2s_surface_lock == NULL) {
+		return NULL;
+	}
+	IOLockLock(y2s_surface_lock);
+	s = y2s_surface_table[id];
+	if (s != NULL) {
+		s->retain();
+	}
+	IOLockUnlock(y2s_surface_lock);
+	return s;
+}
+
+/* The table lock; the framebuffer may publish a surface before the root starts. */
+static void
+y2s_surface_init_lock(void)
+{
+	if (y2s_surface_lock == NULL) {
+		IOLock *lock = IOLockAlloc();
+		if (!OSCompareAndSwapPtr(NULL, lock, &y2s_surface_lock)) {
+			IOLockFree(lock);
+		}
+	}
+}
+
+static Y2SSurface *
+y2s_surface_alloc(void)
+{
+	y2s_surface_init_lock();
+	Y2SSurface *s = OSTypeAlloc(Y2SSurface);
+	if (s == NULL || !s->init()) {
+		OSSafeReleaseNULL(s);
+		return NULL;
+	}
+	s->state = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared, page_size, page_size);
+	if (s->state == NULL) {
+		s->release();
+		return NULL;
+	}
+	bzero(s->state->getBytesNoCopy(), page_size);
+	return s;
+}
+
+static bool
+y2s_surface_publish(Y2SSurface *s)
+{
+	bool ok;
+	IOLockLock(y2s_surface_lock);
+	ok = y2s_surface_insert_locked(s);
+	IOLockUnlock(y2s_surface_lock);
+	return ok;
+}
+
+Y2SSurface *
+y2s_surface_create_physical(uint64_t phys, uint32_t width, uint32_t height,
+    uint32_t bytesPerRow, uint32_t pixelFormat)
+{
+	Y2SSurface *s = y2s_surface_alloc();
+	if (s == NULL) {
+		return NULL;
+	}
+	s->width = width;
+	s->height = height;
+	s->bytesPerRow = bytesPerRow;
+	s->bytesPerElement = 4;
+	s->elementWidth = s->elementHeight = 1;
+	s->pixelFormat = pixelFormat;
+	s->allocSize = (uint32_t)round_page(bytesPerRow * height);
+	s->memory = IOMemoryDescriptor::withPhysicalAddress(phys, s->allocSize, kIODirectionInOut);
+	s->mapCache = kIOMapWriteCombineCache;
+	if (s->memory == NULL || !y2s_surface_publish(s)) {
+		s->release();
+		return NULL;
+	}
+	return s;
+}
+
+mach_port_name_t
+y2s_surface_port_in_task(Y2SSurface *s, task_t task)
+{
+	mach_port_name_t name = 0;
+	IOUserClient::copyPortNameForObjectInTask(task, s, &name);
+	return name;
+}
+
+static uint32_t
+y2s_dict_u32(OSDictionary *dict, const char *key, uint32_t def)
+{
+	OSNumber *n = OSDynamicCast(OSNumber, dict->getObject(key));
+	return n != NULL ? n->unsigned32BitValue() : def;
+}
+
+static uint32_t
+y2s_div_up(uint32_t a, uint32_t b)
+{
+	return b > 1 ? (a + b - 1) / b : a;
+}
+
+static uint32_t
+y2s_row_bytes(uint32_t width, uint32_t ew, uint32_t bpe)
+{
+	uint64_t row = (uint64_t)y2s_div_up(width, ew) * bpe;
+	return (uint32_t)((row + Y2S_SURFACE_ROW_ALIGN - 1) & ~(uint64_t)(Y2S_SURFACE_ROW_ALIGN - 1));
+}
+
+/* Geometry from the creation properties (IOSurface.h keys). */
+static IOReturn
+y2s_surface_layout(Y2SSurface *s, OSDictionary *props)
+{
+	uint64_t end;
+
+	s->width = y2s_dict_u32(props, "IOSurfaceWidth", 0);
+	s->height = y2s_dict_u32(props, "IOSurfaceHeight", 0);
+	s->bytesPerElement = (uint16_t)y2s_dict_u32(props, "IOSurfaceBytesPerElement", 4);
+	s->elementWidth = (uint8_t)y2s_dict_u32(props, "IOSurfaceElementWidth", 1);
+	s->elementHeight = (uint8_t)y2s_dict_u32(props, "IOSurfaceElementHeight", 1);
+	s->pixelFormat = y2s_dict_u32(props, "IOSurfacePixelFormat", 0);
+	s->cacheMode = y2s_dict_u32(props, "IOSurfaceCacheMode", 0);
+	s->offset = y2s_dict_u32(props, "IOSurfaceOffset", 0);
+	if (s->width > Y2S_SURFACE_MAX_DIM || s->height > Y2S_SURFACE_MAX_DIM ||
+	    s->bytesPerElement > 64 || s->elementWidth == 0 || s->elementHeight == 0) {
+		return kIOReturnBadArgument;
+	}
+	s->bytesPerRow = y2s_dict_u32(props, "IOSurfaceBytesPerRow",
+	    y2s_row_bytes(s->width, s->elementWidth, s->bytesPerElement));
+	if (s->bytesPerRow < (uint64_t)y2s_div_up(s->width, s->elementWidth) * s->bytesPerElement) {
+		return kIOReturnBadArgument;
+	}
+	end = (uint64_t)s->offset + (uint64_t)s->bytesPerRow * y2s_div_up(s->height, s->elementHeight);
+
+	OSArray *planes = OSDynamicCast(OSArray, props->getObject("IOSurfacePlaneInfo"));
+	s->planeCount = 0;
+	if (planes != NULL) {
+		uint64_t next = s->offset;
+		if (planes->getCount() > Y2S_SURFACE_MAX_PLANES) {
+			return kIOReturnBadArgument;
+		}
+		for (unsigned int i = 0; i < planes->getCount(); i++) {
+			OSDictionary *pd = OSDynamicCast(OSDictionary, planes->getObject(i));
+			struct y2s_surface_plane *p = &s->planes[i];
+			if (pd == NULL) {
+				return kIOReturnBadArgument;
+			}
+			p->width = y2s_dict_u32(pd, "IOSurfacePlaneWidth", s->width);
+			p->height = y2s_dict_u32(pd, "IOSurfacePlaneHeight", s->height);
+			p->bytesPerElement = (uint16_t)y2s_dict_u32(pd, "IOSurfacePlaneBytesPerElement", 1);
+			p->elementWidth = (uint8_t)y2s_dict_u32(pd, "IOSurfacePlaneElementWidth", 1);
+			p->elementHeight = (uint8_t)y2s_dict_u32(pd, "IOSurfacePlaneElementHeight", 1);
+			if (p->width > Y2S_SURFACE_MAX_DIM || p->height > Y2S_SURFACE_MAX_DIM ||
+			    p->bytesPerElement > 64 || p->elementWidth == 0 || p->elementHeight == 0) {
+				return kIOReturnBadArgument;
+			}
+			p->bytesPerRow = y2s_dict_u32(pd, "IOSurfacePlaneBytesPerRow",
+			    y2s_row_bytes(p->width, p->elementWidth, p->bytesPerElement));
+			p->offset = y2s_dict_u32(pd, "IOSurfacePlaneOffset", (uint32_t)next);
+			p->size = y2s_dict_u32(pd, "IOSurfacePlaneSize",
+			    p->bytesPerRow * y2s_div_up(p->height, p->elementHeight));
+			next = round_page((uint64_t)p->offset + p->size);
+			if ((uint64_t)p->offset + p->size > end) {
+				end = (uint64_t)p->offset + p->size;
+			}
+		}
+		s->planeCount = planes->getCount();
+	}
+
+	uint64_t alloc = y2s_dict_u32(props, "IOSurfaceAllocSize", 0);
+	if (alloc < end) {
+		alloc = end;
+	}
+	alloc = round_page(alloc);
+	if (alloc == 0 || alloc > Y2S_SURFACE_MAX_ALLOC) {
+		return kIOReturnNoMemory;
+	}
+	s->allocSize = (uint32_t)alloc;
+	return kIOReturnSuccess;
+}
+
+/* Per-client mapping of one surface. */
+class Y2SSurfaceRef : public OSObject {
+	OSDeclareDefaultStructors(Y2SSurfaceRef);
+
+public:
+	Y2SSurface *surface;
+	IOMemoryMap  *data;
+	IOMemoryMap  *state;
+	uint32_t      count;
+
+	bool init() APPLE_KEXT_OVERRIDE { return OSObject::init(); }
+	void free() APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(Y2SSurfaceRef, OSObject);
+
+void
+Y2SSurfaceRef::free()
+{
+	OSSafeReleaseNULL(data);
+	OSSafeReleaseNULL(state);
+	if (surface != NULL) {
+		y2s_surface_put(surface);
+		surface->release();
+		surface = NULL;
+	}
+	OSObject::free();
+}
+
+class IOCoreSurfaceRoot : public IOService {
+	OSDeclareDefaultStructors(IOCoreSurfaceRoot);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
