diff --git a/bsd/pthread/y2s_pthread_compat.h b/bsd/pthread/y2s_pthread_compat.h
new file mode 100644
index 0000000..49e375c
--- /dev/null
+++ b/bsd/pthread/y2s_pthread_compat.h
@@ -0,0 +1,25 @@
+/*
+ * Compile the matching libpthread provider with its kext view of BSD headers.
+ * It owns its full ksyn_waitq_element layout; the kernel's opaque counterpart
+ * reserves this layout. All communication with private BSD state uses callbacks.
+ */
+#ifndef Y2S_PTHREAD_COMPAT_H
+#define Y2S_PTHREAD_COMPAT_H
+#undef BSD_KERNEL_PRIVATE
+#undef XNU_KERNEL_PRIVATE
+#define __PTHREAD_EXPOSE_INTERNALS__ 1
+#define NEEDS_SCHED_CALL_T 1
+
+/* The seven-argument kext API forwards to the eight-argument kernel vm_fault. */
+#define vm_fault vm_fault_external
+
+/* Avoid collisions with the kernel side of the callback interface. */
+#define pthread_kern y2s_pthread_kern
+#define current_uthread y2s_pthread_current_uthread
+#define pthread_start y2s_pthread_start
+#define pthread_stop y2s_pthread_stop
+
+/* os/log passes &__dso_handle as the containing Mach-O image address. */
+extern void *y2s_pthread_log_image __asm("__mh_execute_header");
+#define __dso_handle y2s_pthread_log_image
+#endif
diff --git a/bsd/pthread/y2s_pthread_init.c b/bsd/pthread/y2s_pthread_init.c
new file mode 100644
index 0000000..0f93c28
--- /dev/null
+++ b/bsd/pthread/y2s_pthread_init.c
@@ -0,0 +1,26 @@
+/* Built-in provider: Apple libpthread-514.100.2, paired with xnu-8796.141.3. */
+#if defined(ARM64_BOARD_CONFIG_Y2S)
+#include "y2s_pthread_compat.h"
+#include "y2s_libpthread/kern/kern_init.c"
+
+/* Keep the provider's full layout within the kernel's reserved storage. */
+_Static_assert(sizeof(struct ksyn_waitq_element) == 56,
+    "update Y2S ksyn storage in sys/pthread_internal.h");
+
+/* Restore the startup interface after compiling the provider's kext code. */
+#define XNU_KERNEL_PRIVATE 1
+#include <kern/startup.h>
+#include <pexpert/pexpert.h>
+
+__startup_func
+static void
+y2s_pthread_register(void)
+{
+    kern_return_t kr = y2s_pthread_start(NULL, NULL);
+    if (kr != KERN_SUCCESS || y2s_pthread_kern == NULL) {
+        panic("Y2S: pthread provider registration failed: %d", kr);
+    }
+    kprintf("Y2S pthread: libpthread-514.100.2 registered\n");
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_SECOND, y2s_pthread_register);
+#endif /* ARM64_BOARD_CONFIG_Y2S */
