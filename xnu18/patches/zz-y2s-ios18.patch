diff --git a/bsd/dev/mem.c b/bsd/dev/mem.c
index c64e636..0aa3808 100644
--- a/bsd/dev/mem.c
+++ b/bsd/dev/mem.c
@@ -153,6 +153,44 @@ mmioctl(dev_t dev, u_long cmd, __unused caddr_t data,
 	return 0;
 }
 
+#if defined(ARM64_BOARD_CONFIG_Y2S)
+/*
+ * Y2S: daemons started by launchd write stdout/stderr to /dev/null, and
+ * pointing a launchd job at /dev/console stops it from launching at all
+ * (backboardd, v8 image). Instead, what the processes named in boot-arg
+ * y2snull (comma separated, default "backboardd,SpringBoard") write to
+ * /dev/null goes to the console (and so to the persistent log) as
+ * "|name| text". y2snull=- turns it off.
+ */
+static char y2s_null_names[128];
+static int y2s_null_parsed;
+
+static bool
+y2s_null_tee(char *name, size_t len)
+{
+	if (!y2s_null_parsed) {
+		if (!PE_parse_boot_argn("y2snull", y2s_null_names, sizeof(y2s_null_names))) {
+			strlcpy(y2s_null_names, "backboardd,SpringBoard", sizeof(y2s_null_names));
+		}
+		y2s_null_parsed = 1;
+	}
+	proc_selfname(name, (int)len);
+	size_t n = strlen(name);
+	for (const char *t = y2s_null_names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+#endif
+
 int
 mmrw(dev_t dev, struct uio *uio, enum uio_rw rw)
 {
@@ -216,6 +254,22 @@ mmrw(dev_t dev, struct uio *uio, enum uio_rw rw)
 			if (rw == UIO_READ) {
 				return 0;
 			}
+#if defined(ARM64_BOARD_CONFIG_Y2S)
+			{
+				char name[32];
+				if (y2s_null_tee(name, sizeof(name))) {
+					char buf[256];
+					c = MIN(uio_curriovlen(uio), sizeof(buf));
+					error = uiomove(buf, (int)c, uio);
+					if (error) {
+						break;
+					}
+					printf("|%s| %.*s%s", name, (int)c, buf,
+					    (c > 0 && buf[c - 1] == '\n') ? "" : "\n");
+					continue;
+				}
+			}
+#endif
 			c = uio_curriovlen(uio);
 
 			error = 0; /* Always succeeds, always consumes all input */
diff --git a/bsd/dev/y2s_acpm.c b/bsd/dev/y2s_acpm.c
new file mode 100644
index 0000000..5a56f35
--- /dev/null
+++ b/bsd/dev/y2s_acpm.c
@@ -0,0 +1,202 @@
+/*
+ * Galaxy S20+ (Exynos 990): raise the boot cluster's clock through ACPM,
+ * the power-management microcontroller that owns CPU voltage and PLLs.
+ * Protocol from Samsung's drivers/soc/samsung/acpm/acpm_ipc.c and
+ * cal-if/acpm_dvfs.c; addresses from the DT acpm_ipc / acpm_dvfs nodes:
+ *   mailbox 0x15900000 (INTGR0 0x08: raise (1 << id) << 16 to ACPM;
+ *   INTCR1 0x20 / INTSR1 0x28: ACPM -> AP), SRAM 0x02039000 (0x38000),
+ *   framework init data at SRAM + 0x7000, DVFS on IPC channel 5.
+ * A DVFS message is 4 words { id | seq << 16, kHz, 0 = set / 1 = get, 0 };
+ * cluster 0 (Cortex-A55) is id 2 (acpm_dvfs_exynos9830.h). ACPM sets
+ * voltage and PLL itself. Boot-arg y2scpukhz (default 2002000, 0 = leave).
+ */
+#if defined(ARM64_BOARD_CONFIG_Y2S)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <mach/mach_time.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void y2s_acpm_init(void);
+
+#define ACPM_MBOX_PA    0x15900000u
+#define ACPM_SRAM_PA    0x02039000u
+#define ACPM_SRAM_SIZE  0x38000u
+#define ACPM_INITDATA   0x7000u
+#define INTGR0          0x08
+#define INTCR1          0x20
+#define INTSR1          0x28
+#define DVFS_CH         5
+#define DVFS_CPUCL0     2
+#define FREQ_REQ        0
+#define FREQ_GET        1
+
+static vm_offset_t mbox, sram;
+static uint32_t ch_id, q_len, q_size;
+static uint32_t tx_front, tx_rear, tx_base;     /* AP -> ACPM (ACPM rx_*) */
+static uint32_t rx_front, rx_rear, rx_base;     /* ACPM -> AP (ACPM tx_*) */
+static uint32_t seq;
+
+static uint32_t
+r32(vm_offset_t a)
+{
+	uint32_t v = *(volatile uint32_t *)a;
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+w32(vm_offset_t a, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)a = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+/* Send one 4-word command and wait (polling) for its response. 0 = ok. */
+static int
+acpm_xfer(uint32_t cmd[4])
+{
+	uint32_t front = r32(sram + tx_front);
+	uint32_t next = (front + 1) % q_len;
+	uint64_t t0 = mach_absolute_time(), lim;
+	nanoseconds_to_absolutetime(50 * NSEC_PER_MSEC, &lim);
+
+	printf("Y2S ACPM: xfer tx front %u rear %u, rx front %u rear %u, intsr1 0x%x\n",
+	    front, r32(sram + tx_rear), r32(sram + rx_front), r32(sram + rx_rear), r32(mbox + INTSR1));
+	/* 1-slot queue: the ring "full" test can never pass; just use the slot. */
+	while (q_len > 1 && next == r32(sram + tx_rear)) {
+		if (mach_absolute_time() - t0 > lim) {
+			return -1;
+		}
+	}
+	if (++seq >= 64) {
+		seq = 1;
+	}
+	cmd[0] = (cmd[0] & ~(0x3fu << 16)) | (seq << 16);
+	for (unsigned i = 0; i < 4 && i * 4 < q_size; i++) {
+		w32(sram + tx_base + q_size * front + 4 * i, cmd[i]);
+	}
+	w32(sram + tx_front, next);
+	w32(mbox + INTGR0, (1u << ch_id) << 16);
+
+	t0 = mach_absolute_time();
+	for (;;) {
+		uint32_t rr = r32(sram + rx_rear), rf = r32(sram + rx_front);
+		bool got = (rr != rf);
+		if (!got && q_len == 1 && (r32(mbox + INTSR1) & (1u << ch_id))) {
+			vm_offset_t e = sram + rx_base;
+			printf("Y2S ACPM: intsr1 set, slot 0x%x 0x%x 0x%x 0x%x front %u rear %u\n",
+			    r32(e), r32(e + 4), r32(e + 8), r32(e + 12), rf, rr);
+			for (unsigned i = 0; i < 4; i++) {
+				cmd[i] = r32(e + 4 * i);
+			}
+			w32(mbox + INTCR1, 1u << ch_id);
+			return 0;
+		}
+		if (got) {
+			vm_offset_t e = sram + rx_base + q_size * rr;
+			uint32_t r0 = r32(e);
+			if (((r0 >> 16) & 0x3f) == seq) {
+				for (unsigned i = 0; i < 4 && i * 4 < q_size; i++) {
+					cmd[i] = r32(e + 4 * i);
+				}
+			}
+			w32(sram + rx_rear, (rr + 1) % q_len);
+			w32(mbox + INTCR1, 1u << ch_id);
+			if (((r0 >> 16) & 0x3f) == seq) {
+				return 0;
+			}
+			continue;
+		}
+		if (mach_absolute_time() - t0 > lim) {
+			printf("Y2S ACPM: timeout: tx front %u rear %u, rx front %u rear %u, intsr1 0x%x, slot 0x%x 0x%x\n",
+			    r32(sram + tx_front), r32(sram + tx_rear), r32(sram + rx_front), r32(sram + rx_rear),
+			    r32(mbox + INTSR1), r32(sram + rx_base), r32(sram + rx_base + 4));
+			return -2;
+		}
+		delay(10);
+	}
+}
+
+/* Boot-core clock in MHz: PMU cycles over 50 ms. */
+static uint32_t
+cpu_mhz(void)
+{
+	uint64_t pmcr, c0, c1, t0, lim;
+	__asm__ volatile ("mrs %0, pmcr_el0" : "=r"(pmcr));
+	__asm__ volatile ("msr pmcr_el0, %0" :: "r"(pmcr | 1));
+	__asm__ volatile ("msr pmcntenset_el0, %0" :: "r"(1UL << 31));
+	__asm__ volatile ("isb");
+	nanoseconds_to_absolutetime(50 * NSEC_PER_MSEC, &lim);
+	boolean_t istate = ml_set_interrupts_enabled(FALSE);
+	t0 = mach_absolute_time();
+	__asm__ volatile ("mrs %0, pmccntr_el0" : "=r"(c0));
+	while (mach_absolute_time() - t0 < lim) {
+	}
+	__asm__ volatile ("mrs %0, pmccntr_el0" : "=r"(c1));
+	ml_set_interrupts_enabled(istate);
+	return (uint32_t)((c1 - c0) / 50000);
+}
+
+void
+y2s_acpm_init(void)
+{
+	uint32_t want = 2002000;
+	(void)PE_parse_boot_argn("y2scpukhz", &want, sizeof(want));
+	printf("Y2S ACPM: cpu %u MHz before\n", cpu_mhz());
+	if (want == 0) {
+		return;
+	}
+	mbox = ml_io_map(ACPM_MBOX_PA, 0x1000);
+	sram = ml_io_map(ACPM_SRAM_PA, ACPM_SRAM_SIZE);
+	/* struct acpm_framework (u32 fields): ipc_channels @0x8, ipc_ap_max @0x18 */
+	uint32_t chans = r32(sram + ACPM_INITDATA + 0x8);
+	uint32_t ap_max = r32(sram + ACPM_INITDATA + 0x18);
+	if (chans == 0 || chans >= ACPM_SRAM_SIZE || ap_max <= DVFS_CH || ap_max > 32) {
+		printf("Y2S ACPM: bad init data (channels 0x%x, ap_max %u)\n", chans, ap_max);
+		return;
+	}
+	/* struct ipc_channel: id, field, owner, type, channel_info (13 words), ap_poll = 72 bytes */
+	vm_offset_t c = sram + chans + 72 * DVFS_CH;
+	ch_id = r32(c + 0);
+	vm_offset_t ci = c + 16;
+	tx_rear = r32(ci + 0);
+	tx_front = r32(ci + 4);
+	tx_base = r32(ci + 8);
+	rx_rear = r32(ci + 24);
+	rx_front = r32(ci + 28);
+	rx_base = r32(ci + 32);
+	q_len = r32(ci + 36);
+	q_size = r32(ci + 40);
+	printf("Y2S ACPM: ch %u id %u len %u size %u tx %x/%x/%x rx %x/%x/%x poll %u\n",
+	    DVFS_CH, ch_id, q_len, q_size, tx_rear, tx_front, tx_base, rx_rear, rx_front, rx_base,
+	    r32(c + 68));
+	for (unsigned k = 0; k < ap_max && k < 12; k++) {
+		vm_offset_t ck = sram + chans + 72 * k;
+		printf("Y2S ACPM: ch%u id %u type %u len %u size %u poll %u\n", k, r32(ck), r32(ck + 12),
+		    r32(ck + 16 + 36), r32(ck + 16 + 40), r32(ck + 68));
+	}
+	if (q_len == 0 || q_len > 64 || q_size < 16 || q_size > 64 || ch_id > 15 ||
+	    tx_base >= ACPM_SRAM_SIZE || rx_base >= ACPM_SRAM_SIZE) {
+		printf("Y2S ACPM: channel layout looks wrong, not sending\n");
+		return;
+	}
+
+	uint32_t cmd[4] = { DVFS_CPUCL0, 0, FREQ_GET, 0 };
+	int r = acpm_xfer(cmd);
+	printf("Y2S ACPM: get cl0 rc %d -> %u kHz (0x%x 0x%x 0x%x)\n", r, cmd[1], cmd[0], cmd[2], cmd[3]);
+	if (r != 0 || cmd[1] < 100000 || cmd[1] > 3000000) {
+		printf("Y2S ACPM: no sane answer, not changing the clock\n");
+		return;
+	}
+	uint32_t set[4] = { DVFS_CPUCL0, want, FREQ_REQ, 0 };
+	r = acpm_xfer(set);
+	printf("Y2S ACPM: set cl0 %u kHz rc %d (0x%x 0x%x 0x%x 0x%x)\n", want, r, set[0], set[1], set[2], set[3]);
+	uint32_t get2[4] = { DVFS_CPUCL0, 0, FREQ_GET, 0 };
+	r = acpm_xfer(get2);
+	printf("Y2S ACPM: cl0 now %u kHz (rc %d), cpu %u MHz measured\n", get2[1], r, cpu_mhz());
+}
+#endif /* ARM64_BOARD_CONFIG_Y2S */
diff --git a/bsd/dev/y2s_keys.c b/bsd/dev/y2s_keys.c
new file mode 100644
index 0000000..1206bff
--- /dev/null
+++ b/bsd/dev/y2s_keys.c
@@ -0,0 +1,182 @@
+/*
+ * Minimal polled Y2S keys. Call once after the scheduler is running.
+ * See hw-report.md: volume-up is PM6150L SID 4, NOT PM6150 SID 0.
+ * PMIC access is READ ONLY: the sole MMIO write issues EXT_READL on an
+ * observer channel. No PMIC config, IRQ acknowledge or reset writes exist.
+ */
+#if defined(ARM64_BOARD_CONFIG_Y2S)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void y2s_hid_key(int key, int down);
+void y2s_keys_init(void);
+
+#define KEYS_CORE_PA     0x0c440000u
+#define KEYS_OBS_PA      0x0e600000u
+#define KEYS_CNFG_PA     0x0c40a000u
+#define KEYS_PON_RT      0x0810u
+#define KEYS_GPIO_RT     0xc110u
+#define KEYS_NO_APID     0xffffu
+
+static vm_offset_t keys_core, keys_obs, keys_cnfg;
+static uint16_t keys_pon_apid = KEYS_NO_APID, keys_gpio_apid = KEYS_NO_APID;
+static uint32_t keys_version, keys_last_status;
+static bool keys_started;
+static int keys_sleep_chan;
+
+static uint32_t
+keys_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+/* v5 can map one PPID more than once; prefer the apps-owned entry. */
+static uint16_t
+keys_find_apid(uint16_t ppid, uint32_t count)
+{
+	uint16_t found = KEYS_NO_APID;
+	for (uint32_t i = 0; i < count; ++i) {
+		uint32_t map = keys_rd(keys_core, 0x900u + 4u * i);
+		if (map == 0 || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		uint32_t owner = keys_rd(keys_cnfg, 0x700u + 4u * i) & 7u;
+		if (found == KEYS_NO_APID || owner == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+static bool
+keys_read(uint16_t apid, uint16_t addr, uint8_t *out)
+{
+	if (apid == KEYS_NO_APID) {
+		return false;
+	}
+	uint32_t off = 0x80u * apid; /* obs + EE(0)*0x10000 */
+	uint32_t cmd = (1u << 27) | ((uint32_t)(addr & 0xffu) << 4);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(keys_obs + off) = cmd; /* EXT_READL, one byte */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		keys_last_status = keys_rd(keys_obs, off + 0x08u);
+		if (keys_last_status & 1u) {
+			if (keys_last_status & 0x0eu) {
+				return false;
+			}
+			*out = (uint8_t)keys_rd(keys_obs, off + 0x18u);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+keys_wait(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(20, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&keys_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+keys_thread(void *arg, wait_result_t result)
+{
+	int state[3] = {0, 0, 0};
+	unsigned errors = 0;
+	(void)arg;
+	(void)result;
+	for (;;) {
+		uint8_t pon = 0, gpio = 0;
+		bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
+		bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
+		int now[3] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u)};
+		if (!pok || !gok) {
+			if ((errors++ % 250u) == 0) {
+				printf("Y2S KEYS: read error pon-ok=%d gpio-ok=%d arb-status=%#x\n",
+				    pok, gok, keys_last_status);
+			}
+		} else {
+			errors = 0;
+		}
+		for (int k = 0; k < 3; ++k) {
+			if ((k == 1 ? gok : pok) && now[k] != state[k]) {
+				state[k] = now[k];
+				printf("Y2S KEYS: key=%d down=%d pon=%#x gpio4:c110=%#x\n",
+				    k, state[k], pon, gpio);
+				y2s_hid_key(k, state[k]);
+			}
+		}
+		keys_wait();
+	}
+}
+
+void
+y2s_keys_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (keys_started) {
+		return;
+	}
+	keys_started = true;
+	(void)PE_parse_boot_argn("y2skeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("Y2S KEYS: disabled (y2skeys=0)\n");
+		return;
+	}
+	keys_core = ml_io_map(KEYS_CORE_PA, 0x2000);
+	keys_cnfg = ml_io_map(KEYS_CNFG_PA, 0x1000);
+	keys_obs = ml_io_map(KEYS_OBS_PA, 0x10000);
+	if (!keys_core || !keys_cnfg || !keys_obs) {
+		printf("Y2S KEYS: MMIO mapping failed\n");
+		return;
+	}
+	keys_version = keys_rd(keys_core, 0);
+	uint32_t count = keys_rd(keys_core, 4) & 0x7ffu;
+	if (keys_version < 0x50000000u || keys_version >= 0x70000000u ||
+	    count == 0 || count > 512) {
+		printf("Y2S KEYS: unsupported arbiter version=%#x apids=%u\n",
+		    keys_version, count);
+		return;
+	}
+	keys_pon_apid = keys_find_apid(0x008, count);
+	keys_gpio_apid = keys_find_apid(0x4c1, count);
+	uint8_t pon = 0, gpio = 0, mode = 0, en = 0, subtype = 0;
+	bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
+	bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
+	bool mok = keys_read(keys_gpio_apid, 0xc140, &mode);
+	bool eok = keys_read(keys_gpio_apid, 0xc146, &en);
+	bool sok = keys_read(keys_gpio_apid, 0xc105, &subtype);
+	printf("Y2S KEYS: arb=%#x apids=%u pon-apid=%u gpio4-apid=%u pon=%#x/%d gpio=%#x/%d mode=%#x/%d en=%#x/%d subtype=%#x/%d\n",
+	    keys_version, count, keys_pon_apid, keys_gpio_apid,
+	    pon, pok, gpio, gok, mode, mok, en, eok, subtype, sok);
+	/* GPIO configuration belongs to firmware. Diagnose, never repair it here. */
+	unsigned dir = subtype >= 0x10u && subtype <= 0x13u ?
+	    mode & 3u : (mode >> 4) & 7u;
+	if (!eok || !mok || !sok || !(en & 0x80u) || (dir != 0 && dir != 2)) {
+		printf("Y2S KEYS: GPIO2 not confirmed enabled as input; volume-up withheld, PMIC unchanged\n");
+		keys_gpio_apid = KEYS_NO_APID;
+	}
+	if (!pok && !gok) {
+		printf("Y2S KEYS: no readable keys; polling retained for recovery\n");
+	}
+	kern_return_t kr = kernel_thread_start(keys_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("Y2S KEYS: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_Y2S */
diff --git a/bsd/dev/y2s_rpmh.c b/bsd/dev/y2s_rpmh.c
new file mode 100644
index 0000000..c7c486e
--- /dev/null
+++ b/bsd/dev/y2s_rpmh.c
@@ -0,0 +1,358 @@
+/*
+ * Y2S PM6150L L11C bring-up; see report.md for DT and source evidence.
+ * Sole XNU apps-DRV owner, called from thread context with deep idle disabled.
+ * No sleep/wake programming, SPMI writes, GIC handler, or timeout recovery.
+ */
+#if defined(ARM64_BOARD_CONFIG_Y2S)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int y2s_rpmh_vreg_enable(const char *res, unsigned mv);
+
+/* Live downstream DT has two positional reg entries, no reg-names. */
+#define RH_RSC_PA       0x18220000u
+#define RH_TCS_PA       0x18220d00u
+#define RH_TCS_SIZE     0x3000u
+#define RH_DICT_PA      0x0c3f000cu
+#define RH_DRV          2u
+#define RH_ACTIVE_N     2u       /* DT order: ACTIVE 2, SLEEP 3, WAKE 3 */
+#define RH_NORMAL_N     8u       /* hidden CONTROL TCS is not in this bank */
+#define RH_TCS_STRIDE   0x2a0u
+#define RH_CMD_STRIDE   0x14u
+#define RH_IRQ_EN       0x00u
+#define RH_IRQ_STATUS   0x04u
+#define RH_IRQ_CLEAR    0x08u
+#define RH_WAIT         0x10u
+#define RH_CONTROL      0x14u
+#define RH_STATUS       0x18u
+#define RH_ENABLE       0x1cu
+#define RH_MSGID        0x30u
+#define RH_ADDR         0x34u
+#define RH_DATA         0x38u
+#define RH_CMD_STATUS   0x3cu
+#define RH_AMC_EN       (1u << 16)
+#define RH_TRIGGER      (1u << 24)
+#define RH_ISSUED       (1u << 8)
+#define RH_COMPLETE     (1u << 16)
+#define RH_WRITE_ACK    (8u | (1u << 8) | (1u << 16))
+#define RH_DB_MAGIC     0x0c0330dbu
+#define RH_DB_HEADER    144u
+#define RH_DB_ENTRY     24u
+#define RH_DB_MAX       0x100000u /* policy bound, not a DT size */
+#define RH_VRM          4u
+#define RH_TIMEOUT_US   100000u
+
+static vm_offset_t rh_rsc, rh_tcs, rh_dict, rh_db;
+static uint32_t rh_db_size;
+static unsigned rh_ncpt;
+static unsigned rh_lock;
+static bool rh_poisoned;
+
+static uint32_t
+rh_read(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+rh_write(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+rh_sync(uint32_t off, uint32_t value)
+{
+	rh_write(rh_tcs, off, value);
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (rh_read(rh_tcs, off) == value) {
+			return true;
+		}
+		delay(1);
+	}
+	printf("Y2S RPMH: readback timeout off=%#x want=%#x got=%#x\n",
+	    off, value, rh_read(rh_tcs, off));
+	return false;
+}
+
+/* DB is little endian; avoid packed structs and unaligned Device loads. */
+static uint16_t
+rh_db16(uint32_t off)
+{
+	uint32_t v = rh_read(rh_db, off & ~3u);
+	return (uint16_t)(v >> (8u * (off & 3u)));
+}
+
+static bool
+rh_range(uint32_t off, uint32_t size)
+{
+	return off <= rh_db_size && size <= rh_db_size - off;
+}
+
+static int
+rh_map(void)
+{
+	if (!rh_rsc) {
+		rh_rsc = ml_io_map(RH_RSC_PA, 0x100);
+	}
+	if (!rh_tcs) {
+		rh_tcs = ml_io_map(RH_TCS_PA, RH_TCS_SIZE);
+	}
+	if (!rh_dict) {
+		rh_dict = ml_io_map(RH_DICT_PA, 8);
+	}
+	if (!rh_rsc || !rh_tcs || !rh_dict) {
+		printf("Y2S RPMH: RSC/locator mapping failed\n");
+		return ENOMEM;
+	}
+	uint32_t id = rh_read(rh_rsc, 0);
+	uint32_t solver = rh_read(rh_rsc, 4);
+	uint32_t config = rh_read(rh_rsc, 0x0c);
+	unsigned major = (id >> 16) & 0xffu;
+	unsigned count = (config >> (6u * RH_DRV)) & 0x3fu;
+	rh_ncpt = (config >> 27) & 0x1fu;
+	printf("Y2S RPMH: rsc=%#x tcs=%#x DRV=%u id=%#x solver=%#x config=%#x TCS=%u ncpt=%u\n",
+	    RH_RSC_PA, RH_TCS_PA, RH_DRV, id, solver, config, count, rh_ncpt);
+	/* This client implements the pre-v3 layout only; do not guess v3 offsets. */
+	if ((major != 1 && major != 2) || config == 0xffffffffu ||
+	    solver == 0xffffffffu || count < RH_NORMAL_N ||
+	    count > RH_TCS_SIZE / RH_TCS_STRIDE || rh_ncpt < 3 || rh_ncpt > 16) {
+		printf("Y2S RPMH: unsupported RSC geometry/revision\n");
+		return ENODEV;
+	}
+	if (!rh_db) {
+		uint32_t pa = rh_read(rh_dict, 0);
+		uint32_t size = rh_read(rh_dict, 4);
+		printf("Y2S RPMH: cmd-db locator=%#x pa=%#x size=%#x\n", RH_DICT_PA, pa, size);
+		/* Firmware supplies the reserved RAM address; never scan physical RAM. */
+		if (pa < 0x80000000u || (pa & 3u) || (size & 3u) ||
+		    size < RH_DB_HEADER || size > RH_DB_MAX ||
+		    (uint64_t)pa + size > 0x100000000ULL) {
+			printf("Y2S RPMH: invalid cmd-db locator\n");
+			return EINVAL;
+		}
+		rh_db = ml_io_map(pa, size);
+		if (!rh_db) {
+			return ENOMEM;
+		}
+		rh_db_size = size;
+	}
+	uint32_t db_version = rh_read(rh_db, 0);
+	uint32_t magic = rh_read(rh_db, 4);
+	uint32_t flags = rh_read(rh_db, 140);
+	printf("Y2S RPMH: cmd-db version=%#x magic=%#x checksum=%#x flags=%#x\n",
+	    db_version, magic, rh_read(rh_db, 136), flags);
+	/* Linux only checks magic; version 1 is an intentionally stricter policy. */
+	if (magic != RH_DB_MAGIC || db_version != 1 || (flags & 1u)) {
+		printf("Y2S RPMH: unsupported/standalone cmd-db\n");
+		return EINVAL;
+	}
+	return 0;
+}
+
+static int
+rh_lookup(const char *res, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			printf("Y2S RPMH: malformed cmd-db slave header %u\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16);
+			if (slave != RH_VRM || (addr >> 16) != RH_VRM || (addr & 15u) ||
+			    !rh_range(aux + rh_db16(e + 22), rh_db16(e + 20))) {
+				printf("Y2S RPMH: invalid VRM entry for %s\n", res);
+				return EINVAL;
+			}
+			*address = addr;
+			++matches;
+			printf("Y2S RPMH: %s addr=%#x slave=%u aux-version=%#x priority=%#x:%#x\n",
+			    res, addr, slave, rh_db16(h + 8),
+			    rh_read(rh_db, e + 8), rh_read(rh_db, e + 12));
+		}
+	}
+	if (matches != 1) {
+		printf("Y2S RPMH: %s lookup matches=%u; refusing\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+static bool
+rh_free(unsigned t)
+{
+	uint32_t b = t * RH_TCS_STRIDE;
+	/* Idle alone is insufficient: a sleep/wake payload can be armed and idle. */
+	return rh_read(rh_tcs, b + RH_STATUS) != 0 &&
+	    rh_read(rh_tcs, b + RH_STATUS) != 0xffffffffu &&
+	    rh_read(rh_tcs, b + RH_CONTROL) == 0 &&
+	    rh_read(rh_tcs, b + RH_ENABLE) == 0 &&
+	    rh_read(rh_tcs, b + RH_WAIT) == 0 &&
+	    !(rh_read(rh_tcs, RH_IRQ_STATUS) & (1u << t));
+}
+
+static int
+rh_send(uint32_t address, unsigned mv)
+{
+	int chosen = -1;
+	for (unsigned t = 0; t < RH_ACTIVE_N; ++t) {
+		uint32_t b = t * RH_TCS_STRIDE;
+		uint32_t enabled = rh_read(rh_tcs, b + RH_ENABLE);
+		printf("Y2S RPMH: ACTIVE TCS%u idle=%#x control=%#x enable=%#x wait=%#x\n",
+		    t, rh_read(rh_tcs, b + RH_STATUS), rh_read(rh_tcs, b + RH_CONTROL),
+		    enabled, rh_read(rh_tcs, b + RH_WAIT));
+		if (enabled & ~((1u << rh_ncpt) - 1u)) {
+			return EIO;
+		}
+		for (unsigned c = 0; c < rh_ncpt; ++c) {
+			if ((enabled & (1u << c)) &&
+			    (rh_read(rh_tcs, b + RH_ADDR + c * RH_CMD_STRIDE) & ~15u) == address) {
+				printf("Y2S RPMH: conflicting inherited L11C request in TCS%u\n", t);
+				return EBUSY;
+			}
+		}
+		if (chosen < 0 && rh_free(t)) {
+			chosen = (int)t;
+		}
+	}
+	if (chosen < 0) {
+		printf("Y2S RPMH: no empty idle ACTIVE TCS; leaving inherited state intact\n");
+		return EBUSY;
+	}
+	unsigned t = (unsigned)chosen;
+	uint32_t b = t * RH_TCS_STRIDE, bit = 1u << t;
+	uint32_t irq_en = rh_read(rh_tcs, RH_IRQ_EN);
+	if (irq_en == 0xffffffffu || !rh_free(t)) {
+		return EBUSY;
+	}
+	/* Only this TCS's source is masked. Other sources/CPU IRQs remain intact. */
+	if (!rh_sync(RH_IRQ_EN, irq_en & ~bit)) {
+		rh_poisoned = true;
+		return EIO;
+	}
+	if (!rh_free(t)) {
+		/* No payload was touched. Do not acknowledge somebody else's IRQ. */
+		if (!rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+			rh_poisoned = true;
+		}
+		return EBUSY;
+	}
+	/* From here an uncertain write/timeout quarantines our slot for this boot. */
+	rh_poisoned = true;
+	/* HPM (raw 7) is supported by this PMIC5 LDO; enable comes last. */
+	const uint32_t offsets[3] = {0, 8, 4};
+	const uint32_t values[3] = {mv, 7, 1};
+	printf("Y2S RPMH: TCS%u ACTIVE %u mV mode=7 enable=1 irq-enable=%#x\n", t, mv, irq_en);
+	for (unsigned c = 0; c < 3; ++c) {
+		uint32_t cmd = b + c * RH_CMD_STRIDE;
+		if (!rh_sync(cmd + RH_MSGID, RH_WRITE_ACK) ||
+		    !rh_sync(cmd + RH_ADDR, address + offsets[c]) ||
+		    !rh_sync(cmd + RH_DATA, values[c])) {
+			return EIO;
+		}
+	}
+	if (!rh_sync(b + RH_WAIT, 7) || !rh_sync(b + RH_ENABLE, 7) ||
+	    !rh_sync(b + RH_CONTROL, 0) || !rh_sync(b + RH_CONTROL, RH_AMC_EN)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
+	uint32_t irq = 0, idle = 0, status[3] = {0, 0, 0};
+	bool done = false, progress = false;
+	for (unsigned us = 0; us < RH_TIMEOUT_US; ++us) {
+		irq = rh_read(rh_tcs, RH_IRQ_STATUS);
+		idle = rh_read(rh_tcs, b + RH_STATUS);
+		bool complete = true;
+		for (unsigned c = 0; c < 3; ++c) {
+			status[c] = rh_read(rh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
+			complete &= status[c] != 0xffffffffu &&
+			    (status[c] & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
+		}
+		/* A fresh IRQ or observed execution transition excludes stale CMD_STATUS. */
+		progress |= idle == 0 || !complete;
+		if (idle && idle != 0xffffffffu && irq != 0xffffffffu &&
+		    ((irq & bit) || progress) && complete) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	printf("Y2S RPMH: TCS%u done=%d irq=%#x idle=%#x control=%#x cmd-status=%#x/%#x/%#x\n",
+	    t, done, irq, idle, rh_read(rh_tcs, b + RH_CONTROL), status[0], status[1], status[2]);
+	if (!done) {
+		printf("Y2S RPMH: timeout; TCS quarantined, IRQ remains masked; no reset/retry\n");
+		return ETIMEDOUT;
+	}
+	/* Proven completion: clear trigger before mode, then free only our commands. */
+	if (!rh_sync(b + RH_CONTROL, RH_AMC_EN) || !rh_sync(b + RH_CONTROL, 0) ||
+	    !rh_sync(b + RH_ENABLE, 0) || !rh_sync(b + RH_WAIT, 0)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, RH_IRQ_CLEAR, bit); /* W1C: never clear other TCS bits */
+	if ((rh_read(rh_tcs, RH_IRQ_STATUS) & bit) ||
+	    !rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+		return EIO;
+	}
+	rh_poisoned = false;
+	printf("Y2S RPMH: L11C ACTIVE vote complete (rail voltage requires hardware verification)\n");
+	return 0;
+}
+
+int
+y2s_rpmh_vreg_enable(const char *res, unsigned mv)
+{
+	/* Board-specific helper: do not apply PMIC5-LDO policy to arbitrary resources. */
+	if (!res || strcmp(res, "ldoc11") || mv < 2950 || mv > 3400) {
+		printf("Y2S RPMH: expected ldoc11 and 2950..3400 mV\n");
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("Y2S RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, &address);
+	}
+	if (!error) {
+		error = rh_send(address, mv);
+	}
+out:
+	if (error) {
+		printf("Y2S RPMH: enable failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+#endif /* ARM64_BOARD_CONFIG_Y2S */
diff --git a/bsd/dev/y2s_sample.c b/bsd/dev/y2s_sample.c
new file mode 100644
index 0000000..a946a3d
--- /dev/null
+++ b/bsd/dev/y2s_sample.c
@@ -0,0 +1,171 @@
+/*
+ * Y2S process sampler: where is a daemon stuck?
+ *
+ * The phone has no debugger and daemons log nowhere readable. Every
+ * interval a kernel thread prints, for each process named in boot-arg
+ * y2ssample (comma separated, default "SpringBoard,backboardd"; "-" = off)
+ * and for each of its threads, the user pc/lr/sp and a frame-pointer
+ * backtrace as "SMP name[pid] tN pc ... lr ... bt ..." (header line with the
+ * shared region slide and the main binary's mach header, to symbolicate
+ * with tools/y2s-crash.py). A thread blocked in a syscall shows the
+ * syscall stub in pc and its caller in lr/bt.
+ *
+ * First sample 90 s after start, then every 120 s, 40 samples at most.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/proc_internal.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+#include <sys/bsdtask_info.h>
+#include <mach/mach_time.h>
+
+extern task_t proc_task(proc_t);
+extern int hz;
+extern void y2s_sample_start(void);
+
+static char y2s_sample_names[128];
+
+static bool
+y2s_sample_wanted(const char *name)
+{
+	size_t n = strlen(name);
+	for (const char *t = y2s_sample_names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+
+extern void y2s_sample_task(const char *name, int pid, task_t task);  /* osfmk/kern/exception.c */
+
+static int
+y2s_sample_proc(proc_t p, __unused void *arg)
+{
+	char name[32];
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (y2s_sample_wanted(name)) {
+		task_t task = proc_task(p);
+		if (task != TASK_NULL) {
+			y2s_sample_task(name, proc_pid(p), task);
+		}
+	}
+	return PROC_RETURNED;
+}
+
+/*
+ * "top": CPU time (pti_total_user + system, mach absolute units) and
+ * pageins per process since the previous pass, 8 busiest printed as
+ * "TOP name[pid] cpu=<permille of the interval> pg=<pageins>".
+ */
+#define Y2S_TOP_MAX 160
+static struct { int pid; uint64_t cpu; int32_t pg; char name[20]; uint64_t dcpu; int32_t dpg; } y2s_top[Y2S_TOP_MAX];
+static int y2s_top_n;
+
+static int
+y2s_top_proc(proc_t p, __unused void *arg)
+{
+	struct proc_taskinfo_internal ti;
+	task_t task = proc_task(p);
+	int pid = proc_pid(p);
+	if (task == TASK_NULL) {
+		return PROC_RETURNED;
+	}
+	bzero(&ti, sizeof(ti));
+	fill_taskprocinfo(task, &ti);
+	uint64_t cpu = ti.pti_total_user + ti.pti_total_system;
+	int k;
+	for (k = 0; k < y2s_top_n && y2s_top[k].pid != pid; k++) {
+	}
+	if (k == y2s_top_n) {
+		if (y2s_top_n == Y2S_TOP_MAX) {
+			return PROC_RETURNED;
+		}
+		y2s_top_n++;
+		y2s_top[k].pid = pid;
+		y2s_top[k].cpu = 0;
+		y2s_top[k].pg = 0;
+	}
+	proc_name(pid, y2s_top[k].name, sizeof(y2s_top[k].name));
+	y2s_top[k].dcpu = cpu - y2s_top[k].cpu;
+	y2s_top[k].dpg = ti.pti_pageins - y2s_top[k].pg;
+	y2s_top[k].cpu = cpu;
+	y2s_top[k].pg = ti.pti_pageins;
+	return PROC_RETURNED;
+}
+
+static void
+y2s_top_pass(uint64_t interval)
+{
+	for (int k = 0; k < y2s_top_n; k++) {
+		y2s_top[k].dcpu = 0;
+		y2s_top[k].dpg = 0;
+	}
+	proc_iterate(PROC_ALLPROCLIST, y2s_top_proc, NULL, NULL, NULL);
+	uint64_t sum = 0;
+	int32_t pgsum = 0;
+	for (int k = 0; k < y2s_top_n; k++) {
+		sum += y2s_top[k].dcpu;
+		pgsum += y2s_top[k].dpg;
+	}
+	printf("TOP --- interval %llu, all procs cpu=%llu permille, pageins %d\n", interval,
+	    interval ? sum * 1000 / interval : 0, pgsum);
+	for (int shown = 0; shown < 8; shown++) {
+		int best = -1;
+		for (int k = 0; k < y2s_top_n; k++) {
+			if (y2s_top[k].dcpu && (best < 0 || y2s_top[k].dcpu > y2s_top[best].dcpu)) {
+				best = k;
+			}
+		}
+		if (best < 0) {
+			break;
+		}
+		printf("TOP %s[%d] cpu=%llu pg=%d\n", y2s_top[best].name, y2s_top[best].pid,
+		    interval ? y2s_top[best].dcpu * 1000 / interval : 0, y2s_top[best].dpg);
+		y2s_top[best].dcpu = 0;
+	}
+}
+
+static void
+y2s_sample_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	if (!PE_parse_boot_argn("y2ssample", y2s_sample_names, sizeof(y2s_sample_names))) {
+		strlcpy(y2s_sample_names, "SpringBoard,backboardd", sizeof(y2s_sample_names));
+	}
+	if (y2s_sample_names[0] == '-') {
+		return;
+	}
+	(void)tsleep(&chan, PZERO, "y2ssmp", 90 * hz);
+	uint64_t last = mach_absolute_time();
+	y2s_top_pass(0);
+	for (int i = 0; i < 40; i++) {
+		printf("SMP --- sample %d\n", i);
+		proc_iterate(PROC_ALLPROCLIST, y2s_sample_proc, NULL, NULL, NULL);
+		/* top every 20 s between samples */
+		for (int j = 0; j < 6; j++) {
+			(void)tsleep(&chan, PZERO, "y2ssmp", 20 * hz);
+			uint64_t now = mach_absolute_time();
+			y2s_top_pass(now - last);
+			last = now;
+		}
+	}
+}
+
+void
+y2s_sample_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(y2s_sample_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/y2s_sects.c b/bsd/dev/y2s_sects.c
new file mode 100644
index 0000000..776aa5c
--- /dev/null
+++ b/bsd/dev/y2s_sects.c
@@ -0,0 +1,538 @@
+/*
+ * Galaxy S20+ (Exynos 990) touch: Samsung sec_ts (Y79A) at I2C 0x48 on
+ * HSI2C 0x108D0000 (USI v2), polled. Register use follows Samsung's
+ * drivers/i2c/busses/i2c-exynos5.c (polling mode, stop after every
+ * message) and drivers/input/touchscreen/sec_ts/y79a/sec_ts.c (event
+ * format). Relies on S-Boot/firmware for the touch regulators (DT
+ * regulator-boot-on) and HSI2C clocks (no CMU writes here).
+ *
+ * Coordinates: the IC reports 0..4095 on both axes (DT sec,max_coords);
+ * they are converted to the presented iPhone X display (1125x2436, drawn
+ * x32/25 with 41 black rows at the top, Y2SFramebuffer.cpp 0089) and
+ * handed to Y2SHID with y2s_touch_logical set.
+ */
+#if defined(ARM64_BOARD_CONFIG_Y2S)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void y2s_hid_touch(int finger, int down, int x, int y);
+extern int y2s_touch_logical;
+void y2s_sects_init(void);
+
+#define I2C_PA           0x108d0000u
+#define GPP5_PA          0x10730000u    /* PERIC1 pinctrl, bank gpp5 at +0 */
+#define PMIC_I2C_PA      0x10590000u    /* HSI2C with the S2DOS05 display PMIC */
+#define PMIC_ADDR        0x60
+#define GPP1_PA          0x10430000u    /* PERIC0 pinctrl */
+#define S2DOS05_EN       0x03           /* bit1 = LDO2 tsp_io, bit2 = LDO3 tsp_avdd */
+#define S2DOS05_LDO2_CFG 0x05           /* 1.5 V + 25 mV * sel -> 1.8 V = 12 */
+#define S2DOS05_LDO3_CFG 0x06           /* 2.7 V + 25 mV * sel -> 3.0 V = 12 */
+
+#define HSI2C_CTL        0x00
+#define HSI2C_FIFO_CTL   0x04
+#define HSI2C_TRAILIG    0x08
+#define HSI2C_INT_EN     0x20
+#define HSI2C_INT_STAT   0x24
+#define HSI2C_FIFO_STAT  0x30
+#define HSI2C_TX_DATA    0x34
+#define HSI2C_RX_DATA    0x38
+#define HSI2C_CONF       0x40
+#define HSI2C_AUTO_CONF  0x44
+#define HSI2C_TIMEOUT    0x48
+#define HSI2C_TRANS_STAT 0x50
+#define HSI2C_TIMING_FS1 0x60
+#define HSI2C_TIMING_FS2 0x64
+#define HSI2C_TIMING_FS3 0x68
+#define HSI2C_ADDR       0x70
+#define USI_CON          0xc4
+
+#define CTL_MASTER       (1u << 3)
+#define CTL_RXCHON       (1u << 6)
+#define CTL_TXCHON       (1u << 7)
+#define CTL_SW_RST       (1u << 31)
+#define CONF_AUTO_MODE   (1u << 31)
+#define AUTO_READ        (1u << 16)
+#define AUTO_STOP        (1u << 17)
+#define AUTO_RUN         (1u << 31)
+#define INT_XFER_DONE    (1u << 7)
+#define INT_ERRORS       (0xfu << 8)    /* incl. NODEV (bit 10) */
+#define FIFO_RX_EMPTY    (1u << 24)
+#define FIFO_TX_EMPTY    (1u << 8)
+#define FIFO_TX_LVL(x)   ((x) & 0x7f)
+
+#define TS_ADDR          0x48
+#define TS_SENSE_ON      0x10
+#define TS_DEVICE_ID     0x22
+#define TS_BOOT_STATUS   0x55
+#define TS_ONE_EVENT     0x60
+#define TS_ALL_EVENT     0x61
+#define TS_CLEAR_STACK   0x62
+#define TS_EVENT_SIZE    16
+#define TS_MAX_EVENTS    32
+#define TS_FINGERS       10
+
+#define LOGICAL_W        1125
+#define LOGICAL_H        2436
+#define PANEL_H          3200
+#define PAD_Y            41             /* (3200 - 2436 * 32 / 25) / 2 */
+
+static vm_offset_t i2c, gpio;
+static uint8_t i2c_addr = 0x48;
+static vm_offset_t pmic_i2c;
+static bool pmic_ok;
+static int sleep_chan;
+static int raw_logged;
+static uint32_t active;
+static int fx[TS_FINGERS], fy[TS_FINGERS];
+
+static uint32_t
+rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(i2c + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+wr(uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(i2c + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static void
+wait_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+hsi2c_reset(void)
+{
+	wr(USI_CON, 0);                         /* release USI reset */
+	wr(HSI2C_CTL, rd(HSI2C_CTL) | CTL_SW_RST);
+	wr(HSI2C_CTL, rd(HSI2C_CTL) & ~CTL_SW_RST);
+	/*
+	 * Fast-mode timing as exynos5_i2c_set_timing() computes it, with the
+	 * divider for ~100 kHz from the DT's 200 MHz IP clock (slower is safe
+	 * if the clock is lower).
+	 */
+	/* 400 kHz from 200 MHz: fs_div 33, TSCL_H 0xe0, TSTART_HD 0xf0. */
+	wr(HSI2C_TIMING_FS3, (rd(HSI2C_TIMING_FS3) & ~0x00ff0000u) | (33u << 16));
+	wr(HSI2C_TIMING_FS2, (rd(HSI2C_TIMING_FS2) & ~0xffu) | 0xe0);
+	wr(HSI2C_TIMING_FS1, (rd(HSI2C_TIMING_FS1) & ~0x00ff0000u) | (0xf0u << 16));
+	wr(HSI2C_CTL, CTL_MASTER);
+	wr(HSI2C_TRAILIG, 0xffffff);
+	wr(HSI2C_CONF, rd(HSI2C_CONF) | CONF_AUTO_MODE);
+}
+
+/* One message with STOP (DT samsung,stop-after-trans). 0 = ok. */
+static int
+hsi2c_msg(bool read, uint8_t *buf, unsigned len)
+{
+	uint32_t ctl = rd(HSI2C_CTL), auto_conf = rd(HSI2C_AUTO_CONF);
+	unsigned trig = len < 32 ? len : 32, n = 0;
+
+	wr(HSI2C_TIMEOUT, rd(HSI2C_TIMEOUT) & ~(1u << 31));
+	wr(HSI2C_FIFO_CTL, 3u | (trig << 4) | (trig << 16));
+	if (read) {
+		ctl = (ctl & ~CTL_TXCHON) | CTL_RXCHON;
+		auto_conf |= AUTO_READ;
+	} else {
+		ctl = (ctl & ~CTL_RXCHON) | CTL_TXCHON;
+		auto_conf &= ~AUTO_READ;
+	}
+	auto_conf |= AUTO_STOP;
+	wr(HSI2C_ADDR, (rd(HSI2C_ADDR) & ~(0xffu << 24 | 0xfffffu)) | (7u << 24) | ((uint32_t)i2c_addr << 10));
+	wr(HSI2C_CTL, ctl);
+	wr(HSI2C_INT_STAT, rd(HSI2C_INT_STAT));
+	wr(HSI2C_INT_EN, INT_XFER_DONE);
+	wr(HSI2C_AUTO_CONF, (auto_conf & ~0xffffu) | len);
+	wr(HSI2C_AUTO_CONF, rd(HSI2C_AUTO_CONF) | AUTO_RUN);
+
+	for (unsigned t = 0; t < 20000; t++) {         /* ~20 ms + access time */
+		if (read) {
+			while (n < len && !(rd(HSI2C_FIFO_STAT) & FIFO_RX_EMPTY)) {
+				buf[n++] = (uint8_t)rd(HSI2C_RX_DATA);
+			}
+			if (n >= len) {
+				return 0;
+			}
+		} else {
+			while (n < len && FIFO_TX_LVL(rd(HSI2C_FIFO_STAT)) < 16) {
+				wr(HSI2C_TX_DATA, buf[n++]);
+			}
+			uint32_t is = rd(HSI2C_INT_STAT);
+			if (n >= len && (is & INT_XFER_DONE) && (rd(HSI2C_FIFO_STAT) & FIFO_TX_EMPTY)) {
+				wr(HSI2C_INT_STAT, is);
+				return 0;
+			}
+		}
+		if (rd(HSI2C_INT_STAT) & INT_ERRORS) {
+			break;
+		}
+		delay(1);
+	}
+	uint32_t is = rd(HSI2C_INT_STAT), ts = rd(HSI2C_TRANS_STAT);
+	hsi2c_reset();
+	return (int)(0x80000000u | (is & 0xffffu) << 8 | (ts & 0xff));
+}
+
+static int
+pmic_rd(uint8_t reg, uint8_t *v)
+{
+	int r = hsi2c_msg(false, &reg, 1);
+	return r ? r : hsi2c_msg(true, v, 1);
+}
+
+static int
+pmic_wr(uint8_t reg, uint8_t v)
+{
+	uint8_t b[2] = { reg, v };
+	return hsi2c_msg(false, b, 2);
+}
+
+/* Switch on the touch supplies (DT: s2dos05 ldo2 tsp_io 1.8 V, ldo3 tsp_avdd 3.0 V). */
+static void
+touch_power(void)
+{
+	uint8_t id = 0, en = 0, l2 = 0, l3 = 0;
+	i2c = ml_io_map(PMIC_I2C_PA, 0x1000);
+	i2c_addr = PMIC_ADDR;
+	printf("Y2S SECTS: pmic bus ctl 0x%08x conf 0x%08x usi 0x%08x\n",
+	    rd(HSI2C_CTL), rd(HSI2C_CONF), rd(USI_CON));
+	/*
+	 * HSI2C4 sits on USI02, a UART/SPI/I2C port: select I2C (USI v2 mode 4)
+	 * in SYSREG_PERIC0 (DT usi@10421014 usi_v2_mode = "i2c"). Also log its
+	 * CMU_PERIC0 clocks (cmucal-sfr.c: QCH 0x302c, gate 0x20c4, IPCLK_9
+	 * 0x2044, PCLK_9 0x2074, div 0x180c, user mux 0x640).
+	 */
+	{
+		vm_offset_t sys = ml_io_map(0x10421000u, 0x1000);
+		vm_offset_t cmu = ml_io_map(0x10400000u, 0x8000);
+		volatile uint32_t *mode = (volatile uint32_t *)(sys + 0x014);  /* USI02_USI (0x1004 USI00, 0x100c USI01) */
+		uint32_t before = *mode;
+		*mode = 0x4;
+		__asm__ volatile ("dsb osh" ::: "memory");
+		printf("Y2S SECTS: usi02 mode 0x%x -> 0x%x; cmu qch 0x%08x gate 0x%08x ip9 0x%08x p9 0x%08x div 0x%08x mux 0x%08x\n",
+		    before, *mode,
+		    *(volatile uint32_t *)(cmu + 0x302c), *(volatile uint32_t *)(cmu + 0x20c4),
+		    *(volatile uint32_t *)(cmu + 0x2044), *(volatile uint32_t *)(cmu + 0x2074),
+		    *(volatile uint32_t *)(cmu + 0x180c), *(volatile uint32_t *)(cmu + 0x640));
+	}
+	/* gpp1-0/1 = HSI2C4 SCL/SDA, function 2, no pull (DT hsi2c4-bus); PERIC0 pinctrl, gpp1 at +0x20. */
+	{
+		vm_offset_t p0 = ml_io_map(GPP1_PA, 0x1000);
+		volatile uint32_t *con = (volatile uint32_t *)(p0 + 0x20);
+		volatile uint32_t *pud = (volatile uint32_t *)(p0 + 0x28);
+		printf("Y2S SECTS: gpp1 con 0x%08x pud 0x%08x\n", *con, *pud);
+		*con = (*con & ~0xffu) | 0x22u;
+		*pud = *pud & ~0xffu;
+		__asm__ volatile ("dsb osh" ::: "memory");
+	}
+	hsi2c_reset();
+	printf("Y2S SECTS: pmic bus after reset ctl 0x%08x conf 0x%08x usi 0x%08x trans 0x%08x fs3 0x%08x\n",
+	    rd(HSI2C_CTL), rd(HSI2C_CONF), rd(USI_CON), rd(HSI2C_TRANS_STAT), rd(HSI2C_TIMING_FS3));
+	int r0 = pmic_rd(0x00, &id);
+	int r1 = pmic_rd(S2DOS05_EN, &en);
+	(void)pmic_rd(S2DOS05_LDO2_CFG, &l2);
+	(void)pmic_rd(S2DOS05_LDO3_CFG, &l3);
+	printf("Y2S SECTS: s2dos05 rc 0x%x/0x%x id 0x%02x en 0x%02x ldo2 0x%02x ldo3 0x%02x\n",
+	    r0, r1, id, en, l2, l3);
+	pmic_ok = (r1 == 0);
+	pmic_i2c = i2c;
+	i2c_addr = TS_ADDR;
+}
+
+/*
+ * Reset a stuck touch IC by switching S2DOS05 supplies in `mask` off for
+ * 50 ms (bit2 = LDO3 tsp_avdd, bit1 = LDO2 tsp_io). Cycling both at once
+ * also blanked the panel, so one rail at a time, LDO3 first.
+ */
+static void
+touch_cycle(uint8_t mask, unsigned off_us)
+{
+	vm_offset_t touch_i2c = i2c;
+	uint8_t en = 0;
+	if (!pmic_ok) {
+		return;
+	}
+	i2c = pmic_i2c;
+	i2c_addr = PMIC_ADDR;
+	if (pmic_rd(S2DOS05_EN, &en) == 0) {
+		/*
+		 * The panel runs from LDO1 (ddi-vdd3), LDO4 (ddi-vci) and BUCK1
+		 * (ddr-vddr) (DT dsim regulators). EN reads 0x0e with the LDO1 and
+		 * BUCK1 bits clear while the panel is lit, so writing EN back
+		 * without them switched the panel off. Keep bits 0/3/4 set.
+		 */
+		const uint8_t panel = 0x19;
+		uint8_t en2 = 0;
+		(void)pmic_wr(S2DOS05_EN, (uint8_t)((en | panel) & ~mask));
+		delay(off_us);                  /* microseconds */
+		int rw = pmic_wr(S2DOS05_EN, (uint8_t)(en | panel | mask));
+		(void)pmic_rd(S2DOS05_EN, &en2);
+		printf("Y2S SECTS: cycled supply mask 0x%02x for %u us (en 0x%02x -> 0x%02x), rc 0x%x\n",
+		    mask, off_us, en, en2, rw);
+	}
+	i2c = touch_i2c;
+	i2c_addr = TS_ADDR;
+	wait_ms(300);                           /* IC boot after power-on */
+}
+
+static int
+ts_cmd(uint8_t cmd)
+{
+	return hsi2c_msg(false, &cmd, 1);
+}
+
+static int
+ts_read(uint8_t reg, uint8_t *buf, unsigned len)
+{
+	int r = hsi2c_msg(false, &reg, 1);
+	return r ? r : hsi2c_msg(true, buf, len);
+}
+
+static void
+ts_event(const uint8_t *e)
+{
+	unsigned eid = e[0] & 3, tid = (e[0] >> 2) & 0xf, sta = e[0] >> 6;
+	if (eid != 0 || tid == 0 || tid > TS_FINGERS) {
+		if (raw_logged < 40) {
+			raw_logged++;
+			printf("Y2S SECTS: event %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7]);
+		}
+		return;
+	}
+	int rx = (e[1] << 4) | (e[3] >> 4), ry = (e[2] << 4) | (e[3] & 0xf);
+	unsigned id = tid - 1;
+	if (raw_logged < 40) {
+		raw_logged++;
+		printf("Y2S SECTS: finger %u sta %u raw %d,%d\n", id, sta, rx, ry);
+	}
+	int x = rx * LOGICAL_W / 4096;
+	int y = ((ry * PANEL_H / 4096) - PAD_Y) * 25 / 32;
+	if (sta == 3) {                         /* release */
+		if (active & (1u << id)) {
+			active &= ~(1u << id);
+			y2s_hid_touch((int)id, 0, fx[id], fy[id]);
+		}
+		return;
+	}
+	if (sta == 1 || sta == 2) {             /* press / move */
+		if (!(active & (1u << id)) || x != fx[id] || y != fy[id]) {
+			fx[id] = x;
+			fy[id] = y;
+			active |= 1u << id;
+			y2s_hid_touch((int)id, 1, x, y);
+		}
+	}
+}
+
+/*
+ * I2C bus recovery on gpp5-6 (SCL) / gpp5-7 (SDA) as GPIOs, open-drain
+ * style (high = input + pull-up, low = output 0): 9 clocks, then STOP.
+ * Logs the line levels with pull-ups and after recovery. Leaves both
+ * pins as inputs without pulls.
+ */
+static void
+bus_recover(void)
+{
+	volatile uint32_t *con = (volatile uint32_t *)gpio;
+	volatile uint32_t *dat = (volatile uint32_t *)(gpio + 4);
+	volatile uint32_t *pud = (volatile uint32_t *)(gpio + 8);
+#define LVL(pin) ((*dat >> (pin)) & 1u)
+#define REL(pin) (*con = *con & ~(0xfu << (4 * (pin))))
+#define LOW(pin) do { *dat = *dat & ~(1u << (pin)); \
+	*con = (*con & ~(0xfu << (4 * (pin)))) | (1u << (4 * (pin))); } while (0)
+
+	REL(6);
+	REL(7);
+	*pud = (*pud & 0x00ffffffu) | 0x33000000u;      /* pull-up */
+	__asm__ volatile ("dsb osh" ::: "memory");
+	delay(200);
+	printf("Y2S SECTS: with pull-ups scl %u sda %u\n", LVL(6), LVL(7));
+	unsigned released = 0;
+	for (int i = 0; i < 9; i++) {
+		LOW(6);
+		delay(10);
+		REL(6);
+		delay(10);
+		if (LVL(7)) {
+			released++;
+		}
+	}
+	/* STOP: SDA low while SCL high, then release SDA. */
+	LOW(7);
+	delay(10);
+	REL(6);
+	delay(10);
+	REL(7);
+	delay(50);
+	printf("Y2S SECTS: after 9 clocks + stop scl %u sda %u (sda high on %u clocks)\n",
+	    LVL(6), LVL(7), released);
+	*pud = *pud & 0x00ffffffu;
+	__asm__ volatile ("dsb osh" ::: "memory");
+#undef LVL
+#undef REL
+#undef LOW
+}
+
+static void
+sects_thread(void *arg, wait_result_t wr_)
+{
+	unsigned delay_s = 30;
+	uint8_t ev[TS_MAX_EVENTS][TS_EVENT_SIZE];
+	(void)arg;
+	(void)wr_;
+	(void)PE_parse_boot_argn("y2stouchdelay", &delay_s, sizeof(delay_s));
+	printf("Y2S SECTS: starting in %u s\n", delay_s);
+	wait_ms(delay_s * 1000u);
+
+	touch_power();
+	i2c = ml_io_map(I2C_PA, 0x1000);
+	gpio = ml_io_map(GPP5_PA, 0x1000);
+	/* gpp5-6/7 = HSI2C SCL/SDA (function 3), no pull (DT tspi2c-bus). */
+	volatile uint32_t *con = (volatile uint32_t *)gpio;
+	volatile uint32_t *pud = (volatile uint32_t *)(gpio + 8);
+	printf("Y2S SECTS: gpp5 con 0x%08x pud 0x%08x, hsi2c ctl 0x%08x conf 0x%08x usi 0x%08x\n",
+	    *con, *pud, rd(HSI2C_CTL), rd(HSI2C_CONF), rd(USI_CON));
+	/* Line levels with SCL/SDA as plain inputs, no pulls: 1/1 = bus idle-high. */
+	*con = *con & 0x00ffffffu;
+	*pud = *pud & 0x00ffffffu;
+	__asm__ volatile ("dsb osh" ::: "memory");
+	delay(100);
+	printf("Y2S SECTS: lines scl %u sda %u\n",
+	    (*(volatile uint32_t *)(gpio + 4) >> 6) & 1, (*(volatile uint32_t *)(gpio + 4) >> 7) & 1);
+	bus_recover();
+	/*
+	 * Touch HSI2C clocks in CMU_PERIC1 (cmucal-sfr.c): QCH USI07_I2C 0x3038,
+	 * gate RSTNSYNC USI_I2C 0x2104, div 0x182c, user mux 0x6c0. Force the
+	 * gate (MANUAL bit20 + CG_VAL bit21) and Q-channel (CLOCK_REQ, no auto) on.
+	 */
+	{
+		vm_offset_t cmu = ml_io_map(0x10700000u, 0x8000);
+		volatile uint32_t *qch = (volatile uint32_t *)(cmu + 0x3038);
+		volatile uint32_t *gate = (volatile uint32_t *)(cmu + 0x2104);
+		printf("Y2S SECTS: peric1 qch 0x%08x gate 0x%08x div 0x%08x mux 0x%08x\n",
+		    *qch, *gate, *(volatile uint32_t *)(cmu + 0x182c), *(volatile uint32_t *)(cmu + 0x6c0));
+		*gate = *gate | (3u << 20);
+		*qch = (*qch & ~1u) | 2u;
+		__asm__ volatile ("dsb osh" ::: "memory");
+		printf("Y2S SECTS: peric1 now qch 0x%08x gate 0x%08x\n", *qch, *gate);
+	}
+	*con = (*con & 0x00ffffffu) | 0x33000000u;
+	*pud = *pud & 0x00ffffffu;
+	__asm__ volatile ("dsb osh" ::: "memory");
+	hsi2c_reset();
+
+	uint8_t id[5] = {0}, boot = 0;
+	int r1 = ts_read(TS_DEVICE_ID, id, 5);
+	/* Stuck IC (holds SCL/SDA low after S-Boot): least disruptive reset first. */
+	/*
+	 * LDO2 (tsp_io) also feeds the panel: a 50 ms cycle frees the IC but
+	 * blanks the display. Shortest dip first; the panel's decoupling may
+	 * ride through one the IC already resets on.
+	 */
+	static const struct { uint8_t mask; unsigned us; } tries[] = {
+		{ 0x02, 30000 },        /* LDO2 tsp_io off 30 ms, as sec_ts_power() */
+	};
+	/* Power cycle on by default; y2stouchcycle=0 disables it. */
+	int allow_cycle = 1;
+	(void)PE_parse_boot_argn("y2stouchcycle", &allow_cycle, sizeof(allow_cycle));
+	for (unsigned t = 0; allow_cycle && r1 != 0 && t < sizeof(tries) / sizeof(tries[0]); t++) {
+		printf("Y2S SECTS: id rc 0x%x, try %u\n", r1, t);
+		touch_cycle(tries[t].mask, tries[t].us);
+		r1 = ts_read(TS_DEVICE_ID, id, 5);
+	}
+	int r2 = ts_read(TS_BOOT_STATUS, &boot, 1);
+	printf("Y2S SECTS: id rc 0x%x %02x %02x %02x %02x %02x, boot rc 0x%x status 0x%02x\n",
+	    r1, id[0], id[1], id[2], id[3], id[4], r2, boot);
+	if (r1 != 0) {
+		printf("Y2S SECTS: no answer from the touch IC, giving up\n");
+		return;
+	}
+	(void)ts_cmd(TS_CLEAR_STACK);
+	int r3 = ts_cmd(TS_SENSE_ON);
+	printf("Y2S SECTS: sense on rc 0x%x, polling\n", r3);
+	y2s_touch_logical = 1;
+
+	/*
+	 * The IC pulls its interrupt line (gpa1-0, ALIVE pinctrl 0x15850000,
+	 * bank +0x20, DAT +0x04) low while events are pending: poll that pin
+	 * (no I2C traffic, no busy-wait) and read events only when it is low.
+	 * Every 50th idle tick an I2C read is done anyway, in case the line
+	 * does not behave as expected.
+	 */
+	vm_offset_t alive = ml_io_map(0x15850000u, 0x1000);
+	volatile uint32_t *attn = (volatile uint32_t *)(alive + 0x24);
+	printf("Y2S SECTS: attn line %u (gpa1 con 0x%08x)\n", *attn & 1,
+	    *(volatile uint32_t *)(alive + 0x20));
+	unsigned idle = 0;
+
+	for (unsigned errors = 0;;) {
+		if ((*attn & 1) && ++idle < 50) {
+			wait_ms(8);
+			continue;
+		}
+		idle = 0;
+		int r = ts_read(TS_ONE_EVENT, ev[0], TS_EVENT_SIZE);
+		if (r != 0) {
+			if (++errors < 10) {
+				printf("Y2S SECTS: read rc 0x%x\n", r);
+			}
+			wait_ms(100);
+			continue;
+		}
+		if (ev[0][0] == 0) {
+			wait_ms(8);
+			continue;
+		}
+		if ((ev[0][0] & 3) == 3) {
+			(void)ts_cmd(TS_CLEAR_STACK);
+			continue;
+		}
+		unsigned left = ev[0][7] & 0x1f;
+		if (left > TS_MAX_EVENTS - 1) {
+			left = TS_MAX_EVENTS - 1;
+		}
+		if (left && ts_read(TS_ALL_EVENT, ev[1], left * TS_EVENT_SIZE) != 0) {
+			left = 0;
+		}
+		for (unsigned i = 0; i <= left; i++) {
+			ts_event(ev[i]);
+		}
+	}
+}
+
+void
+y2s_sects_init(void)
+{
+	static bool started;
+	int enabled = 1;
+	thread_t thread;
+	if (started) {
+		return;
+	}
+	started = true;
+	(void)PE_parse_boot_argn("y2stouch", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("Y2S SECTS: disabled (y2stouch=0)\n");
+		return;
+	}
+	if (kernel_thread_start(sects_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_Y2S */
diff --git a/bsd/dev/y2s_spmi.c b/bsd/dev/y2s_spmi.c
new file mode 100644
index 0000000..467ae58
--- /dev/null
+++ b/bsd/dev/y2s_spmi.c
@@ -0,0 +1,126 @@
+/*
+ * Battery-only adaptation of input/y2s_keys.c, observer EXT_READL.
+ * PMIC READ ONLY. The only MMIO store issues a one-byte read command.
+ * No interrupt clear, peripheral enable, charger config, or PMIC writes.
+ * Init is serialized by the single built-in Y2SBattery personality.
+ * Battery APIDs are disjoint from the existing keys' 008/4c1 APIDs.
+ */
+#if defined(ARM64_BOARD_CONFIG_Y2S)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <machine/machine_routines.h>
+#include <IOKit/IOLocks.h>
+#include "y2s_spmi.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define SP_CORE_PA 0x0c440000u
+#define SP_OBS_PA  0x0e600000u
+#define SP_CFG_PA  0x0c40a000u
+#define SP_NO_APID 0xffffu
+
+static vm_offset_t sp_core, sp_obs, sp_cfg;
+static IOLock *sp_lock;
+static unsigned sp_count;
+static bool sp_attempted, sp_ready;
+/* A timed-out command may complete late: never reuse that lane this boot. */
+static bool sp_poisoned[512];
+
+static uint32_t
+sp_rd(vm_offset_t base, unsigned off)
+{
+	uint32_t value = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static uint16_t
+sp_find_apid(unsigned ppid)
+{
+	uint16_t found = SP_NO_APID;
+	for (unsigned i = 0; i < sp_count; ++i) {
+		uint32_t map = sp_rd(sp_core, 0x900u + 4u * i);
+		if (!map || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		unsigned owner = sp_rd(sp_cfg, 0x700u + 4u * i) & 7u;
+		if (found == SP_NO_APID || owner == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+int
+y2s_spmi_init(void)
+{
+	if (sp_attempted) {
+		return sp_ready ? 0 : -1;
+	}
+	sp_attempted = true;
+	sp_lock = IOLockAlloc();
+	if (!sp_lock) {
+		return -1;
+	}
+	sp_core = ml_io_map(SP_CORE_PA, 0x2000);
+	sp_cfg = ml_io_map(SP_CFG_PA, 0x1000);
+	sp_obs = ml_io_map(SP_OBS_PA, 0x10000); /* EE 0, 512 * 0x80 */
+	if (!sp_core || !sp_cfg || !sp_obs) {
+		printf("Y2S BATTERY: SPMI mapping failed\n");
+		return -1;
+	}
+	uint32_t arb_version = sp_rd(sp_core, 0);
+	sp_count = sp_rd(sp_core, 4) & 0x7ffu;
+	if (arb_version < 0x50000000u || arb_version >= 0x70000000u ||
+	    !sp_count || sp_count > 512) {
+		printf("Y2S BATTERY: unsupported SPMI arb=%#x APIDs=%u\n",
+		    arb_version, sp_count);
+		return -1;
+	}
+	sp_ready = true;
+	printf("Y2S BATTERY: SPMI arb=%#x APIDs=%u, observer reads only\n",
+	    arb_version, sp_count);
+	return 0;
+}
+
+int
+y2s_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
+{
+	/* Restrict access to the battery blocks; keys retain their own lanes. */
+	unsigned peripheral = addr >> 8;
+	if (!sp_ready || !out || sid != 0 || addr > 0xffffu ||
+	    (peripheral != 0x10 && peripheral != 0x11 && peripheral != 0x12 &&
+	    peripheral != 0x13 && peripheral != 0x48)) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | peripheral);
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	unsigned off = 0x80u * apid;
+	uint32_t cmd = (1u << 27) | ((addr & 0xffu) << 4);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_obs + off) = cmd; /* EXT_READL, BC=0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(sp_obs, off + 0x08u);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				IOLockUnlock(sp_lock);
+				return -1;
+			}
+			*out = (uint8_t)sp_rd(sp_obs, off + 0x18u);
+			IOLockUnlock(sp_lock);
+			return 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("Y2S BATTERY: SPMI timeout sid=%u addr=%#x APID=%u disabled\n",
+	    sid, addr, apid);
+	IOLockUnlock(sp_lock);
+	return -1;
+}
+#endif /* ARM64_BOARD_CONFIG_Y2S */
diff --git a/bsd/dev/y2s_spmi.h b/bsd/dev/y2s_spmi.h
new file mode 100644
index 0000000..0bb7017
--- /dev/null
+++ b/bsd/dev/y2s_spmi.h
@@ -0,0 +1,14 @@
+/* Shared C/C++ interface. Init once, on the Y2SBattery start thread. */
+#ifndef Y2S_BATTERY_SPMI_H
+#define Y2S_BATTERY_SPMI_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+int y2s_spmi_init(void);
+/* Thread context only; 0 success, -1 failure; *out unchanged on failure. */
+int y2s_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/y2s_touch.c b/bsd/dev/y2s_touch.c
new file mode 100644
index 0000000..f2bb196
--- /dev/null
+++ b/bsd/dev/y2s_touch.c
@@ -0,0 +1,660 @@
+/*
+ * Y2S SE7 FIFO I2C / GT9896 Yellowstone / Focaltech 54:52 bring-up.
+ * Call once after the scheduler is running; all work runs on one thread.
+ * Requires ABL-loaded GENI I2C firmware; votes L11C through y2s_rpmh.c.
+ * No firmware/config upload or direct PMIC writes. Only IC data write:
+ * zero to GT9896's event status after reading a report. See touch2/report.md.
+ */
+#if defined(ARM64_BOARD_CONFIG_Y2S)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* Mach MIG declaration is not included by BSD's exported thread.h. */
+extern kern_return_t thread_terminate(thread_t);
+extern int y2s_rpmh_vreg_enable(const char *res, unsigned mv);
+extern void y2s_hid_touch(int finger, int down, int x, int y);
+void y2s_touch_init(void);
+
+#define TOUCH_SE_PA      0x00a84000u
+#define TOUCH_GCC_PA     0x00100000u
+#define TOUCH_NORTH_PA   0x03900000u /* DT TLMM + NORTH (0x500000) */
+#define TOUCH_GCC_VOTE   0x5200cu
+#define TOUCH_RCG       0x18148u    /* wrapper1 LOCAL S1 = global SE7 */
+#define TOUCH_GPIO_CFG(n) ((uint32_t)(n) * 0x1000u)
+#define TOUCH_GPIO_IO(n)  (TOUCH_GPIO_CFG(n) + 4u)
+#define TOUCH_MAX        10u
+#define TOUCH_GOODIX     1
+#define TOUCH_FTS        2
+/* GT9896 is Yellowstone in Xiaomi y2s-r-oss, not the Berlin protocol. */
+#define GOODIX_PID_REG   0x4022u
+#define GOODIX_EVENT_REG 0x4180u
+#define GOODIX_HEAD_LEN  8u
+#define GOODIX_POINT_LEN 8u
+
+#define SE_STATUS       0x040u
+#define SE_MCLK         0x048u
+#define SE_FW           0x068u
+#define SE_CLK_SEL      0x07cu
+#define SE_DMA          0x258u
+#define SE_TX_LEN       0x26cu
+#define SE_RX_LEN       0x270u
+#define SE_SCL          0x278u
+#define SE_CMD          0x600u
+#define SE_CTRL         0x604u
+#define SE_IRQ          0x610u
+#define SE_IRQ_EN       0x614u
+#define SE_IRQ_CLR      0x618u
+#define SE_TX           0x700u
+#define SE_RX           0x780u
+#define SE_TX_COUNT     0x800u
+#define SE_RX_COUNT     0x804u
+#define SE_HW_TX        0xe24u
+#define SE_HW_RX        0xe28u
+#define SE_TX_WM        0x80cu
+#define SE_RX_WM_IRQ    (1u << 26)
+#define SE_RX_LAST      (1u << 27)
+#define SE_TX_WM_IRQ    (1u << 30)
+#define SE_DONE         (1u << 0)
+#define SE_NACK         (1u << 10)
+#define SE_ERRORS       (0x3eu | (1u << 9) | (1u << 10) | (1u << 12) | \
+                         (1u << 13) | (3u << 24) | (3u << 28))
+#define SE_EVENTS       (SE_DONE | SE_ERRORS | SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ)
+/* geni_se_config_packing(8, 4, true, true, true): start bits 7/15/23/31,
+ * MSB-to-LSB, length 8, STOP only on vector 3. FIFO bytes remain LSB first. */
+#define SE_PACK0        0x0007f8feu
+#define SE_PACK1        0x000ffefeu
+
+static struct {
+	vm_offset_t se, gcc, gpio;
+	bool started, dead, probing;
+	int kind, irq_hint;
+	uint32_t irq_status, irq_last, active;
+	unsigned sent, got;
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+} st;
+static int touch_sleep_chan;
+
+static uint32_t
+touch_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+touch_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+touch_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&touch_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+touch_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(touch_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+touch_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out, bool high)
+{
+	uint32_t off = TOUCH_GPIO_CFG(pin);
+	uint32_t cfg = touch_rd(st.gpio, off);
+	if (out) {
+		/* Set the desired latch before enabling output (reset is active low). */
+		touch_wr(st.gpio, TOUCH_GPIO_IO(pin),
+		    (touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	touch_wr(st.gpio, off, cfg);
+}
+
+static bool
+touch_clocks(void)
+{
+	/* Vote on only wrapper1 and SE7, preserving other clock users. */
+	uint32_t mask = (0x0fu << 18) | (1u << 23);
+	touch_wr(st.gcc, TOUCH_GCC_VOTE, touch_rd(st.gcc, TOUCH_GCC_VOTE) | mask);
+	uint32_t dfs = touch_rd(st.gcc, TOUCH_RCG + 0x14u);
+	uint32_t cfg = touch_rd(st.gcc, TOUCH_RCG + 4u);
+	printf("Y2S TOUCH: gcc vote=%#x rcg=%#x cfg=%#x dfs=%#x\n",
+	    touch_rd(st.gcc, TOUCH_GCC_VOTE), touch_rd(st.gcc, TOUCH_RCG), cfg, dfs);
+	if (dfs & 1u) {
+		/* SE CLK_SEL=0 selects DFS performance level 0. Do not alter tables. */
+		cfg = touch_rd(st.gcc, TOUCH_RCG + 0x1cu);
+		if ((cfg & 0x371fu) != 1u) {
+			printf("Y2S TOUCH: DFS level0=%#x is not XO/1; need clock integration\n", cfg);
+			return false;
+		}
+	} else {
+		/* XO parent 0, HID divider 1 => 19.2 MHz. No PLL or voltage change. */
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+		touch_wr(st.gcc, TOUCH_RCG + 4u, cfg);
+		touch_wr(st.gcc, TOUCH_RCG, touch_rd(st.gcc, TOUCH_RCG) | 1u);
+		if (!touch_wait_clear(st.gcc, TOUCH_RCG, 1u)) {
+			printf("Y2S TOUCH: RCG update timeout\n");
+			return false;
+		}
+	}
+	const uint32_t branches[] = {0x18004, 0x18008, 0x1800c, 0x18010, 0x18144};
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
+		if (!touch_wait_clear(st.gcc, branches[i], 1u << 31)) {
+			printf("Y2S TOUCH: GCC branch %#x halted (%#x)\n", branches[i],
+			    touch_rd(st.gcc, branches[i]));
+			return false;
+		}
+	}
+	return true;
+}
+
+/* Called only for a transfer started by this driver, including a stretched TX. */
+static void
+touch_abort(void)
+{
+	touch_wr(st.se, SE_CTRL, 2); /* abort M command, release held bus */
+	bool done = false;
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (touch_rd(st.se, SE_IRQ) & (1u << 5)) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done || !touch_wait_clear(st.se, SE_STATUS, 1u)) {
+		st.dead = true;
+		printf("Y2S TOUCH: abort failed status=%#x irq=%#x; stopping\n",
+		    touch_rd(st.se, SE_STATUS), touch_rd(st.se, SE_IRQ));
+	}
+	/* Bound drain even if the hardware reports an impossible FIFO count. */
+	for (unsigned i = 0; i < 64 && (touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)touch_rd(st.se, SE_RX);
+	}
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	if (touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) {
+		st.dead = true;
+		printf("Y2S TOUCH: TX FIFO not empty after abort; stopping\n");
+	}
+}
+
+/* Keep all observed bits for diagnostics, even if a watermark was cleared. */
+static uint32_t
+touch_irq(void)
+{
+	st.irq_last = touch_rd(st.se, SE_IRQ);
+	st.irq_status |= st.irq_last;
+	return st.irq_last;
+}
+
+/* One Linux-style FIFO message. TX is at most 3 bytes; RX at most 90. */
+static int
+touch_msg_run(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	if (st.dead || nt > 3 || nr > 90 || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	if (!touch_wait_clear(st.se, SE_STATUS, 1u)) {
+		st.dead = true; /* no other SE7 owner is supported */
+		return EBUSY;
+	}
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, SE_TX_WM, nt ? 1u : 0u);
+	touch_wr(st.se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+	touch_wr(st.se, SE_CMD, ((nr ? 2u : 1u) << 27) |
+	    ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
+	int err = ETIMEDOUT;
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = touch_irq();
+		if (irq & SE_ERRORS) {
+			err = (irq & SE_NACK) ? ENXIO : EIO;
+			/* A completed NACK is normal during address probing. Aborting an
+			 * idle sequencer may never produce ABORT_DONE. Wait for completion
+			 * and leave a clean idle engine available for the other IC. */
+			for (unsigned j = 0; j < 5000 && !(irq & SE_DONE); ++j) {
+				delay(1);
+				irq = touch_irq();
+			}
+			if ((irq & SE_DONE) && !(touch_rd(st.se, SE_STATUS) & 1u) &&
+			    !(touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) &&
+			    !(touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+				touch_wr(st.se, SE_IRQ_CLR, irq);
+				return err;
+			}
+			break;
+		}
+		if (nt && !st.sent && (irq & SE_TX_WM_IRQ)) {
+			uint32_t word = 0;
+			for (unsigned j = 0; j < nt; ++j) {
+				word |= (uint32_t)tx[j] << (8u * j);
+			}
+			touch_wr(st.se, SE_TX, word);
+			st.sent = nt;
+			touch_wr(st.se, SE_TX_WM, 0);
+		}
+		uint32_t count = touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu;
+		if (count > 64 || count > (nr - st.got + 3u) / 4u) {
+			err = EIO;
+			break;
+		}
+		while (count--) {
+			uint32_t word = touch_rd(st.se, SE_RX);
+			for (unsigned j = 0; j < 4 && st.got < nr; ++j) {
+				rx[st.got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		/* DONE is checked after draining RX, so final short words aren't lost. */
+		if (irq & SE_DONE) {
+			/* Re-sample after the final drain; a late error must beat DONE. */
+			irq = touch_irq();
+			if (irq & SE_ERRORS) {
+				continue;
+			}
+			touch_wr(st.se, SE_IRQ_CLR, irq);
+			if (st.got == nr && st.sent == nt) {
+				return 0;
+			}
+			err = EIO;
+			break;
+		}
+		/* Preserve DONE/errors if they arrive during this iteration. */
+		touch_wr(st.se, SE_IRQ_CLR, irq & (SE_RX_WM_IRQ | SE_RX_LAST | SE_TX_WM_IRQ));
+		delay(1);
+	}
+	touch_abort();
+	return err;
+}
+
+static int
+touch_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	st.irq_status = st.irq_last = 0;
+	st.sent = st.got = 0;
+	int err = touch_msg_run(addr, tx, nt, rx, nr, stretch);
+	if (st.probing) {
+		printf("Y2S TOUCH: probe xfer addr=%#x %s len=%u stretch=%u err=%d irq=%#x seen=%#x tx=%u rx=%u status=%#x\n",
+		    addr, nr ? "read" : "write", nr ? nr : nt, stretch ? 1u : 0u,
+		    err, st.irq_last, st.irq_status, st.sent, st.got,
+		    touch_rd(st.se, SE_STATUS));
+	}
+	return err;
+}
+
+static int
+touch_read(uint8_t addr, uint16_t reg, bool wide, uint8_t *buf, unsigned len)
+{
+	uint8_t ptr[2] = {(uint8_t)(reg >> 8), (uint8_t)reg};
+	int err = touch_msg(addr, wide ? ptr : ptr + 1, wide ? 2u : 1u,
+	    NULL, 0, true);
+	if (err) {
+		return err;
+	}
+	/* STOP_STRETCH on the pointer write retains the bus for a repeated START. */
+	return touch_msg(addr, NULL, 0, buf, len, false);
+}
+
+static int
+touch_goodix_ack(void)
+{
+	const uint8_t ack[3] = {GOODIX_EVENT_REG >> 8, GOODIX_EVENT_REG & 0xffu, 0};
+	return touch_msg(0x5d, ack, sizeof(ack), NULL, 0, false);
+}
+
+/* Raw read only: 0x8240 is the vendor's generic/older VERSION candidate,
+ * not a second accepted GT9896 identity. Never try a four-byte Berlin pointer:
+ * on this 16-bit IC the extra bytes would be register data writes. */
+static int
+touch_probe_info(uint16_t reg, uint8_t *buf)
+{
+	memset(buf, 0xa5, 32);
+	int err = touch_read(0x5d, reg, true, buf, 32);
+	printf("Y2S TOUCH: probe info reg=%#x len=32 err=%d irq=%#x seen=%#x\n",
+	    reg, err, st.irq_last, st.irq_status);
+	if (!err) {
+		for (unsigned off = 0; off < 32; off += 16) {
+			char line[49];
+			for (unsigned j = 0; j < 16; ++j) {
+				(void)snprintf(line + j * 3u, 4, "%02x ", buf[off + j]);
+			}
+			printf("Y2S TOUCH: probe raw %#x: %s\n", reg + off, line);
+		}
+	}
+	return err;
+}
+
+static unsigned
+touch_be16(const uint8_t *p)
+{
+	return ((unsigned)p[0] << 8) | p[1];
+}
+
+static bool
+touch_checksum(const uint8_t *buf, unsigned len)
+{
+	if (len < 2) {
+		return false;
+	}
+	unsigned sum = 0;
+	for (unsigned i = 0; i + 2 < len; ++i) {
+		sum += buf[i];
+	}
+	return (sum & 0xffffu) == touch_be16(buf + len - 2);
+}
+
+static void
+touch_report(uint32_t mask, const int *x, const int *y)
+{
+	for (unsigned id = 0; id < TOUCH_MAX; ++id) {
+		uint32_t bit = 1u << id;
+		if (mask & bit) {
+			if (!(st.active & bit) || x[id] != st.x[id] || y[id] != st.y[id]) {
+				y2s_hid_touch((int)id, 1, x[id], y[id]);
+			}
+			st.x[id] = x[id];
+			st.y[id] = y[id];
+		} else if (st.active & bit) {
+			y2s_hid_touch((int)id, 0, st.x[id], st.y[id]);
+		}
+	}
+	st.active = mask;
+}
+
+static int
+touch_goodix(void)
+{
+	uint8_t buf[90];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	int err = touch_read(0x5d, GOODIX_EVENT_REG, true, buf, GOODIX_HEAD_LEN);
+	if (err) {
+		return err;
+	}
+	if (!(buf[0] & 0x80u)) {
+		/* Do not acknowledge firmware/config requests that we cannot service. */
+		if (buf[0] & 0x40u) {
+			return ENOTSUP;
+		}
+		return 0; /* no new touch frame: retain current contacts */
+	}
+	if (!touch_checksum(buf, GOODIX_HEAD_LEN)) {
+		return EIO; /* header untrusted: no write to the IC */
+	}
+	unsigned n = buf[2] & 15u;
+	if (n > TOUCH_MAX) {
+		(void)touch_goodix_ack();
+		return EIO;
+	}
+	if (n) {
+		err = touch_read(0x5d, GOODIX_EVENT_REG + GOODIX_HEAD_LEN, true,
+		    buf + GOODIX_HEAD_LEN, n * GOODIX_POINT_LEN + 2u);
+		if (err) {
+			return err;
+		}
+		if (!touch_checksum(buf + GOODIX_HEAD_LEN, n * GOODIX_POINT_LEN + 2u)) {
+			(void)touch_goodix_ack();
+			return EIO;
+		}
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *p = buf + GOODIX_HEAD_LEN + i * GOODIX_POINT_LEN;
+		unsigned id = p[0] >> 4;
+		unsigned px = touch_be16(p + 2), py = touch_be16(p + 4);
+		/* Low nibble 1/3 denotes pen data in the vendor parser. */
+		if ((p[0] & 15u) == 1u || (p[0] & 15u) == 3u || id >= TOUCH_MAX ||
+		    (mask & (1u << id)) || px > 1079 || py > 2399) {
+			(void)touch_goodix_ack();
+			return EIO;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+	err = touch_goodix_ack();
+	if (!err) {
+		touch_report(mask, x, y);
+	}
+	return err;
+}
+
+static int
+touch_focaltech(void)
+{
+	uint8_t buf[63];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0, seen = 0;
+	int err = touch_read(0x38, 0, false, buf, sizeof(buf));
+	if (err) {
+		return err;
+	}
+	unsigned n = buf[2] & 15u, active = 0;
+	if ((buf[0] & 0x70u) || n > TOUCH_MAX) {
+		return EIO;
+	}
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		const uint8_t *p = buf + 3u + 6u * i;
+		unsigned id = p[2] >> 4, event = p[0] >> 6;
+		if (id >= TOUCH_MAX) {
+			break; /* vendor's unused-record sentinel */
+		}
+		if (seen & (1u << id)) {
+			return EIO;
+		}
+		seen |= 1u << id;
+		if (event == 1u) {
+			continue; /* UP record */
+		}
+		if (event == 3u) {
+			return EIO;
+		}
+		unsigned px = ((unsigned)(p[0] & 15u) << 8) | p[1];
+		unsigned py = ((unsigned)(p[2] & 15u) << 8) | p[3];
+		if (px > 1079 || py > 2399) {
+			return EIO;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+		++active;
+	}
+	if (active != n) {
+		return EIO;
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
+
+static bool
+touch_se_init(void)
+{
+	uint32_t fw = touch_rd(st.se, SE_FW);
+	uint32_t tx = touch_rd(st.se, SE_HW_TX), rx = touch_rd(st.se, SE_HW_RX);
+	printf("Y2S TOUCH: se7 fw=%#x proto=%u status=%#x tx=%#x rx=%#x ios=%#x\n",
+	    fw, (fw >> 8) & 0xffu, touch_rd(st.se, SE_STATUS), tx, rx,
+	    touch_rd(st.se, 0x908));
+	if (((fw >> 8) & 0xffu) != 3u || (touch_rd(st.se, 0x64) & 1u) ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
+	    ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {
+		printf("Y2S TOUCH: need ABL-loaded I2C firmware and 32-bit FIFOs; probes skipped\n");
+		return false;
+	}
+	if (touch_rd(st.se, SE_STATUS) & 0x1001u) {
+		printf("Y2S TOUCH: SE7 already busy; probes skipped\n");
+		return false;
+	}
+	touch_wr(st.se, 0xe18, 0); /* no GSI events */
+	touch_wr(st.se, 0xe1c, 0); /* mask external IRQ routing; poll local status */
+	touch_wr(st.se, 0x644, 0);
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, 0x648, 0xffffffffu);
+	touch_wr(st.se, SE_DMA, 0);
+	touch_wr(st.se, 0x28, touch_rd(st.se, 0x28) | 0x7fu);
+	touch_wr(st.se, 0xe30, touch_rd(st.se, 0xe30) | 0x0fu);
+	touch_wr(st.se, 0x24, 0x7f);
+	touch_wr(st.se, 0x20, 1);
+	touch_wr(st.se, SE_CLK_SEL, 0);
+	touch_wr(st.se, SE_MCLK, (7u << 4) | 1u);
+	touch_wr(st.se, SE_SCL, (10u << 20) | (11u << 10) | 26u); /* 100 kHz */
+	/* Linux 8-bit I2C packing: MSB on the wire, LSB byte first in FIFO. */
+	touch_wr(st.se, 0x254, 0);
+	touch_wr(st.se, 0x260, SE_PACK0);
+	touch_wr(st.se, 0x264, SE_PACK1);
+	touch_wr(st.se, 0x284, SE_PACK0);
+	touch_wr(st.se, 0x288, SE_PACK1);
+	touch_wr(st.se, SE_TX_WM, 0);
+	touch_wr(st.se, 0x810, 0);
+	touch_wr(st.se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
+	touch_wr(st.se, SE_IRQ_EN, SE_EVENTS);
+	printf("Y2S TOUCH: packing tx=%#x/%#x rx=%#x/%#x gran=%#x\n",
+	    touch_rd(st.se, 0x260), touch_rd(st.se, 0x264),
+	    touch_rd(st.se, 0x284), touch_rd(st.se, 0x288), touch_rd(st.se, 0x254));
+	if (touch_rd(st.se, 0x260) != SE_PACK0 || touch_rd(st.se, 0x264) != SE_PACK1 ||
+	    touch_rd(st.se, 0x284) != SE_PACK0 || touch_rd(st.se, 0x288) != SE_PACK1 ||
+	    touch_rd(st.se, 0x254) != 0) {
+		printf("Y2S TOUCH: packing readback mismatch; probes skipped\n");
+		return false;
+	}
+	if ((touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) ||
+	    (touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("Y2S TOUCH: inherited FIFO data; probes skipped\n");
+		return false;
+	}
+	return true;
+}
+
+static void
+touch_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 45;
+	(void)arg;
+	(void)result;
+	/*
+	 * Start late (boot-arg y2stouchdelay, seconds): if the bus access
+	 * below hangs the SoC, the persistent log and the GUI got there first.
+	 */
+	(void)PE_parse_boot_argn("y2stouchdelay", &delay_s, sizeof(delay_s));
+	printf("Y2S TOUCH: starting in %u s\n", delay_s);
+	touch_wait(delay_s * 1000u);
+	printf("Y2S TOUCH: mapping GCC/TLMM/SE7\n");
+	st.gcc = ml_io_map(TOUCH_GCC_PA, 0x60000);
+	st.gpio = ml_io_map(TOUCH_NORTH_PA, 0x5b000);
+	st.se = ml_io_map(TOUCH_SE_PA, 0x4000);
+	if (!st.gcc || !st.gpio || !st.se) {
+		printf("Y2S TOUCH: MMIO mapping failed\n");
+		goto out;
+	}
+	if (!touch_clocks() || !touch_se_init()) {
+		goto out;
+	}
+	printf("Y2S TOUCH: TLMM reset=%#x irq=%#x vdd90=%#x; voting L11C through RPMh\n",
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(8)), touch_rd(st.gpio, TOUCH_GPIO_IO(9)),
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(90)));
+	/* Keep the IC in reset while its rails settle; IRQ stays an input. */
+	touch_gpio(9, 0, 3, 3, false, false); /* IRQ input, 8 mA, pull-up */
+	touch_gpio(8, 0, 3, 3, true, false);
+	int power_error = y2s_rpmh_vreg_enable("ldoc11", 3200);
+	if (power_error) {
+		printf("Y2S TOUCH: L11C RPMh enable failed %d; probes skipped\n", power_error);
+		goto out;
+	}
+	touch_gpio(90, 0, 0, 0, true, true); /* board digital power enable */
+	touch_wait(10); /* conservative rail settling; not a DT timing value */
+	touch_gpio(6, 1, 0, 0, false, false); /* qup11 SDA/SCL, 2 mA */
+	touch_gpio(7, 1, 0, 0, false, false);
+	/* Vendor GT9896 dev_confirm: reset low 2 ms, then high. */
+	touch_gpio(8, 0, 3, 3, true, false);
+	touch_wait(2);
+	touch_gpio(8, 0, 3, 3, true, true);
+	touch_wait(300); /* exceeds vendor 5 ms test + 95 ms post-test wait */
+	uint8_t gid[32], legacy[32], fid1 = 0, fid2 = 0;
+	st.probing = true;
+	int ge = touch_probe_info(GOODIX_PID_REG, gid);
+	printf("Y2S TOUCH: probe 0x5d err=%d pid=%02x%02x%02x%02x fw=%02x.%02x.%02x.%02x irq=%#x\n",
+	    ge, gid[0], gid[1], gid[2], gid[3], gid[8], gid[9], gid[10], gid[11], st.irq_status);
+	(void)touch_probe_info(0x8240, legacy);
+	int fe1 = touch_read(0x38, 0xa3, false, &fid1, 1);
+	int fe2 = touch_read(0x38, 0x9f, false, &fid2, 1);
+	printf("Y2S TOUCH: probe 0x38 err=%d/%d chip-id=%02x:%02x irq=%#x\n",
+	    fe1, fe2, fid1, fid2, st.irq_status);
+	st.probing = false;
+	bool goodix = !ge && gid[0] == '9' && gid[1] == '8' && gid[2] == '9' && gid[3] == '6';
+	bool fts = !fe1 && !fe2 && fid1 == 0x54 && fid2 == 0x52;
+	if (st.dead || goodix == fts) {
+		printf("Y2S TOUCH: no unique supported IC (goodix=%d fts=%d dead=%d); stopping\n",
+		    goodix, fts, st.dead);
+		goto out;
+	}
+	st.kind = goodix ? TOUCH_GOODIX : TOUCH_FTS;
+	printf("Y2S TOUCH: selected %s, 1080x2400, poll=10ms irq-hint=%d\n",
+	    goodix ? "GT9896 Yellowstone" : "Focaltech 54:52", st.irq_hint);
+	unsigned errors = 0, ticks = 0;
+	while (!st.dead) {
+		/* Optional IRQ hint still reads every 100ms, and always while down. */
+		if (!st.irq_hint || st.active || !(touch_rd(st.gpio, TOUCH_GPIO_IO(9)) & 1u) ||
+		    (++ticks % 10u) == 0) {
+			int err = st.kind == TOUCH_GOODIX ? touch_goodix() : touch_focaltech();
+			if (err) {
+				if ((errors++ % 100u) == 0) {
+					printf("Y2S TOUCH: report err=%d irq=%#x\n", err, st.irq_status);
+				}
+				if (errors == 10) {
+					touch_report(0, st.x, st.y); /* release after persistent bad reads */
+				}
+			} else {
+				errors = 0;
+			}
+		}
+		touch_wait(10);
+	}
+	touch_report(0, st.x, st.y);
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+y2s_touch_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (st.started) {
+		return;
+	}
+	st.started = true;
+	(void)PE_parse_boot_argn("y2stouch", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("y2stouchirq", &st.irq_hint, sizeof(st.irq_hint));
+	if (!enabled) {
+		printf("Y2S TOUCH: disabled (y2stouch=0)\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(touch_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("Y2S TOUCH: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_Y2S */
diff --git a/bsd/dev/y2s_ufs.c b/bsd/dev/y2s_ufs.c
new file mode 100644
index 0000000..bc213e9
--- /dev/null
+++ b/bsd/dev/y2s_ufs.c
@@ -0,0 +1,1029 @@
+/*
+ * Y2S internal UFS root device.
+ *
+ * The Qualcomm UFS host (UFSHCI 2.1) is left enabled with the link up by the
+ * bootloader, which loaded our boot image from it. This driver reuses that
+ * state: it points the transfer request list at its own memory (verifying the
+ * host took it before ringing any doorbell) and issues polled SCSI commands,
+ * one at a time, to LUN 0. It finds one GPT partition by name (boot-arg
+ * ufsroot=, default "userdata") and exposes it as the BSD disk ufsroot0
+ * (rufsroot0), with 512-byte logical sectors over the device's 4 KiB blocks.
+ * Root on it with rd=ufsroot0.
+ *
+ * All DMA goes through one physically contiguous allocation (descriptors and
+ * a 1 MiB bounce buffer); the host is not cache coherent, so caches are
+ * cleaned/invalidated around each command.
+ *
+ * Galaxy S20+ (Exynos 990, ADT /y2s-ufs compatible "samsung,exynos-ufs"):
+ * the same UFSHCI programming model as Samsung's ufs-exynos.c (SM-G986B
+ * kernel): PRDT and response offsets/lengths in bytes
+ * (UFSHCD_QUIRK_PRDT_BYTE_GRAN), 128-byte PRDT entries after the EL3 call
+ * FMP_SECURITY(DESCTYPE_3) + SMU_INIT that Linux makes at every boot, size
+ * word bits 28-31 = 0 (FMP bypass, plain data), and a request-list clear
+ * that takes the slot bit itself (UFSHCI_QUIRK_BROKEN_REQ_LIST_CLR). The
+ * Qualcomm-only input drivers below are not started there.
+ *
+ * Writes are refused unless boot-arg ufsrw=1 is set. Every write is checked
+ * against the partition bounds again right before it is issued, so nothing
+ * outside the named partition can be written.
+ */
+#if defined(ARM64_BOARD_CONFIG_Y2S)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+#include <machine/atomic.h>
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+/* osfmk/arm/cpu_data.h, not exported to the BSD layer */
+extern int get_preemption_level(void);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern int hz;
+static void y2s_log_start(void);
+extern void y2s_sample_start(void);
+extern void y2s_keys_init(void);
+extern void y2s_touch_init(void);
+extern void y2s_sects_init(void);
+extern void y2s_acpm_init(void);
+extern void y2s_usb_probe(void);
+
+#define REG_CAP         0x00
+#define REG_IS          0x20
+#define REG_IE          0x24
+#define REG_HCS         0x30
+#define REG_HCE         0x34
+#define REG_UTRLBA      0x50
+#define REG_UTRLBAU     0x54
+#define REG_UTRLDBR     0x58
+#define REG_UTRLCLR     0x5c
+#define REG_UTRLRSR     0x60
+#define REG_AHIT        0x18                    /* auto-hibernate idle timer (UFSHCI 3.0) */
+
+#define HCS_DP          (1u << 0)
+#define HCS_UTRLRDY     (1u << 1)
+#define CAP_64AS        (1u << 24)              /* 64-bit DMA addressing */
+
+#define UFS_BLOCK       4096u
+#define BOUNCE_SIZE     (1u << 20)
+#define PRDT_CHUNK      (256u << 10)            /* PRDT byte count field: 18 bits */
+#define PRDT_CHUNK_EXYNOS (4u << 10)            /* HCI_TXPRDT_ENTRY_SIZE 12: 2^12 per entry */
+#define PRDT_MAX        (BOUNCE_SIZE / PRDT_CHUNK_EXYNOS)
+#define CMD_TIMEOUT_NS  (5ull * NSEC_PER_SEC)
+#define CMD_SPIN_NS     (50ull * NSEC_PER_USEC)
+#define CMD_SLEEP_NS    (200ull * NSEC_PER_USEC)
+
+struct utrd {
+	uint32_t dw0, dw1, dw2, dw3;
+	uint32_t ucdba, ucdbau;
+	uint32_t resp;          /* [31:16] response UPIU offset, [15:0] length, DWORDs */
+	uint32_t prdt;          /* [31:16] PRDT offset (DWORDs), [15:0] entries */
+};
+
+/* PRDT entry: 16 bytes on standard UFSHCI, 128 on Exynos (FMP descriptor type 3). */
+struct prd {
+	uint32_t addr_lo, addr_hi, rsvd, dbc;
+};
+#define PRD_SIZE_STD    16u
+#define PRD_SIZE_EXYNOS 128u
+
+struct ucd {
+	uint8_t cmd[512];
+	uint8_t resp[512];
+	uint8_t prdt[PRDT_MAX * PRD_SIZE_EXYNOS];
+};
+
+/* Exynos vendor HCI registers (ufs-exynos.h) */
+#define VS_TXPRDT_ENTRY_SIZE    0x00
+#define VS_RXPRDT_ENTRY_SIZE    0x04
+#define VS_PRDT_PREFETCH_EN     (1u << 31)
+#define VS_PRDT_SET_SIZE(x)     ((x) & 0x1f)
+/* EL3 calls (include/linux/smc.h, drivers/crypto/fmp/fmp.c) */
+#define SMC_CMD_FMP_SECURITY    0xC2001810u
+#define SMC_CMD_SMU             0xC2001850u
+#define FMP_CFG_DESCTYPE_3      3u
+#define SMU_INIT                0u
+
+/* Layout of the contiguous DMA allocation. */
+#define DMA_UTRL        0x0000                  /* 1 KiB aligned */
+#define DMA_UCD         0x1000                  /* 128 byte aligned */
+#define DMA_BOUNCE      0x10000                 /* UCD with 256 x 128-byte PRDT entries before */
+#define DMA_SIZE        (DMA_BOUNCE + BOUNCE_SIZE)
+_Static_assert(DMA_UCD + sizeof(struct ucd) <= DMA_BOUNCE, "UCD overlaps the bounce buffer");
+
+static struct {
+	vm_offset_t regs;
+	vm_offset_t vs_regs;                    /* Exynos vendor HCI block, 0 otherwise */
+	bool exynos;
+	uint32_t prd_size;                      /* PRDT entry size in bytes */
+	vm_offset_t dma;                        /* kernel VA of the DMA allocation */
+	uint64_t dma_pa;
+	uint8_t lun;
+	uint8_t tag;
+	uint64_t first_block, nblocks;          /* partition, in 4 KiB device blocks */
+	uint32_t secsize;                       /* logical sector size for the BSD layer */
+	bool writable;                          /* boot-arg ufsrw=1 */
+	bool cache;                             /* boot-arg ufscache=1 */
+	bool wait;                              /* boot-arg ufswait=1 */
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool ready;
+	uint8_t target_lun;                     /* LUN of the next command (su.lun or a W-LUN) */
+	uint8_t sense_key, asc, ascq;           /* of the last CHECK CONDITION */
+	uint32_t last_is;                       /* IS at the last completion */
+	bool last_rang;                         /* doorbell bit seen set after ringing */
+	bool last_unprocessed;                  /* host never touched the last command */
+} su;
+
+#define UFS_WLUN_DEVICE         0xd0            /* UFS Device well-known LU */
+
+static LCK_GRP_DECLARE(y2s_ufs_grp, "y2s_ufs");
+static LCK_MTX_DECLARE(y2s_ufs_lock, &y2s_ufs_grp);
+
+static inline uint32_t
+ufs_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(su.regs + off);
+}
+
+static inline void
+ufs_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(su.regs + off) = v;
+}
+
+static void
+dma_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
+}
+
+static void
+dma_clean(uint32_t off, uint32_t len)
+{
+	clean_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
+}
+
+/*
+ * One SCSI command in slot 0, data (if any) to/from the bounce buffer
+ * (to the device when write is set). Returns 0 or an errno.
+ */
+static int ufs_take_over_host(void);
+
+/* Bytes of PRDT a transfer of len bytes uses. */
+static uint32_t
+n_prdt_bytes(uint32_t len)
+{
+	uint32_t step = su.exynos ? PRDT_CHUNK_EXYNOS : PRDT_CHUNK;
+	return ((len + step - 1) / step) * su.prd_size;
+}
+
+static int
+ufs_scsi_once(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD, bounce_pa = su.dma_pa + DMA_BOUNCE;
+
+	assert(len <= BOUNCE_SIZE);
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+
+	ucd->cmd[0] = 0x01;                     /* COMMAND UPIU */
+	ucd->cmd[1] = len ? (write ? 0x20 : 0x40) : 0x00;      /* W: data out, R: data in */
+	ucd->cmd[2] = su.target_lun;
+	ucd->cmd[3] = ++su.tag;
+	ucd->cmd[12] = (uint8_t)(len >> 24);
+	ucd->cmd[13] = (uint8_t)(len >> 16);
+	ucd->cmd[14] = (uint8_t)(len >> 8);
+	ucd->cmd[15] = (uint8_t)len;
+	memcpy(&ucd->cmd[16], cdb, cdb_len);
+
+	/* DD: 1 = memory to device, 2 = device to memory. */
+	utrd->dw0 = (1u << 28) | ((len ? (write ? 1u : 2u) : 0u) << 25) | (1u << 24);
+	utrd->dw2 = 0x0f;                       /* OCS invalid until updated */
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = su.exynos ? (512u << 16 | 512u) : ((512u / 4) << 16 | (512u / 4));
+	if (len) {
+		uint32_t n = 0;
+		uint32_t step = su.exynos ? PRDT_CHUNK_EXYNOS : PRDT_CHUNK;
+		for (uint32_t done = 0; done < len; done += step, n++) {
+			uint32_t chunk = MIN(step, len - done);
+			struct prd *prd = (struct prd *)(void *)&ucd->prdt[n * su.prd_size];
+			prd->addr_lo = (uint32_t)(bounce_pa + done);
+			prd->addr_hi = (uint32_t)((bounce_pa + done) >> 32);
+			/* Bits 28-31 stay 0: FMP file/disk encryption bypassed. */
+			prd->dbc = chunk - 1;
+		}
+		utrd->prdt = (1024u / 4) << 16 | n;
+		if (su.exynos) {
+			/* Offsets and lengths in bytes, not DWORDs. */
+			utrd->prdt = 1024u << 16 | (n * su.prd_size);
+		}
+	}
+
+	if (su.cache) {
+		dma_clean(DMA_UTRL, sizeof(*utrd));
+		dma_clean(DMA_UCD, 16 + cdb_len);
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+		if (len) {
+			dma_clean(DMA_UCD + offsetof(struct ucd, prdt),
+			    n_prdt_bytes(len));
+		}
+	} else {
+		dma_sync(DMA_UTRL, sizeof(*utrd));
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+	if (len) {
+		if (su.cache && write) {
+			dma_clean(DMA_BOUNCE, len);
+		} else {
+			dma_sync(DMA_BOUNCE, len);
+		}
+	}
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1);
+	su.last_rang = (ufs_rd(REG_UTRLDBR) & 1) != 0;
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	bool sleepable = su.wait && su.ready && ml_get_interrupts_enabled() &&
+	    !ml_at_interrupt_context() && get_preemption_level() == 0;
+	uint64_t spin_until = 0, sleep_interval = 0;
+	if (sleepable) {
+		nanoseconds_to_absolutetime(CMD_SPIN_NS, &spin_until);
+		spin_until += mach_absolute_time();
+		nanoseconds_to_absolutetime(CMD_SLEEP_NS, &sleep_interval);
+	}
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		uint64_t now = mach_absolute_time();
+		if (now > deadline) {
+			/* Exynos: the clear register takes the slot bit, not its inverse. */
+			ufs_wr(REG_UTRLCLR, su.exynos ? 1u : ~1u);
+			printf("Y2S UFS: command 0x%02x timed out\n", cdb[0]);
+			return ETIMEDOUT;
+		}
+		if (sleepable && now >= spin_until) {
+			uint64_t wake = now + MIN(sleep_interval, deadline - now);
+			/* Keep the mutex: slot 0 and the bounce buffer are still owned. */
+			if (assert_wait_deadline_with_leeway((event_t)&su.wait, THREAD_UNINT,
+			    TIMEOUT_URGENCY_SYS_CRITICAL, wake, 0) == THREAD_WAITING) {
+				thread_block(THREAD_CONTINUE_NULL);
+			}
+		} else {
+			delay(1);
+		}
+	}
+	__builtin_arm_dsb(0xf);
+	su.last_is = ufs_rd(REG_IS);
+	ufs_wr(REG_IS, su.last_is);             /* acknowledge completion status */
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	if (su.cache) {
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+	} else {
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+	if (len && !(su.cache && write)) {
+		dma_sync(DMA_BOUNCE, len);
+	}
+
+	uint32_t ocs = utrd->dw2 & 0xff;
+	su.sense_key = su.asc = su.ascq = 0;
+	su.last_unprocessed = (ocs == 0x0f && ucd->resp[0] == 0);
+	if (ucd->resp[0] == 0x21 && ucd->resp[7] == 0x02) {
+		/* CHECK CONDITION: fixed-format sense data after the 2-byte length at 32. */
+		uint16_t slen = (uint16_t)(ucd->resp[32] << 8 | ucd->resp[33]);
+		if (slen >= 14) {
+			su.sense_key = ucd->resp[34 + 2] & 0x0f;
+			su.asc = ucd->resp[34 + 12];
+			su.ascq = ucd->resp[34 + 13];
+		}
+		printf("Y2S UFS: LUN 0x%x command 0x%02x: CHECK CONDITION sense %x/%02x/%02x (ocs 0x%x)\n",
+		    su.target_lun, cdb[0], su.sense_key, su.asc, su.ascq, ocs);
+		return EIO;
+	}
+	if (ocs || ucd->resp[0] != 0x21 || ucd->resp[6] || ucd->resp[7]) {
+		printf("Y2S UFS: command 0x%02x failed: ocs 0x%x upiu 0x%x response 0x%x status 0x%x\n",
+		    cdb[0], ocs, ucd->resp[0], ucd->resp[6], ucd->resp[7]);
+		return EIO;
+	}
+	return 0;
+}
+
+/*
+ * ufs_scsi_once, and if the host never processed the command (descriptor and
+ * response untouched), report the host state and restart the request list
+ * once, then retry.
+ */
+static int
+ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
+{
+	int error = ufs_scsi_once(cdb, cdb_len, len, write);
+	if (!error || !su.last_unprocessed) {
+		return error;
+	}
+	printf("Y2S UFS: unprocessed: rang %d IS 0x%x HCS 0x%x HCE 0x%x RSR 0x%x DBR 0x%x AHIT 0x%x LBA 0x%x\n",
+	    su.last_rang, su.last_is, ufs_rd(REG_HCS), ufs_rd(REG_HCE), ufs_rd(REG_UTRLRSR),
+	    ufs_rd(REG_UTRLDBR), ufs_rd(REG_AHIT), ufs_rd(REG_UTRLBA));
+	if (ufs_take_over_host() == 0) {
+		error = ufs_scsi_once(cdb, cdb_len, len, write);
+		printf("Y2S UFS: request list restarted, retry: %d\n", error);
+	}
+	return error;
+}
+
+/* READ(10) of count device blocks at lba into the bounce buffer. */
+static int
+ufs_read_blocks(uint64_t lba, uint32_t count)
+{
+	if (lba > UINT32_MAX || count > BOUNCE_SIZE / UFS_BLOCK) {
+		return EINVAL;
+	}
+	uint8_t cdb[10] = {
+		0x28, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, false);
+}
+
+/*
+ * WRITE(10) of count device blocks from the bounce buffer to lba. The range
+ * must lie inside the partition: this is the only place data goes out.
+ */
+static int
+ufs_write_blocks(uint64_t lba, uint32_t count)
+{
+	if (!su.writable || !su.nblocks || count == 0 || count > BOUNCE_SIZE / UFS_BLOCK ||
+	    lba < su.first_block || lba - su.first_block >= su.nblocks ||
+	    count > su.nblocks - (lba - su.first_block) || lba + count - 1 > UINT32_MAX) {
+		printf("Y2S UFS: refusing write of %u blocks at 0x%llx\n", count, lba);
+		return EPERM;
+	}
+	uint8_t cdb[10] = {
+		0x2a, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, true);
+}
+
+static int
+ufs_sync_cache(void)
+{
+	static const uint8_t cdb[10] = { 0x35 };       /* SYNCHRONIZE CACHE(10), whole LUN */
+	return ufs_scsi(cdb, sizeof(cdb), 0, false);
+}
+
+static int
+ufs_find_partition(const char *want)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	int error = ufs_read_blocks(1, 1);
+	if (error) {
+		return error;
+	}
+	if (memcmp(b, "EFI PART", 8) != 0) {
+		printf("Y2S UFS: LUN %u has no GPT\n", su.lun);
+		return ENXIO;
+	}
+	uint64_t entry_lba;
+	uint32_t nent, esz;
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	if (esz != 128 || nent == 0 || nent * esz > BOUNCE_SIZE) {
+		printf("Y2S UFS: unsupported GPT entries %u x %u\n", nent, esz);
+		return ENXIO;
+	}
+	error = ufs_read_blocks(entry_lba, (nent * esz + UFS_BLOCK - 1) / UFS_BLOCK);
+	if (error) {
+		return error;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		char name[37];
+		unsigned c;
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		if (strcmp(name, want) != 0) {
+			continue;
+		}
+		uint64_t first, last;
+		memcpy(&first, e + 32, 8);
+		memcpy(&last, e + 40, 8);
+		if (last < first) {
+			return ENXIO;
+		}
+		su.first_block = first;
+		su.nblocks = last - first + 1;
+		return 0;
+	}
+	printf("Y2S UFS: no GPT partition named \"%s\"\n", want);
+	return ENOENT;
+}
+
+static uint64_t
+ufs_smc(uint64_t fn, uint64_t a1, uint64_t a2, uint64_t a3)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "memory");
+	return x0;
+}
+
+/*
+ * Exynos: the descriptor format Linux uses (ufs-exynos.c exynos_ufs_init_host
+ * and exynos_fmp_sec_cfg). The host itself is not reset: S-Boot left the
+ * link up after loading boot.img from it.
+ */
+static int
+ufs_exynos_setup(void)
+{
+	uint64_t fmp = ufs_smc(SMC_CMD_FMP_SECURITY, 0, 0 /* fmp-id */, FMP_CFG_DESCTYPE_3);
+	uint64_t smu = ufs_smc(SMC_CMD_SMU, SMU_INIT, 0 /* smu-id */, 0);
+	/* Keep the link out of auto-hibernate while idle (we poll, no H8 handling). */
+	uint32_t ahit = ufs_rd(REG_AHIT);
+	if (ahit) {
+		ufs_wr(REG_AHIT, 0);
+	}
+	printf("Y2S UFS: AHIT was 0x%x, now 0x%x; HCS 0x%x\n", ahit, ufs_rd(REG_AHIT), ufs_rd(REG_HCS));
+	uint32_t tx = *(volatile uint32_t *)(su.vs_regs + VS_TXPRDT_ENTRY_SIZE);
+	uint32_t rx = *(volatile uint32_t *)(su.vs_regs + VS_RXPRDT_ENTRY_SIZE);
+	*(volatile uint32_t *)(su.vs_regs + VS_TXPRDT_ENTRY_SIZE) = VS_PRDT_PREFETCH_EN | VS_PRDT_SET_SIZE(12);
+	*(volatile uint32_t *)(su.vs_regs + VS_RXPRDT_ENTRY_SIZE) = VS_PRDT_SET_SIZE(12);
+	__builtin_arm_dsb(0xf);
+	printf("Y2S UFS: Exynos host: FMP_SECURITY %lld, SMU_INIT %lld, PRDT size tx 0x%x rx 0x%x (were 0x%x 0x%x)\n",
+	    (long long)fmp, (long long)smu,
+	    *(volatile uint32_t *)(su.vs_regs + VS_TXPRDT_ENTRY_SIZE),
+	    *(volatile uint32_t *)(su.vs_regs + VS_RXPRDT_ENTRY_SIZE), tx, rx);
+	if (fmp != 0 || smu != 0) {
+		return EIO;
+	}
+	return 0;
+}
+
+/*
+ * Get LUN 0 to answer TEST UNIT READY. A pending unit attention (sense key 6)
+ * is consumed by reporting it, so just retry. NOT READY (key 2), e.g. when
+ * the bootloader left the device in a low-power mode, needs START STOP UNIT
+ * (power condition ACTIVE) to the UFS Device W-LUN, as Linux sends at boot
+ * (ufshcd_set_dev_pwr_mode); the W-LUN may itself report a unit attention
+ * first, which REQUEST SENSE clears.
+ */
+static int
+ufs_wake_device(void)
+{
+	static const uint8_t tur[6] = { 0x00 };
+	static const uint8_t request_sense[6] = { 0x03, 0, 0, 0, 18, 0 };
+	static const uint8_t ssu_active[6] = { 0x1b, 0, 0, 0, 0x10, 0 };
+	int error = EIO;
+
+	for (int i = 0; i < 8; i++) {
+		su.target_lun = su.lun;
+		error = ufs_scsi(tur, sizeof(tur), 0, false);
+		if (!error) {
+			if (i) {
+				printf("Y2S UFS: LUN %u ready after %d tries\n", su.lun, i + 1);
+			}
+			return 0;
+		}
+		if (su.sense_key == 0x6) {
+			continue;               /* unit attention: reported now, cleared */
+		}
+		if (su.sense_key != 0x2) {
+			return error;
+		}
+		/* NOT READY: wake the device through the UFS Device W-LUN. */
+		su.target_lun = UFS_WLUN_DEVICE;
+		(void)ufs_scsi(request_sense, sizeof(request_sense), 18, false);
+		int ssu = ufs_scsi(ssu_active, sizeof(ssu_active), 0, false);
+		if (ssu) {
+			(void)ufs_scsi(request_sense, sizeof(request_sense), 18, false);
+			ssu = ufs_scsi(ssu_active, sizeof(ssu_active), 0, false);
+		}
+		printf("Y2S UFS: START STOP UNIT (active) to W-LUN 0x%x: %d\n", UFS_WLUN_DEVICE, ssu);
+		su.target_lun = su.lun;
+		delay(20000);                   /* 20 ms */
+	}
+	return error;
+}
+
+static int
+ufs_take_over_host(void)
+{
+	uint32_t hce = ufs_rd(REG_HCE), hcs = ufs_rd(REG_HCS);
+	if (!(hce & 1) || !(hcs & HCS_DP) || !(hcs & HCS_UTRLRDY)) {
+		printf("Y2S UFS: host not ready (hce 0x%x hcs 0x%x)\n", hce, hcs);
+		return ENXIO;
+	}
+	if (ufs_rd(REG_UTRLDBR)) {
+		printf("Y2S UFS: requests outstanding from the bootloader\n");
+		return EBUSY;
+	}
+	/* With RAM above 4 GiB (mkadt.py --highmem) the DMA memory can be there too. */
+	if (((su.dma_pa + DMA_SIZE - 1) >> 32) && !(ufs_rd(REG_CAP) & CAP_64AS)) {
+		printf("Y2S UFS: DMA memory at 0x%llx but the host has no 64-bit addressing\n",
+		    su.dma_pa);
+		return ENXIO;
+	}
+	ufs_wr(REG_IE, 0);                      /* polled operation */
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	ufs_wr(REG_UTRLRSR, 0);
+	uint64_t list = su.dma_pa + DMA_UTRL;
+	ufs_wr(REG_UTRLBA, (uint32_t)list);
+	ufs_wr(REG_UTRLBAU, (uint32_t)(list >> 32));
+	ufs_wr(REG_UTRLRSR, 1);
+	/* Never ring a doorbell unless the host uses our list. */
+	if (ufs_rd(REG_UTRLBA) != (uint32_t)list || ufs_rd(REG_UTRLBAU) != (uint32_t)(list >> 32) ||
+	    !(ufs_rd(REG_UTRLRSR) & 1)) {
+		printf("Y2S UFS: host did not take our request list\n");
+		return EIO;
+	}
+	return 0;
+}
+
+static int
+y2s_ufs_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!su.ready) {
+		return ENXIO;
+	}
+	return ((flags & FWRITE) && !su.writable) ? EROFS : 0;
+}
+
+static int
+y2s_ufs_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+y2s_ufs_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * su.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = su.nblocks * UFS_BLOCK;
+
+	bool rd = buf_flags(bp) & B_READ;
+
+	buf_setresid(bp, count);
+	if (!rd && !su.writable) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > part_bytes || count > part_bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+
+	lck_mtx_lock(&y2s_ufs_lock);
+	for (uint32_t done = 0; done < count;) {
+		uint64_t pos = off + done;
+		uint64_t lba = pos / UFS_BLOCK;
+		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+		uint32_t want = MIN(count - done, BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
+		void *bounce = (void *)(su.dma + DMA_BOUNCE);
+		if (rd) {
+			error = ufs_read_blocks(su.first_block + lba, blocks);
+			if (!error) {
+				memcpy(vaddr + done, (const char *)bounce + skip, want);
+			}
+		} else {
+			/* Partial device blocks at either end: read, merge, write back. */
+			if (skip || (want % UFS_BLOCK)) {
+				error = ufs_read_blocks(su.first_block + lba, blocks);
+			}
+			if (!error) {
+				memcpy((char *)bounce + skip, vaddr + done, want);
+				error = ufs_write_blocks(su.first_block + lba, blocks);
+			}
+		}
+		if (error) {
+			break;
+		}
+		done += want;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(&y2s_ufs_lock);
+	buf_unmap(bp);
+
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+y2s_ufs_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = su.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > UFS_BLOCK || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		su.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = UFS_BLOCK;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = su.nblocks * UFS_BLOCK / su.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = su.writable;
+		return 0;
+	case DKIOCSYNCHRONIZE:
+	case DKIOCSYNCHRONIZECACHE: {
+		if (!su.writable) {
+			return 0;
+		}
+		lck_mtx_lock(&y2s_ufs_lock);
+		int error = ufs_sync_cache();
+		lck_mtx_unlock(&y2s_ufs_lock);
+		return error;
+	}
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = BOUNCE_SIZE / su.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = su.writable ? BOUNCE_SIZE / su.secsize : 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+y2s_ufs_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return y2s_ufs_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+y2s_ufs_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return y2s_ufs_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+y2s_ufs_psize(__unused dev_t dev)
+{
+	return su.ready ? (int)MIN(su.nblocks * UFS_BLOCK / su.secsize, INT_MAX) : -1;
+}
+
+static int
+y2s_ufs_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(y2s_ufs_strategy, NULL, dev, B_READ, minphys, uio, (int)su.secsize);
+}
+
+static int
+y2s_ufs_write(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	if (!su.writable) {
+		return EROFS;
+	}
+	return physio(y2s_ufs_strategy, NULL, dev, B_WRITE, minphys, uio, (int)su.secsize);
+}
+
+static const struct bdevsw y2s_ufs_bdevsw = {
+	.d_open     = y2s_ufs_open,
+	.d_close    = y2s_ufs_close,
+	.d_strategy = y2s_ufs_strategy,
+	.d_ioctl    = y2s_ufs_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = y2s_ufs_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw y2s_ufs_cdevsw = {
+	.d_open       = y2s_ufs_open,
+	.d_close      = y2s_ufs_close,
+	.d_read       = y2s_ufs_read,
+	.d_write      = y2s_ufs_write,
+	.d_ioctl      = y2s_ufs_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+static int
+y2s_ufs_init(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	char want[64] = "userdata";
+	int error;
+
+	if (SecureDTLookupEntry(NULL, "/y2s-ufs", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		printf("Y2S UFS: no /y2s-ufs node in the device tree\n");
+		return ENXIO;
+	}
+	char const *compat = NULL;
+	unsigned int compat_size = 0;
+	su.exynos = SecureDTGetProperty(node, "compatible", (void const **)&compat, &compat_size) == kSuccess &&
+	    compat_size >= sizeof("samsung,exynos-ufs") &&
+	    strncmp(compat, "samsung,exynos-ufs", sizeof("samsung,exynos-ufs")) == 0;
+	su.prd_size = su.exynos ? PRD_SIZE_EXYNOS : PRD_SIZE_STD;
+	if (su.exynos) {
+		/* reg = <HCI base, size, vendor HCI base, size> */
+		if (size < 4 * sizeof(uintptr_t)) {
+			printf("Y2S UFS: Exynos node needs the vendor HCI region\n");
+			return ENXIO;
+		}
+		su.vs_regs = ml_io_map(reg[2], reg[3]);
+	}
+	PE_parse_boot_argn("ufsroot", want, sizeof(want));
+	uint32_t rw = 0;
+	PE_parse_boot_argn("ufsrw", &rw, sizeof(rw));
+	uint32_t cache = 0, wait = 0;
+	PE_parse_boot_argn("ufscache", &cache, sizeof(cache));
+	PE_parse_boot_argn("ufswait", &wait, sizeof(wait));
+	su.cache = (cache == 1);
+	su.wait = (wait == 1);
+
+	su.regs = ml_io_map(reg[0], reg[1]);
+	if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("Y2S UFS: no contiguous DMA memory\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)su.dma);
+	if (!pn) {
+		return ENOMEM;
+	}
+	su.dma_pa = ptoa_64(pn);
+	su.lun = 0;
+	su.target_lun = 0;
+	su.secsize = DEV_BSIZE;
+
+	lck_mtx_lock(&y2s_ufs_lock);
+	error = su.exynos ? ufs_exynos_setup() : 0;
+	if (!error) {
+		error = ufs_take_over_host();
+	}
+	if (!error) {
+		error = ufs_wake_device();
+	}
+	if (!error) {
+		error = ufs_find_partition(want);
+	}
+	lck_mtx_unlock(&y2s_ufs_lock);
+	if (error) {
+		return error;
+	}
+
+	su.bmajor = bdevsw_add(-1, &y2s_ufs_bdevsw);
+	if (su.bmajor < 0) {
+		return ENXIO;
+	}
+	su.cmajor = cdevsw_add_with_bdev(-1, &y2s_ufs_cdevsw, su.bmajor);
+	if (su.cmajor < 0) {
+		return ENXIO;
+	}
+	su.bdev = makedev(su.bmajor, 0);
+	devfs_make_node(su.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "ufsroot0");
+	devfs_make_node(makedev(su.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rufsroot0");
+	/* Only now, with the partition bounds known, can writes be allowed. */
+	su.writable = (rw != 0);
+	su.ready = true;
+	printf("Y2S UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, %s, DMA at 0x%llx\n",
+	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20,
+	    su.writable ? "read-write" : "read-only", su.dma_pa);
+	y2s_log_start();
+	y2s_sample_start();
+	/* Input drivers (HID services in iokit/Kernel/arm/hid/Y2SHID.cpp). */
+	if (!su.exynos) {
+		y2s_keys_init();
+		y2s_touch_init();
+		y2s_usb_probe();
+	} else {
+		y2s_acpm_init();        /* Galaxy S20+ boot cluster clock via ACPM */
+		y2s_sects_init();       /* Galaxy S20+ sec_ts */
+	}
+	return 0;
+}
+
+/*
+ * Persistent console log ("y2slog"). Filming the phone screen is the only
+ * other way to see the console, so every character that reaches the
+ * console (kernel printf and /dev/console writes of daemons, both through
+ * _cnputs) is also kept in a 4 MiB ring, and once the partition is known
+ * and writable a thread copies new ring blocks to the LAST 4 MiB + 4 KiB of
+ * the partition every ufslogsecs seconds (default 10), far behind the HFS
+ * image at its start. Device block 0 of that area is a header:
+ *   "Y2SLOG" | u32 version 1 | u32 ring size | u64 total bytes written
+ *   | u64 flush sequence
+ * ring offset of byte n = n % ring size. Read it from a recovery with
+ * tools/y2s-log-pull.sh. Disabled with boot-arg y2slog=0.
+ */
+#define Y2S_LOG_SIZE          (4u << 20)
+#define Y2S_LOG_BLOCKS        (1 + Y2S_LOG_SIZE / UFS_BLOCK)
+#define Y2S_LOG_SECS          10u
+
+static char y2s_log_ring[Y2S_LOG_SIZE];
+static uint64_t _Atomic y2s_log_total;
+static int y2s_log_chan;
+static uint32_t y2s_log_secs = Y2S_LOG_SECS;
+
+/* Called for all console output, any context: never blocks. */
+void y2s_log_append(const char *c, int size);
+
+void
+y2s_log_append(const char *c, int size)
+{
+	if (size <= 0) {
+		return;
+	}
+	uint64_t at = os_atomic_add_orig(&y2s_log_total, (uint64_t)size, relaxed);
+	for (int i = 0; i < size; i++) {
+		y2s_log_ring[(at + (uint64_t)i) % Y2S_LOG_SIZE] = c[i];
+	}
+}
+
+/*
+ * Copy console bytes [*pos, total) (at most max) for live log streaming
+ * (y2s_usb.c). A reader that fell more than the ring behind skips ahead.
+ * Returns the byte count; *pos advances.
+ */
+uint32_t y2s_log_copy(uint64_t *pos, char *out, uint32_t max);
+
+uint32_t
+y2s_log_copy(uint64_t *pos, char *out, uint32_t max)
+{
+	uint64_t total = os_atomic_load(&y2s_log_total, relaxed);
+	if (total - *pos > Y2S_LOG_SIZE) {
+		*pos = total - Y2S_LOG_SIZE;
+	}
+	uint32_t n = (uint32_t)MIN((uint64_t)max, total - *pos);
+	for (uint32_t i = 0; i < n; i++) {
+		out[i] = y2s_log_ring[(*pos + i) % Y2S_LOG_SIZE];
+	}
+	*pos += n;
+	return n;
+}
+
+uint64_t y2s_log_position(void);
+
+uint64_t
+y2s_log_position(void)
+{
+	return os_atomic_load(&y2s_log_total, relaxed);
+}
+
+struct y2s_log_header {
+	char magic[8];
+	uint32_t version, size;
+	uint64_t total, seq;
+};
+
+static void
+y2s_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t base = su.first_block + su.nblocks - Y2S_LOG_BLOCKS;
+	uint64_t flushed = 0, seq = 0;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+
+	printf("Y2S LOG: console log to the last %u KiB of the partition (block 0x%llx)\n",
+	    Y2S_LOG_BLOCKS * UFS_BLOCK >> 10, base);
+	for (;;) {
+		(void)tsleep(&y2s_log_chan, PZERO, "y2slog", hz * (int)y2s_log_secs);
+		uint64_t total = os_atomic_load(&y2s_log_total, relaxed);
+		if (total == flushed) {
+			continue;
+		}
+		uint64_t pos = total - flushed >= Y2S_LOG_SIZE ? total - Y2S_LOG_SIZE : flushed;
+		int error = 0;
+
+		lck_mtx_lock(&y2s_ufs_lock);
+		while (pos < total && !error) {
+			uint32_t off = (uint32_t)(pos % Y2S_LOG_SIZE);
+			uint32_t blk = off / UFS_BLOCK;
+			uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+			uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(Y2S_LOG_SIZE / UFS_BLOCK - blk)),
+			    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+			memcpy(bounce, y2s_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+			error = ufs_write_blocks(base + 1 + blk, n);
+			pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+		}
+		if (!error) {
+			struct y2s_log_header h = {
+				.magic = { 'Y', '2', 'S', 'L', 'O', 'G', '\0', '\0' },
+				.version = 1, .size = Y2S_LOG_SIZE, .total = total, .seq = ++seq,
+			};
+			bzero(bounce, UFS_BLOCK);
+			memcpy(bounce, &h, sizeof(h));
+			error = ufs_write_blocks(base, 1);
+		}
+		if (!error) {
+			error = ufs_sync_cache();
+		}
+		lck_mtx_unlock(&y2s_ufs_lock);
+		if (error) {
+			printf("Y2S LOG: write failed (%d), stopping\n", error);
+			return;
+		}
+		flushed = total;
+	}
+}
+
+static void
+y2s_log_start(void)
+{
+	uint32_t on = 1;
+	thread_t thread;
+
+	PE_parse_boot_argn("y2slog", &on, sizeof(on));
+	if (!on || !su.writable || su.nblocks < 2 * Y2S_LOG_BLOCKS) {
+		return;
+	}
+	PE_parse_boot_argn("ufslogsecs", &y2s_log_secs, sizeof(y2s_log_secs));
+	if (y2s_log_secs == 0 || y2s_log_secs > 60) {
+		y2s_log_secs = Y2S_LOG_SECS;
+	}
+	if (kernel_thread_start(y2s_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+/* Root device for rd=ufsroot0 (IOFindBSDRoot). */
+int y2s_ufs_rootdev(dev_t *dev);
+
+int
+y2s_ufs_rootdev(dev_t *dev)
+{
+	if (!su.ready) {
+		int error = y2s_ufs_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = su.bdev;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_Y2S */
diff --git a/bsd/dev/y2s_usb.c b/bsd/dev/y2s_usb.c
new file mode 100644
index 0000000..e822f94
--- /dev/null
+++ b/bsd/dev/y2s_usb.c
@@ -0,0 +1,931 @@
+/*
+ * Y2S: USB bring-up, step 1 - read-only state probe.
+ *
+ * The phone's USB is a Synopsys DWC3 (USB 2.0 only, maximum-speed
+ * high-speed) at 0x0a600000 behind Qualcomm's dwc-usb3-msm wrapper, with a
+ * QUSB2 PHY at 0x088e2000; its power domain is the USB30_PRIM GDSC and its
+ * clocks come from GCC (offsets from Linux gcc-sdmmagpie.c). ABL uses this
+ * controller for fastboot; this probe only reports what state it is left
+ * in after `fastboot boot`. It never writes a register, and it touches the
+ * DWC3 / PHY register blocks only when the GCC status registers say their
+ * power domain and clocks are on (an access to a gated block would hang).
+ */
+#if defined(ARM64_BOARD_CONFIG_Y2S)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <pexpert/pexpert.h>
+#include <kern/locks.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/kpi_socket.h>
+#include <sys/sockio.h>
+#include <net/if.h>
+#include <net/if_types.h>
+#include <net/ethernet.h>
+#include <net/if_ether.h>
+#include <net/ether_if_module.h>
+#include <net/kpi_interface.h>
+#include <net/kpi_protocol.h>
+#include <netinet/in.h>
+#include <net/if_media.h>
+#include <net/dlil.h>
+#include <sys/kern_event.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void y2s_usb_probe(void);
+static void y2s_usb_gadget_start(vm_offset_t dwc);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+
+#define GCC_PA                  0x00100000
+#define GCC_SIZE                0x00090000
+#define GCC_USB30_PRIM_GDSCR    0x0f004         /* bit 31: power on */
+#define CBCR_CLK_OFF            (1u << 31)
+
+static const struct {
+	const char *name;
+	uint32_t    off;
+} usb_cbcr[] = {
+	{ "master", 0x0f010 },
+	{ "sleep", 0x0f014 },
+	{ "utmi", 0x0f018 },
+	{ "cfg-noc-axi", 0x0502c },
+	{ "aggre-axi", 0x8201c },
+	{ "ahb2phy", 0x6a004 },
+	{ "clkref", 0x8c010 },
+};
+
+#define DWC3_PA                 0x0a600000
+#define DWC3_SIZE               0x0000d000
+#define QUSB2_PA                0x088e2000
+#define QUSB2_SIZE              0x00000400
+
+static uint32_t
+usb_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+void
+y2s_usb_probe(void)
+{
+	int enabled = 1;
+	uint32_t gdscr, cbcr[sizeof(usb_cbcr) / sizeof(usb_cbcr[0])];
+	bool clocks_on = true;
+
+	/* y2susb=0 off, 1 (default) report state only, 2 also start the USB device */
+	PE_parse_boot_argn("y2susb", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	vm_offset_t gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	if (gcc == 0) {
+		printf("Y2S USB: GCC map failed\n");
+		return;
+	}
+	gdscr = usb_rd(gcc, GCC_USB30_PRIM_GDSCR);
+	printf("Y2S USB: GDSC usb30_prim 0x%08x (%s)\n", gdscr, (gdscr & (1u << 31)) ? "on" : "off");
+	for (unsigned i = 0; i < sizeof(usb_cbcr) / sizeof(usb_cbcr[0]); i++) {
+		cbcr[i] = usb_rd(gcc, usb_cbcr[i].off);
+		printf("Y2S USB: clk %-12s CBCR 0x%08x (%s)\n", usb_cbcr[i].name, cbcr[i],
+		    (cbcr[i] & CBCR_CLK_OFF) ? "off" : "on");
+	}
+	/* DWC3 registers need the GDSC, the master clock and the config-NoC path. */
+	clocks_on = (gdscr & (1u << 31)) && !(cbcr[0] & CBCR_CLK_OFF) && !(cbcr[3] & CBCR_CLK_OFF);
+	if (!clocks_on) {
+		printf("Y2S USB: controller unpowered or unclocked; DWC3 not read\n");
+		return;
+	}
+	vm_offset_t dwc = ml_io_map(DWC3_PA, DWC3_SIZE);
+	if (dwc == 0) {
+		printf("Y2S USB: DWC3 map failed\n");
+		return;
+	}
+	printf("Y2S USB: DWC3 GSNPSID 0x%08x GCTL 0x%08x GSTS 0x%08x GUSB2PHYCFG 0x%08x\n",
+	    usb_rd(dwc, 0xc120), usb_rd(dwc, 0xc110), usb_rd(dwc, 0xc118), usb_rd(dwc, 0xc200));
+	printf("Y2S USB: DWC3 DCFG 0x%08x DCTL 0x%08x DEVTEN 0x%08x DSTS 0x%08x DALEPENA 0x%08x\n",
+	    usb_rd(dwc, 0xc700), usb_rd(dwc, 0xc704), usb_rd(dwc, 0xc708), usb_rd(dwc, 0xc70c),
+	    usb_rd(dwc, 0xc720));
+	printf("Y2S USB: DWC3 GEVNTADR 0x%08x%08x GEVNTSIZ 0x%08x GEVNTCOUNT 0x%08x GHWPARAMS0 0x%08x\n",
+	    usb_rd(dwc, 0xc404), usb_rd(dwc, 0xc400), usb_rd(dwc, 0xc408), usb_rd(dwc, 0xc40c),
+	    usb_rd(dwc, 0xc140));
+	if (enabled >= 2) {
+		y2s_usb_gadget_start(dwc);
+	}
+	if (cbcr[5] & CBCR_CLK_OFF) {
+		printf("Y2S USB: ahb2phy clock off; QUSB2 PHY not read\n");
+		return;
+	}
+	vm_offset_t phy = ml_io_map(QUSB2_PA, QUSB2_SIZE);
+	if (phy == 0) {
+		return;
+	}
+	/* DT qcom,qusb-phy-reg-offset order (Linux phy-msm-qusb-v2.c): PORT_TUNE1 0x240,
+	 * PLL_COMMON_STATUS_ONE 0x1a0, PWR_CTRL1 0x210, INTR_CTRL 0x230,
+	 * PLL_CORE_INPUT_OVERRIDE 0x0a8, TEST1 0x254. */
+	printf("Y2S USB: QUSB2 PLL_STATUS 0x%08x PWR_CTRL1 0x%08x PORT_TUNE1 0x%08x TEST1 0x%08x\n",
+	    usb_rd(phy, 0x1a0), usb_rd(phy, 0x210), usb_rd(phy, 0x240), usb_rd(phy, 0x254));
+}
+
+/*
+ * Step 2: USB device mode with only the default control endpoint, enough
+ * for the host to enumerate the phone (boot-arg y2susb=2). ABL leaves
+ * the DWC3 powered, clocked, in device mode and halted, with the PHY set
+ * up, so only the device controller is restarted: soft reset, an event
+ * buffer in our memory, endpoint 0, run. Events are polled from a kernel
+ * thread (no interrupt), like the UFS driver. DMA is not cache coherent
+ * (DT qcom,gsi-disable-io-coherency): buffers are cleaned/invalidated.
+ * Register layout and the control-transfer state machine follow the
+ * Synopsys DWC3 databook as used by Linux drivers/usb/dwc3 (gadget.c,
+ * ep0.c).
+ */
+#define GCTL            0xc110
+#define GEVNTADRLO      0xc400
+#define GEVNTADRHI      0xc404
+#define GEVNTSIZ        0xc408
+#define GEVNTCOUNT      0xc40c
+#define DCFG            0xc700
+#define DCTL            0xc704
+#define DEVTEN          0xc708
+#define DSTS            0xc70c
+#define DALEPENA        0xc720
+#define DEPCMDPAR2(n)   (0xc800 + 0x10 * (n))
+#define DEPCMDPAR1(n)   (0xc804 + 0x10 * (n))
+#define DEPCMDPAR0(n)   (0xc808 + 0x10 * (n))
+#define DEPCMD(n)       (0xc80c + 0x10 * (n))
+
+/*
+ * Qualcomm wrapper registers ("QSCRATCH", core base + 0xf8800). The
+ * controller only connects (pull-up on D+) while it sees a valid VBUS
+ * session; Linux dwc3-qcom forces that in software when the charger
+ * reports a cable (dwc3_qcom_vbus_override_enable).
+ */
+#define QSCRATCH_PA             0x0a6f8800
+#define QSCRATCH_HS_PHY_CTRL    0x10
+#define   UTMI_OTG_VBUS_VALID   (1u << 20)
+#define   SW_SESSVLD_SEL        (1u << 28)
+#define QSCRATCH_SS_PHY_CTRL    0x30
+#define   LANE0_PWR_PRESENT     (1u << 24)
+
+#define DCTL_RUN_STOP   (1u << 31)
+#define DCTL_CSFTRST    (1u << 30)
+#define DSTS_DEVCTRLHLT (1u << 22)
+
+#define DEPCMD_SETEPCONFIG      1
+#define DEPCMD_SETTRANSFRESOURCE 2
+#define DEPCMD_SETSTALL         4
+#define DEPCMD_STARTTRANSFER    6
+#define DEPCMD_DEPSTARTCFG      9
+#define DEPCMD_CMDACT           (1u << 10)
+
+#define TRB_HWO         (1u << 0)
+#define TRB_LST         (1u << 1)
+#define TRB_ISP_IMI     (1u << 10)
+#define TRB_IOC         (1u << 11)
+#define TRBCTL_SETUP    (2u << 4)
+#define TRBCTL_STATUS2  (3u << 4)
+#define TRBCTL_STATUS3  (4u << 4)
+#define TRBCTL_DATA     (5u << 4)
+
+/* DMA area layout */
+#define UD_EVT          0x0000          /* event buffer, 4 KiB */
+#define UD_EVT_SIZE     0x1000
+#define UD_TRB_OUT      0x1000          /* ep0 OUT TRB */
+#define UD_TRB_IN       0x1010          /* ep0 IN TRB */
+#define UD_TRB_RX       0x1020          /* ep1 OUT (bulk, host -> phone) */
+#define UD_TRB_TX       0x1030          /* ep1 IN (bulk, phone -> host) */
+#define UD_TRB_INT      0x1050          /* ep2 IN (interrupt, notifications) */
+#define UD_SETUP        0x1040          /* 8-byte setup packet */
+#define UD_DATA         0x1100          /* ep0 data stage, 512 bytes */
+#define UD_NOTIFY       0x1300          /* 16-byte notification */
+#define UD_RX           0x2000          /* one received frame */
+#define UD_TX           0x2800          /* one frame to send */
+#define UD_FRAME_MAX    0x800
+#define UD_SIZE         0x4000
+
+/* Physical endpoints: 2n = OUT, 2n+1 = IN */
+#define EP_RX           2               /* 0x01 bulk OUT */
+#define EP_TX           3               /* 0x81 bulk IN */
+#define EP_INT          5               /* 0x82 interrupt IN */
+#define TRBCTL_NORMAL   (1u << 4)
+
+#define UD_TXQ          32
+
+static struct {
+	vm_offset_t dwc;
+	vm_offset_t dma;
+	uint64_t    dma_pa;
+	uint32_t    evt_pos;
+	int         sleep_chan;
+	enum { EP0_SETUP, EP0_DATA, EP0_WAIT_STATUS2, EP0_WAIT_STATUS3, EP0_STATUS } state;
+	bool        data_in;        /* data stage direction */
+	uint32_t    events;
+	bool        configured;
+	uint8_t     data_alt;       /* data interface alternate setting */
+	/* network */
+	ifnet_t     ifp;
+	lck_mtx_t  *lock;           /* TX ring and TX endpoint */
+	mbuf_t      txq[UD_TXQ];
+	unsigned    txq_head, txq_count;
+	bool        tx_busy;
+	uint64_t    rx_frames, tx_frames;
+} ud;
+
+static inline void
+dwc_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(ud.dwc + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline uint32_t
+dwc_rd(uint32_t off)
+{
+	return usb_rd(ud.dwc, off);
+}
+
+static void
+ud_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(ud.dma_pa + off), len, TRUE);
+}
+
+static void
+ud_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ud.sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static int
+ud_epcmd(unsigned ep, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2)
+{
+	dwc_wr(DEPCMDPAR0(ep), p0);
+	dwc_wr(DEPCMDPAR1(ep), p1);
+	dwc_wr(DEPCMDPAR2(ep), p2);
+	dwc_wr(DEPCMD(ep), cmd | DEPCMD_CMDACT);
+	for (int i = 0; i < 1000; i++) {
+		uint32_t v = dwc_rd(DEPCMD(ep));
+		if (!(v & DEPCMD_CMDACT)) {
+			uint32_t status = (v >> 12) & 0xf;
+			if (status) {
+				printf("Y2S USB: ep%u cmd 0x%x status %u\n", ep, cmd & 0xf, status);
+				return -1;
+			}
+			return 0;
+		}
+		delay(1);
+	}
+	printf("Y2S USB: ep%u cmd 0x%x timeout\n", ep, cmd & 0xf);
+	return -1;
+}
+
+/* One TRB (at DMA offset trb) on physical endpoint ep. */
+static void
+ud_start_trb(unsigned ep, uint32_t trb, uint32_t buf, uint32_t len, uint32_t ctl)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + trb);
+	uint64_t bpa = ud.dma_pa + buf;
+
+	t[0] = (uint32_t)bpa;
+	t[1] = (uint32_t)(bpa >> 32);
+	t[2] = len;
+	t[3] = ctl | TRB_HWO | TRB_LST | TRB_ISP_IMI | TRB_IOC;
+	ud_sync(trb, 16);
+	if (len) {
+		ud_sync(buf, len);
+	}
+	uint64_t tpa = ud.dma_pa + trb;
+	ud_epcmd(ep, DEPCMD_STARTTRANSFER, (uint32_t)(tpa >> 32), (uint32_t)tpa, 0);
+}
+
+static void
+ud_start(unsigned ep, uint32_t buf, uint32_t len, uint32_t ctl)
+{
+	ud_start_trb(ep, ep ? UD_TRB_IN : UD_TRB_OUT, buf, len, ctl);
+}
+
+static void
+ud_start_setup(void)
+{
+	ud.state = EP0_SETUP;
+	ud_start(0, UD_SETUP, 8, TRBCTL_SETUP);
+}
+
+static void
+ud_stall(void)
+{
+	ud_epcmd(0, DEPCMD_SETSTALL, 0, 0, 0);
+	ud_start_setup();
+}
+
+/*
+ * USB descriptors: a CDC-ECM (Ethernet) function, which Linux (cdc_ether)
+ * and macOS drive without extra drivers. VID 0x1209 / PID 0x0001 =
+ * pid.codes test ID, not a product.
+ */
+static const uint8_t ud_dev_desc[18] = {
+	18, 1, 0x00, 0x02, 0x02, 0x00, 0x00, 64,
+	0x09, 0x12, 0x01, 0x00, 0x00, 0x01, 1, 2, 3, 1,
+};
+static const uint8_t ud_cfg_desc[80] = {
+	9, 2, 80, 0, 2, 1, 0, 0x80, 250,                /* config: 2 interfaces, 500 mA */
+	9, 4, 0, 0, 1, 0x02, 0x06, 0x00, 0,             /* comm interface 0: CDC ECM, 1 endpoint */
+	5, 0x24, 0x00, 0x10, 0x01,                      /* header, CDC 1.10 */
+	5, 0x24, 0x06, 0, 1,                            /* union: control 0, data 1 */
+	13, 0x24, 0x0f, 4, 0, 0, 0, 0, 0xea, 0x05, 0, 0, 0, /* ethernet: MAC string 4, max segment 1514 */
+	7, 5, 0x82, 0x03, 16, 0, 9,                     /* ep 0x82 interrupt IN, 16 bytes, 2^(9-1) uframes */
+	9, 4, 1, 0, 0, 0x0a, 0x00, 0x00, 0,             /* data interface 1 alt 0: no endpoints */
+	9, 4, 1, 1, 2, 0x0a, 0x00, 0x00, 0,             /* data interface 1 alt 1: two bulk endpoints */
+	7, 5, 0x81, 0x02, 0x00, 0x02, 0,                /* ep 0x81 bulk IN, 512 */
+	7, 5, 0x01, 0x02, 0x00, 0x02, 0,                /* ep 0x01 bulk OUT, 512 */
+};
+/* The host side's MAC (ECM iMACAddress); the phone's own is ..:02 */
+static const char *const ud_strings[] = {
+	NULL, "ios-y2s", "Y2S iOS (USB Ethernet)", "0001", "02005E77EE01",
+};
+static const uint8_t ud_phone_mac[ETHER_ADDR_LEN] = { 0x02, 0x00, 0x5e, 0x77, 0xee, 0x02 };
+
+static uint32_t
+ud_string(unsigned idx, uint8_t *out)
+{
+	if (idx == 0) {
+		out[0] = 4; out[1] = 3; out[2] = 0x09; out[3] = 0x04;   /* en-US */
+		return 4;
+	}
+	if (idx >= sizeof(ud_strings) / sizeof(ud_strings[0])) {
+		return 0;
+	}
+	const char *str = ud_strings[idx];
+	uint32_t n = 2;
+	for (; *str && n < 126; str++) {
+		out[n++] = (uint8_t)*str;
+		out[n++] = 0;
+	}
+	out[0] = (uint8_t)n;
+	out[1] = 3;
+	return n;
+}
+
+static void ud_rx_arm(void);
+static void ud_tx_kick_locked(void);
+static void ud_link_event(bool up);
+
+/* NETWORK_CONNECTION notification: the host brings its link up on it. */
+static void
+ud_notify_connected(void)
+{
+	uint8_t *n = (uint8_t *)(ud.dma + UD_NOTIFY);
+	n[0] = 0xa1; n[1] = 0x00;       /* NETWORK_CONNECTION */
+	n[2] = 1; n[3] = 0;             /* connected */
+	n[4] = 0; n[5] = 0;             /* interface 0 */
+	n[6] = 0; n[7] = 0;
+	ud_start_trb(EP_INT, UD_TRB_INT, UD_NOTIFY, 8, TRBCTL_NORMAL);
+}
+
+/* SET_CONFIGURATION(1): bulk IN/OUT and the interrupt endpoint. */
+static void
+ud_configure(void)
+{
+	if (ud.configured) {
+		return;
+	}
+	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG | (2u << 16), 0, 0, 0) ||
+	    ud_epcmd(EP_RX, DEPCMD_SETEPCONFIG, (2u << 1) | (512u << 3), (1u << 8) | ((uint32_t)EP_RX << 25), 0) ||
+	    ud_epcmd(EP_RX, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(EP_TX, DEPCMD_SETEPCONFIG, (2u << 1) | (512u << 3) | (1u << 17), (1u << 8) | ((uint32_t)EP_TX << 25), 0) ||
+	    ud_epcmd(EP_TX, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(EP_INT, DEPCMD_SETEPCONFIG, (3u << 1) | (16u << 3) | (2u << 17),
+	    (1u << 8) | (8u << 16) | ((uint32_t)EP_INT << 25), 0) ||
+	    ud_epcmd(EP_INT, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("Y2S USB: data endpoints setup failed\n");
+		return;
+	}
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) | (1u << EP_RX) | (1u << EP_TX) | (1u << EP_INT));
+	ud.configured = true;
+	ud_rx_arm();
+	printf("Y2S USB: ECM endpoints configured\n");
+}
+
+static void
+ud_setup(void)
+{
+	const uint8_t *st = (const uint8_t *)(ud.dma + UD_SETUP);
+	uint8_t *data = (uint8_t *)(ud.dma + UD_DATA);
+	uint8_t type = st[0], req = st[1];
+	uint16_t value = (uint16_t)(st[2] | st[3] << 8);
+	uint16_t index = (uint16_t)(st[4] | st[5] << 8);
+	uint16_t length = (uint16_t)(st[6] | st[7] << 8);
+	uint32_t n = 0;
+	bool ok = true;
+
+	printf("Y2S USB: setup %02x %02x %04x %04x len %u\n", type, req, value, index, length);
+	ud.data_in = (type & 0x80) != 0;
+	if ((type & 0x60) == 0x20) {    /* class request (e.g. SET_ETHERNET_PACKET_FILTER) */
+		ok = (length == 0);
+	} else if ((type & 0x60) != 0) {
+		ok = false;
+	} else if (req == 6) {          /* GET_DESCRIPTOR */
+		switch (value >> 8) {
+		case 1: memcpy(data, ud_dev_desc, sizeof(ud_dev_desc)); n = sizeof(ud_dev_desc); break;
+		case 2: memcpy(data, ud_cfg_desc, sizeof(ud_cfg_desc)); n = sizeof(ud_cfg_desc); break;
+		case 3: n = ud_string(value & 0xff, data); ok = n != 0; break;
+		default: ok = false; break;
+		}
+	} else if (req == 5) {          /* SET_ADDRESS: takes effect now (DWC3 handles the timing) */
+		uint32_t dcfg = dwc_rd(DCFG) & ~(0x7fu << 3);
+		dwc_wr(DCFG, dcfg | ((uint32_t)(value & 0x7f) << 3));
+		printf("Y2S USB: address %u\n", value & 0x7f);
+	} else if (req == 9) {          /* SET_CONFIGURATION */
+		if (value == 1) {
+			ud_configure();
+		}
+		printf("Y2S USB: configured (%u)\n", value);
+	} else if (req == 8) {          /* GET_CONFIGURATION */
+		data[0] = ud.configured ? 1 : 0; n = 1;
+	} else if (req == 0) {          /* GET_STATUS */
+		data[0] = 0; data[1] = 0; n = 2;
+	} else if (req == 11) {         /* SET_INTERFACE */
+		if (index == 1) {
+			ud.data_alt = (uint8_t)value;
+			if (value == 1 && ud.configured) {
+				ud_notify_connected();
+				ud_link_event(true);
+			}
+		}
+	} else if (req == 10) {         /* GET_INTERFACE */
+		data[0] = index == 1 ? ud.data_alt : 0; n = 1;
+	} else if (req == 1 || req == 3) { /* CLEAR/SET_FEATURE (halt, remote wakeup) */
+	} else {
+		ok = false;
+	}
+	if (!ok) {
+		ud_stall();
+		return;
+	}
+	if (length == 0) {
+		ud.state = EP0_WAIT_STATUS2;    /* status stage on XferNotReady */
+		return;
+	}
+	ud.state = EP0_DATA;
+	if (ud.data_in) {
+		if (n > length) {
+			n = length;
+		}
+		ud_start(1, UD_DATA, n, TRBCTL_DATA);
+	} else {
+		ud_start(0, UD_DATA, 64, TRBCTL_DATA);  /* OUT data is not used here */
+	}
+}
+
+/* ---- network interface (ue0) ---- */
+
+static void
+ud_rx_arm(void)
+{
+	ud_start_trb(EP_RX, UD_TRB_RX, UD_RX, UD_FRAME_MAX, TRBCTL_NORMAL);
+}
+
+static void
+ud_rx_done(void)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_RX);
+	ud_sync(UD_TRB_RX, 16);
+	uint32_t len = UD_FRAME_MAX - (t[2] & 0xffffff);
+	ud_sync(UD_RX, UD_FRAME_MAX);
+	if (ud.ifp != NULL && len >= ETHER_HDR_LEN && len <= ETHER_MAX_LEN) {
+		/*
+		 * One mbuf with a 2 KiB cluster holds any frame. (mbuf_allocpacket
+		 * may return a first mbuf of length 0: stripping the header from
+		 * it panicked "Failed mbuf validity check: len -14".)
+		 */
+		mbuf_t m = NULL;
+		if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) == 0 &&
+		    mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) == 0 &&
+		    (mbuf_flags(m) & MBUF_EXT) && mbuf_maxlen(m) >= len) {
+			struct ifnet_stat_increment_param stats = {};
+			memcpy(mbuf_data(m), (const void *)(ud.dma + UD_RX), len);
+			mbuf_setlen(m, len);
+			mbuf_pkthdr_setlen(m, len);
+			void *frame_header = mbuf_data(m);
+			mbuf_pkthdr_setrcvif(m, ud.ifp);
+			mbuf_pkthdr_setheader(m, frame_header);
+			mbuf_pkthdr_adjustlen(m, -ETHER_HDR_LEN);
+			(void)mbuf_setdata(m, (char *)mbuf_data(m) + ETHER_HDR_LEN, mbuf_len(m) - ETHER_HDR_LEN);
+			stats.packets_in = 1;
+			stats.bytes_in = len;
+			ud.rx_frames++;
+			ifnet_input(ud.ifp, m, &stats);
+		} else if (m != NULL) {
+			mbuf_freem(m);
+		}
+	}
+	ud_rx_arm();
+}
+
+/* Start the next queued frame if the IN endpoint is idle. ud.lock held. */
+static void
+ud_tx_kick_locked(void)
+{
+	while (!ud.tx_busy && ud.txq_count > 0 && ud.configured) {
+		mbuf_t m = ud.txq[ud.txq_head];
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_count--;
+		size_t len = mbuf_pkthdr_len(m);
+		if (len > ETHER_MAX_LEN - ETHER_CRC_LEN) {
+			mbuf_freem(m);
+			continue;
+		}
+		mbuf_copydata(m, 0, len, (void *)(ud.dma + UD_TX));
+		mbuf_freem(m);
+		/* A frame of a multiple of 512 bytes would need a zero-length
+		 * packet to end it; one pad byte does the same (IP ignores it). */
+		if ((len % 512) == 0) {
+			((uint8_t *)(ud.dma + UD_TX))[len++] = 0;
+		}
+		ud.tx_busy = true;
+		ud.tx_frames++;
+		ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, (uint32_t)len, TRBCTL_NORMAL);
+	}
+}
+
+static errno_t
+ud_if_output(ifnet_t ifp, mbuf_t m)
+{
+	lck_mtx_lock(ud.lock);
+	if (ud.txq_count == UD_TXQ || !ud.configured) {
+		lck_mtx_unlock(ud.lock);
+		mbuf_freem(m);
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+		return 0;
+	}
+	ifnet_stat_increment_out(ifp, 1, mbuf_pkthdr_len(m), 0);
+	ud.txq[(ud.txq_head + ud.txq_count) % UD_TXQ] = m;
+	ud.txq_count++;
+	ud_tx_kick_locked();
+	lck_mtx_unlock(ud.lock);
+	return 0;
+}
+
+/*
+ * Link state for configd (KernelEventMonitor reads SIOCGIFMEDIA and the
+ * KEV_DL_LINK_ON/OFF events; IPMonitor does not route through a service
+ * whose interface has no active link).
+ */
+static void
+ud_link_event(bool up)
+{
+	if (ud.ifp != NULL) {
+		dlil_post_msg(ud.ifp, KEV_DL_SUBCLASS, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF, NULL, 0, FALSE);
+	}
+}
+
+static errno_t
+ud_if_ioctl(ifnet_t ifp, unsigned long cmd, void *data)
+{
+	switch (cmd) {
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64: {
+		struct ifmediareq *ifmr = (struct ifmediareq *)data;
+		user_addr_t list = (cmd == SIOCGIFMEDIA64) ?
+		    ((struct ifmediareq64 *)ifmr)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)ifmr)->ifmu_ulist);
+		int media = IFM_ETHER | IFM_AUTO;
+		ifmr->ifm_current = media;
+		ifmr->ifm_active = ud.configured ? (IFM_ETHER | IFM_1000_T | IFM_FDX) : media;
+		ifmr->ifm_mask = 0;
+		ifmr->ifm_status = IFM_AVALID | (ud.configured ? IFM_ACTIVE : 0);
+		if (list != USER_ADDR_NULL && ifmr->ifm_count > 0) {
+			ifmr->ifm_count = 1;
+			return copyout(&media, list, sizeof(media));
+		}
+		ifmr->ifm_count = 1;
+		return 0;
+	}
+	case SIOCSIFADDR:
+	case SIOCAIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		return 0;
+	case SIOCSIFFLAGS:
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		return 0;
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+static void
+ud_if_detach(ifnet_t ifp __unused)
+{
+}
+
+/* ue0, 192.168.7.2/24 (the host side is 192.168.7.1). */
+static void
+ud_if_create(void)
+{
+	struct ifnet_init_eparams init;
+	static lck_grp_t *grp;
+
+	grp = lck_grp_alloc_init("y2s_usb", LCK_GRP_ATTR_NULL);
+	ud.lock = lck_mtx_alloc_init(grp, LCK_ATTR_NULL);
+
+	bzero(&init, sizeof(init));
+	init.ver = IFNET_INIT_CURRENT_VERSION;
+	init.len = sizeof(init);
+	init.flags = IFNET_INIT_LEGACY;
+	init.uniqueid = "y2s-usb-ecm";
+	init.uniqueid_len = sizeof("y2s-usb-ecm") - 1;
+	init.name = "ue";
+	init.unit = 0;
+	init.family = IFNET_FAMILY_ETHERNET;
+	init.type = IFT_ETHER;
+	init.output = ud_if_output;
+	init.demux = ether_demux;
+	init.add_proto = ether_add_proto;
+	init.del_proto = ether_del_proto;
+	init.check_multi = ether_check_multi;
+	init.framer_extended = ether_frameout_extended;
+	init.ioctl = ud_if_ioctl;
+	init.detach = ud_if_detach;
+	init.broadcast_addr = etherbroadcastaddr;
+	init.broadcast_len = ETHER_ADDR_LEN;
+	if (ifnet_allocate_extended(&init, &ud.ifp) != 0) {
+		printf("Y2S USB: ifnet_allocate failed\n");
+		ud.ifp = NULL;
+		return;
+	}
+	ifnet_set_addrlen(ud.ifp, ETHER_ADDR_LEN);
+	ifnet_set_hdrlen(ud.ifp, sizeof(struct ether_header));
+	ifnet_set_mtu(ud.ifp, ETHERMTU);
+	ifnet_set_baudrate(ud.ifp, 480000000);
+	ifnet_set_flags(ud.ifp, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST, 0xffff);
+	if (ifnet_attach(ud.ifp, NULL) != 0) {
+		printf("Y2S USB: ifnet_attach failed\n");
+		ud.ifp = NULL;
+		return;
+	}
+	ifnet_set_lladdr(ud.ifp, ud_phone_mac, ETHER_ADDR_LEN);
+
+	errno_t err = proto_plumb(PF_INET, ud.ifp);
+	socket_t so = NULL;
+	if (err == 0) {
+		err = sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, &so);
+	}
+	if (err == 0) {
+		struct ifaliasreq ifra;
+		bzero(&ifra, sizeof(ifra));
+		snprintf(ifra.ifra_name, sizeof(ifra.ifra_name), "ue0");
+		struct sockaddr_in *a = (struct sockaddr_in *)&ifra.ifra_addr;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xc0a80702);         /* 192.168.7.2 */
+		a = (struct sockaddr_in *)&ifra.ifra_mask;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xffffff00);
+		a = (struct sockaddr_in *)&ifra.ifra_broadaddr;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xc0a807ff);
+		err = sock_ioctl(so, SIOCAIFADDR, &ifra);
+		sock_close(so);
+	}
+	ifnet_set_flags(ud.ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+	printf("Y2S USB: ue0 192.168.7.2/24 %s (err %d)\n", err ? "NOT configured" : "up", err);
+}
+
+static void
+ud_event(uint32_t ev)
+{
+	if (ev & 1) {                   /* device event */
+		uint32_t type = (ev >> 8) & 0xf;
+		if (type == 1) {        /* USB reset */
+			dwc_wr(DCFG, dwc_rd(DCFG) & ~(0x7fu << 3));
+			printf("Y2S USB: bus reset\n");
+		} else if (type == 2) { /* connect done */
+			uint32_t speed = dwc_rd(DSTS) & 7;
+			/* ep0 max packet: 64 at high/full speed (modify action) */
+			ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3) | (2u << 30),
+			    (1u << 8) | (1u << 10) | (0u << 25), 0);
+			ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3) | (2u << 30),
+			    (1u << 8) | (1u << 10) | (1u << 25), 0);
+			printf("Y2S USB: connected, speed %u\n", speed);
+		} else if (type == 0) {
+			printf("Y2S USB: disconnect\n");
+		}
+		return;
+	}
+	unsigned ep = (ev >> 1) & 0x1f;
+	unsigned type = (ev >> 6) & 0xf;
+	unsigned status = (ev >> 12) & 0xf;
+
+	if (ep == EP_RX && type == 1) {
+		ud_rx_done();
+		return;
+	}
+	if (ep == EP_TX && type == 1) {
+		lck_mtx_lock(ud.lock);
+		ud.tx_busy = false;
+		ud_tx_kick_locked();
+		lck_mtx_unlock(ud.lock);
+		return;
+	}
+	if (ep > 1) {
+		return;
+	}
+	/*
+	 * Control transfer state machine (Linux dwc3 ep0.c): SETUP completes ->
+	 * request handled; the data stage (if any) is started right away; the
+	 * status stage is started when the controller reports XferNotReady
+	 * with status "control status"; its completion re-arms SETUP.
+	 */
+	if (type == 1) {                /* XferComplete */
+		switch (ud.state) {
+		case EP0_SETUP:
+			ud_sync(UD_SETUP, 8);
+			ud_setup();
+			break;
+		case EP0_DATA:
+			ud.state = EP0_WAIT_STATUS3;
+			break;
+		case EP0_STATUS:
+			ud_start_setup();
+			break;
+		default:
+			break;
+		}
+		return;
+	}
+	if (type == 3 && status == 2) { /* XferNotReady, control status phase */
+		if (ud.state == EP0_WAIT_STATUS2 || ud.state == EP0_WAIT_STATUS3) {
+			uint32_t ctl = ud.state == EP0_WAIT_STATUS3 ? TRBCTL_STATUS3 : TRBCTL_STATUS2;
+			ud.state = EP0_STATUS;
+			ud_start(ep, UD_DATA, 0, ctl);
+		}
+	}
+}
+
+static void
+ud_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t ticks = 0;
+	for (;;) {
+		uint32_t count = dwc_rd(GEVNTCOUNT) & 0xffff;
+		if (count) {
+			ud_sync(UD_EVT, UD_EVT_SIZE);
+			for (uint32_t done = 0; done < count; done += 4) {
+				uint32_t ev = *(volatile uint32_t *)(ud.dma + UD_EVT + ud.evt_pos);
+				ud.evt_pos = (ud.evt_pos + 4) % UD_EVT_SIZE;
+				if (ud.events++ < 200) {
+					printf("Y2S USB: event 0x%08x\n", ev);
+				}
+				ud_event(ev);
+			}
+			dwc_wr(GEVNTCOUNT, count);
+		}
+		if ((++ticks % 30000) == 0) {
+			printf("Y2S USB: ue0 rx %llu tx %llu frames\n", ud.rx_frames, ud.tx_frames);
+		}
+		ud_sleep_ms(1);
+	}
+}
+
+/*
+ * Live console log over USB Ethernet: every 100 ms the new bytes of the
+ * console ring (bsd/dev/y2s_ufs.c) go as UDP datagrams to
+ * 192.168.7.1:5140 (on the PC: nc -ukl 5140). Starts with the last 64 KiB
+ * so the boot is included. Nothing here may print (it would feed itself).
+ * Boot-arg y2susblog=0 disables it.
+ */
+extern uint32_t y2s_log_copy(uint64_t *pos, char *out, uint32_t max);
+extern uint64_t y2s_log_position(void);
+
+static void
+ud_log_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static char chunk[1400];
+	socket_t so = NULL;
+	struct sockaddr_in to;
+	uint64_t pos = y2s_log_position();
+
+	pos = pos > 65536 ? pos - 65536 : 0;
+	bzero(&to, sizeof(to));
+	to.sin_len = sizeof(to);
+	to.sin_family = AF_INET;
+	to.sin_port = htons(5140);
+	to.sin_addr.s_addr = htonl(0xc0a80701);         /* 192.168.7.1 */
+	for (;;) {
+		ud_sleep_ms(100);
+		if (!ud.configured) {
+			continue;
+		}
+		if (so == NULL && sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so) != 0) {
+			so = NULL;
+			continue;
+		}
+		uint32_t n;
+		while ((n = y2s_log_copy(&pos, chunk, sizeof(chunk))) > 0) {
+			struct iovec iov = { .iov_base = chunk, .iov_len = n };
+			struct msghdr msg = {
+				.msg_name = &to, .msg_namelen = sizeof(to),
+				.msg_iov = &iov, .msg_iovlen = 1,
+			};
+			size_t sent = 0;
+			if (sock_send(so, &msg, 0, &sent) != 0) {
+				break;          /* no route/ARP yet: retry later */
+			}
+		}
+	}
+}
+
+static void
+y2s_usb_gadget_start(vm_offset_t dwc)
+{
+	thread_t thread;
+
+	ud.dwc = dwc;
+	if (kmem_alloc_contig(kernel_map, &ud.dma, UD_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("Y2S USB: no DMA memory\n");
+		return;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)ud.dma);
+	if (!pn) {
+		return;
+	}
+	ud.dma_pa = ptoa_64(pn);
+	ud_if_create();
+
+	/* Device controller soft reset (PHY and global setup stay as ABL left them). */
+	dwc_wr(DCTL, DCTL_CSFTRST);
+	int i;
+	for (i = 0; i < 500 && (dwc_rd(DCTL) & DCTL_CSFTRST); i++) {
+		delay(1000);
+	}
+	printf("Y2S USB: soft reset %s after %d ms, GCTL 0x%08x DCFG 0x%08x\n",
+	    (dwc_rd(DCTL) & DCTL_CSFTRST) ? "STUCK" : "done", i, dwc_rd(GCTL), dwc_rd(DCFG));
+	if (dwc_rd(DCTL) & DCTL_CSFTRST) {
+		return;
+	}
+
+	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
+	dwc_wr(GEVNTADRHI, (uint32_t)((ud.dma_pa + UD_EVT) >> 32));
+	dwc_wr(GEVNTSIZ, (1u << 31) | UD_EVT_SIZE);     /* interrupt masked: polled */
+	dwc_wr(GEVNTCOUNT, dwc_rd(GEVNTCOUNT) & 0xffff);
+	ud.evt_pos = 0;
+
+	/* High speed, address 0 */
+	uint32_t dcfg = dwc_rd(DCFG) & ~(7u | (0x7fu << 3));
+	dwc_wr(DCFG, dcfg | 0);
+	/* Events: disconnect, USB reset, connect done */
+	dwc_wr(DEVTEN, 0x7);
+
+	/* Endpoint 0 OUT/IN: start config, control type, max packet 512 until connect done. */
+	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0) ||
+	    ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (0u << 25), 0) ||
+	    ud_epcmd(0, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (1u << 25), 0) ||
+	    ud_epcmd(1, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("Y2S USB: endpoint 0 setup failed\n");
+		return;
+	}
+	dwc_wr(DALEPENA, 0x3);
+	ud_start_setup();
+
+	vm_offset_t qs = ml_io_map(QSCRATCH_PA, 0x100);
+	if (qs != 0) {
+		uint32_t hs = usb_rd(qs, QSCRATCH_HS_PHY_CTRL), ss = usb_rd(qs, QSCRATCH_SS_PHY_CTRL);
+		printf("Y2S USB: QSCRATCH HS_PHY_CTRL 0x%08x SS_PHY_CTRL 0x%08x GENERAL_CFG 0x%08x\n",
+		    hs, ss, usb_rd(qs, 0x08));
+		*(volatile uint32_t *)(qs + QSCRATCH_HS_PHY_CTRL) = hs | UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL;
+		*(volatile uint32_t *)(qs + QSCRATCH_SS_PHY_CTRL) = ss | LANE0_PWR_PRESENT;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		printf("Y2S USB: VBUS override on: HS_PHY_CTRL 0x%08x SS_PHY_CTRL 0x%08x\n",
+		    usb_rd(qs, QSCRATCH_HS_PHY_CTRL), usb_rd(qs, QSCRATCH_SS_PHY_CTRL));
+	}
+
+	dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
+	for (i = 0; i < 500 && (dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		delay(1000);
+	}
+	printf("Y2S USB: running (DSTS 0x%08x after %d ms), DMA at 0x%llx\n", dwc_rd(DSTS), i, ud.dma_pa);
+	if (kernel_thread_start(ud_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	int livelog = 1;
+	PE_parse_boot_argn("y2susblog", &livelog, sizeof(livelog));
+	if (livelog && ud.ifp != NULL && kernel_thread_start(ud_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_Y2S */
