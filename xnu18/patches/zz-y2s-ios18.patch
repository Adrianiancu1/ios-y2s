+
+#define NX_STYLUSPROXIMITYMASK	0x00000080	/* deprecated */
+#define NX_NONCOALSESCEDMASK	0x00000100
+
+/* click state values
+ * If you have the following events in close succession, the click
+ * field has the indicated value:
+ *	
+ *  Event	Click Value	Comments
+ *  mouse-down	1		Not part of any click yet
+ *  mouse-up	1		Aha! A click!
+ *  mouse-down	2		Doing a double-click
+ *  mouse-up	2		It's finished
+ *  mouse-down	3		A triple
+ *  mouse-up	3
+ */
+
+/* Values for the character set in event.data.key.charSet */
+
+#define	NX_ASCIISET		0
+#define NX_SYMBOLSET		1
+#define	NX_DINGBATSSET		2
+
+/* tablet button masks
+ * Mask bits for the tablet barrel buttons placed in tablet.buttons.
+ * The buttons field uses adopts the following convention:
+ *
+ * Bit      Comments
+ * 0        Left Mouse Button ( kHIDUsage_Button_1 )
+ * 1        Right Mouse Button ( kHIDUsage_Button_2 )
+ * 2        Middle Mouse Button ( kHIDUsage_Button_3 )
+ * 3        4th Mouse Button ( kHIDUsage_Button_4 )
+ * ...
+ * 15       15th Mouse Button
+ *
+ * For your convenience, the following mask bits have been defined
+ * for tablet specific application:
+ */
+ 
+#define NX_TABLET_BUTTON_PENTIPMASK             0x0001
+#define NX_TABLET_BUTTON_PENLOWERSIDEMASK       0x0002
+#define NX_TABLET_BUTTON_PENUPPERSIDEMASK       0x0004
+
+
+/* tablet capability masks
+ * Mask bits for the tablet capabilities field.   Use these 
+ * masks with the capabilities field of a proximity event to 
+ * determine what fields in a Tablet Event are valid for this 
+ * device.
+ */
+#define NX_TABLET_CAPABILITY_DEVICEIDMASK           0x0001
+#define NX_TABLET_CAPABILITY_ABSXMASK               0x0002
+#define NX_TABLET_CAPABILITY_ABSYMASK               0x0004
+#define NX_TABLET_CAPABILITY_VENDOR1MASK            0x0008
+#define NX_TABLET_CAPABILITY_VENDOR2MASK            0x0010
+#define NX_TABLET_CAPABILITY_VENDOR3MASK            0x0020
+#define NX_TABLET_CAPABILITY_BUTTONSMASK            0x0040
+#define NX_TABLET_CAPABILITY_TILTXMASK              0x0080
+#define NX_TABLET_CAPABILITY_TILTYMASK              0x0100
+#define NX_TABLET_CAPABILITY_ABSZMASK               0x0200
+#define NX_TABLET_CAPABILITY_PRESSUREMASK           0x0400
+#define NX_TABLET_CAPABILITY_TANGENTIALPRESSUREMASK 0x0800
+#define NX_TABLET_CAPABILITY_ORIENTINFOMASK         0x1000
+#define NX_TABLET_CAPABILITY_ROTATIONMASK           0x2000
+
+/* proximity pointer types
+ * Value that describes the type of pointing device placed in
+ * proximity.pointerType.
+ */
+ 
+#define NX_TABLET_POINTER_UNKNOWN               0
+#define NX_TABLET_POINTER_PEN                   1
+#define NX_TABLET_POINTER_CURSOR                2
+#define NX_TABLET_POINTER_ERASER                3
+
+/* TabletPointData type: defines the tablet data for points included
+ * in mouse events created by a tablet driver.
+ */
+
+typedef struct _NXTabletPointData {
+	SInt32  x;  /* absolute x coordinate in tablet space at full tablet resolution */
+    SInt32  y;  /* absolute y coordinate in tablet space at full tablet resolution */
+	SInt32  z;  /* absolute z coordinate in tablet space at full tablet resolution */
+    UInt16  buttons;   /* one bit per button - bit 0 is first button - 1 = closed  */
+    UInt16  pressure;  /* scaled pressure value; MAX=(2^16)-1, MIN=0 */
+    struct {           /* tilt range is -((2^15)-1) to (2^15)-1 (-32767 to 32767)  */
+        SInt16 x;      /* scaled tilt x value */
+        SInt16 y;      /* scaled tilt y value */
+	} tilt;
+	UInt16  rotation;  /* Fixed-point representation of device rotation in a 10.6 format */
+	SInt16  tangentialPressure; /* tangential pressure on the device; same range as tilt */
+	UInt16  deviceID;  /* system-assigned unique device ID */
+	SInt16  vendor1;   /* vendor-defined signed 16-bit integer */
+	SInt16  vendor2;   /* vendor-defined signed 16-bit integer */
+	SInt16  vendor3;   /* vendor-defined signed 16-bit integer */
+} NXTabletPointData, *NXTabletPointDataPtr;
+
+/* TabletProximityData type: defines the tablet data for proximity
+ * events included in mouse events created by a tablet driver.
+ */
+
+typedef struct _NXTabletProximityData {
+    UInt16  vendorID;             /* vendor-defined ID - typically the USB vendor ID */
+	UInt16  tabletID;             /* vendor-defined tablet ID - typically the USB product ID */
+	UInt16  pointerID;            /* vendor-defined ID of the specific pointing device */
+	UInt16  deviceID;             /* system-assigned unique device ID */
+	UInt16  systemTabletID;       /* system-assigned unique tablet ID */
+	UInt16  vendorPointerType;    /* vendor-defined pointer type */
+	UInt32  pointerSerialNumber;  /* vendor-defined serial number */
+	UInt64  uniqueID __attribute__ ((packed));             /* vendor-defined unique ID */
+	UInt32  capabilityMask;       /* capabilities mask of the device */
+	UInt8   pointerType;          /* type of pointing device */
+	UInt8   enterProximity;       /* non-zero = entering; zero = leaving */
+	SInt16  reserved1;
+} NXTabletProximityData, *NXTabletProximityDataPtr;
+
+/* EventData type: defines the data field of an event */
+
+typedef	union {
+    struct {    /* For mouse-down and mouse-up events */
+        UInt8   subx;       /* sub-pixel position for x */
+        UInt8   suby;       /* sub-pixel position for y */
+        SInt16  eventNum;   /* unique identifier for this button */
+        SInt32  click;      /* click state of this event */
+        UInt8   pressure;   /* pressure value: 0=none, 255=full */
+        UInt8   buttonNumber;/* button generating other button event (0-31) */
+        UInt8   subType;
+        UInt8   reserved2;
+        SInt32  reserved3;
+        union {
+            NXTabletPointData      point;     /* tablet point data */
+            NXTabletProximityData  proximity; /* tablet proximity data */
+        } tablet;
+    } mouse;
+    struct {
+        SInt32  dx;
+        SInt32  dy;
+        UInt8   subx;
+        UInt8   suby;
+        UInt8   subType;
+        UInt8   reserved1;
+        SInt32  reserved2;
+        union {
+            NXTabletPointData      point;     /* tablet point data */
+            NXTabletProximityData  proximity; /* tablet proximity data */
+        } tablet;
+    } mouseMove;
+    struct {    /* For key-down and key-up events */
+        UInt16  origCharSet;    /* unmodified character set code */
+        SInt16  repeat;         /* for key-down: nonzero if really a repeat */
+        UInt16  charSet;        /* character set code */
+        UInt16  charCode;       /* character code in that set */
+        UInt16  keyCode;        /* device-dependent key number */
+        UInt16  origCharCode;   /* unmodified character code */
+        SInt32  reserved1;
+        UInt32  keyboardType;
+        SInt32  reserved2;
+        SInt32  reserved3;
+        SInt32  reserved4;
+        SInt32  reserved5[4];
+    } key;
+    struct {    /* For mouse-entered and mouse-exited events */
+        SInt16  reserved;
+        SInt16  eventNum;       /* unique identifier from mouse down event */
+        SInt32  trackingNum;    /* unique identifier from settrackingrect */
+        SInt32  userData;       /* uninterpreted integer from settrackingrect */
+        SInt32  reserved1;
+        SInt32  reserved2;
+        SInt32  reserved3;
+        SInt32  reserved4;
+        SInt32  reserved5;
+        SInt32  reserved6[4];
+    } tracking;
+    struct {
+        SInt16  deltaAxis1;
+        SInt16  deltaAxis2;
+        SInt16  deltaAxis3;
+        SInt16  reserved1;
+        SInt32  fixedDeltaAxis1;
+        SInt32  fixedDeltaAxis2;
+        SInt32  fixedDeltaAxis3;
+        SInt32  pointDeltaAxis1;
+        SInt32  pointDeltaAxis2;
+        SInt32  pointDeltaAxis3;
+        SInt32  reserved8[4];
+    } scrollWheel, zoom;
+    struct {    /* For window-changed, sys-defined, and app-defined events */
+        SInt16  reserved;
+        SInt16  subType;    /* event subtype for compound events */
+        union {
+            float   F[11];  /* for use in compound events */
+            SInt32  L[11];  /* for use in compound events */
+            SInt16  S[22];  /* for use in compound events */
+            char    C[44];  /* for use in compound events */
+        } misc;
+    } compound;
+    struct {
+        SInt32  x;  /* absolute x coordinate in tablet space at full tablet resolution */
+        SInt32  y;  /* absolute y coordinate in tablet space at full tablet resolution */
+        SInt32  z;  /* absolute z coordinate in tablet space at full tablet resolution */
+        UInt16  buttons;   /* one bit per button - bit 0 is first button - 1 = closed  */
+        UInt16  pressure;  /* scaled pressure value; MAX=(2^16)-1, MIN=0 */
+        struct {           /* tilt range is -((2^15)-1) to (2^15)-1 (-32767 to 32767)  */
+            SInt16 x;      /* scaled tilt x value */
+            SInt16 y;      /* scaled tilt y value */
+        } tilt;
+        UInt16  rotation;  /* Fixed-point representation of device rotation in a 10.6 format */
+        SInt16  tangentialPressure; /* tangential pressure on the device; same range as tilt */
+        UInt16  deviceID;  /* system-assigned unique device ID */
+        SInt16  vendor1;   /* vendor-defined signed 16-bit integer */
+        SInt16  vendor2;   /* vendor-defined signed 16-bit integer */
+        SInt16  vendor3;   /* vendor-defined signed 16-bit integer */
+        SInt32  reserved[4];
+    } tablet;
+    struct {
+        UInt16  vendorID;  /* vendor-defined ID - typically the USB vendor ID */
+        UInt16  tabletID;  /* vendor-defined tablet ID - typically the USB product ID */
+        UInt16  pointerID; /* vendor-defined ID of the specific pointing device */
+        UInt16  deviceID;             /* system-assigned unique device ID */
+        UInt16  systemTabletID;       /* system-assigned unique tablet ID */
+        UInt16  vendorPointerType;    /* vendor-defined pointer type */
+        UInt32  pointerSerialNumber;  /* vendor-defined serial number */
+        UInt64  uniqueID __attribute__ ((packed));             /* vendor-defined unique ID */
+        UInt32  capabilityMask;       /* capabilities mask of the device */
+        UInt8   pointerType;          /* type of pointing device */
+        UInt8   enterProximity;       /* non-zero = entering; zero = leaving */
+        SInt16  reserved1;
+        SInt32  reserved2[4];
+    } proximity;
+} NXEventData;
+
+/* The current version number of the NXEventData structure. */
+
+#define kNXEventDataVersion		2
+
+/* Finally! The event record! */
+#ifndef __ppc__
+typedef struct _NXEvent {
+	SInt32              type;		/* An event type from above */
+    struct {
+        SInt32	x, y;					/* Base coordinates in window, */
+    } 					location;	/* from bottom left */
+    UInt64              time __attribute__ ((packed));		/* time since launch */
+    SInt32              flags;		/* key state flags */
+    UInt32              window;		/* window number of assigned window */
+    UInt64              service_id __attribute__ ((packed)); /* service id */
+    SInt32              ext_pid;    /* external pid */
+    NXEventData			data;		/* type-dependent data */
+} NXEvent, *NXEventPtr;
+
+#else
+
+typedef struct _NXEvent {
+	SInt32              type;		/* An event type from above */
+    struct {
+        SInt32	x, y;					/* Base coordinates in window, */
+    } 					location;	/* from bottom left */
+    UInt64              time __attribute__ ((packed));		/* time since launch */
+    SInt32              flags;		/* key state flags */
+    UInt32              window;		/* window number of assigned window */
+    NXEventData			data;		/* type-dependent data */
+    UInt64              service_id __attribute__ ((packed)); /* service id */
+    SInt32              ext_pid;    /* external pid */
+} NXEvent, *NXEventPtr;
+
+#endif
+
+/* The current version number of the NXEvent structure. */
+
+#define kNXEventVersion		2
+
+/* How to pick window(s) for event (for PostEvent) */
+#define NX_NOWINDOW		-1
+#define NX_BYTYPE		0
+#define NX_BROADCAST		1
+#define NX_TOPWINDOW		2
+#define NX_FIRSTWINDOW		3
+#define NX_MOUSEWINDOW		4
+#define NX_NEXTWINDOW		5
+#define NX_LASTLEFT		6
+#define NX_LASTRIGHT		7
+#define NX_LASTKEY		8
+#define NX_EXPLICIT		9
+#define NX_TRANSMIT		10
+#define NX_BYPSCONTEXT		11
+
+#endif /* EVENT_H */	/* End of defs common with dpsclient/event.h */
+
+/* Mask of events that cause the screen to wake up */
+#define NX_WAKEMASK     (   NX_KEYDOWNMASK | NX_FLAGSCHANGEDMASK | \
+                            NX_LMOUSEDOWNMASK | NX_LMOUSEUPMASK | \
+                            NX_RMOUSEDOWNMASK | NX_RMOUSEUPMASK | \
+                            NX_OMOUSEDOWNMASK | NX_OMOUSEUPMASK   \
+                        )
+
+/* Mask of events that cause screen to undim */
+#define NX_UNDIMMASK    (   NX_WAKEMASK | NX_KEYUPMASK | NX_SCROLLWHEELMOVEDMASK | \
+                            NX_LMOUSEDRAGGEDMASK | NX_RMOUSEDRAGGEDMASK | NX_OMOUSEDRAGGEDMASK | \
+                            NX_MOUSEMOVEDMASK | NX_MOUSEENTEREDMASK | NX_MOUSEEXITEDMASK | \
+                            NX_TABLETPOINTERMASK | NX_TABLETPROXIMITYMASK \
+                        )
+
+
+#define  NX_EVENT_EXTENSION_LOCATION_INVALID            0x1
+#define  NX_EVENT_EXTENSION_LOCATION_TYPE_FLOAT         0x2
+#define  NX_EVENT_EXTENSION_LOCATION_DEVICE_SCALED      0x4
+#define  NX_EVENT_EXTENSION_MOUSE_DELTA_TYPE_FLOAT      0x8
+#define  NX_EVENT_EXTENSION_AUDIT_TOKEN                 0x10
+
+typedef struct _NXEventExtension {
+    UInt32              flags;
+    audit_token_t       audit;
+} NXEventExtension;
+
+typedef struct _NXEventExt {
+    NXEvent             payload;
+    NXEventExtension    extension;
+} NXEventExt;
+
+#endif /* !_DEV_EVENT_H */
+
diff --git a/iokit/Kernel/arm/hid/Y2SHID.cpp b/iokit/Kernel/arm/hid/Y2SHID.cpp
new file mode 100644
index 0000000..01e6538
--- /dev/null
+++ b/iokit/Kernel/arm/hid/Y2SHID.cpp
@@ -0,0 +1,571 @@
+/*
+ * Y2S: HID event services for the iOS userland (backboardd's HID event
+ * system).
+ *
+ * backboardd watches for IOService objects with HIDServiceSupport = true,
+ * opens them with IOServiceOpen type 'esuc' (IOHIDEventServiceUserClient,
+ * compiled here from IOHIDFamily-1915.140.3, the version the iOS 16.7
+ * userland ships) and reads serialized IOHIDEvents from the user client's
+ * shared queue. This file has the minimal IOHIDEventService base class and
+ * two services:
+ *
+ *   Y2SHIDButtons  consumer-control keys (power, volume, home)
+ *   Y2SHIDTouch    the built-in touch screen (digitizer collections)
+ *
+ * Hardware drivers feed them through the C entry points y2s_hid_key()
+ * and y2s_hid_touch(). Boot-arg y2shidtest=N (seconds) presses Home
+ * every N seconds, to test the event path without input hardware.
+ */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <libkern/c++/OSArray.h>
+#include <pexpert/pexpert.h>
+
+#include "IOHIDEventService.h"
+#include "IOHIDEventServiceUserClient.h"
+#include "IOHIDEvent.h"
+#include "IOHIDKeys.h"
+#include "IOHIDPrivateKeys.h"
+#include "IOHIDUsageTables.h"
+
+extern "C" uint64_t mach_absolute_time(void);
+
+/* One open client: the user client and its event callback. */
+class IOHIDEventServiceClient : public OSObject {
+	OSDeclareDefaultStructors(IOHIDEventServiceClient);
+public:
+	bool                       initClient() { return OSObject::init(); }
+	IOService                 *client;
+	void                      *context;
+	IOHIDEventService::Action  action;
+};
+OSDefineMetaClassAndStructors(IOHIDEventServiceClient, OSObject);
+
+#define super IOService
+OSDefineMetaClassAndStructors(IOHIDEventService, IOService);
+
+bool
+IOHIDEventService::start(IOService *provider)
+{
+	if (!super::start(provider)) {
+		return false;
+	}
+	_clientLock = IOLockAlloc();
+	_clients = OSArray::withCapacity(2);
+	_hidWorkLoop = getWorkLoop();
+	if (!_clientLock || !_clients || !_hidWorkLoop) {
+		return false;
+	}
+	_hidWorkLoop->retain();
+	_hidGate = IOCommandGate::commandGate(this);
+	if (!_hidGate || _hidWorkLoop->addEventSource(_hidGate) != kIOReturnSuccess) {
+		return false;
+	}
+
+	OSString *transport = getTransport();
+	OSString *product = getProduct();
+	setProperty(kIOHIDTransportKey, transport);
+	setProperty(kIOHIDProductKey, product);
+	setProperty(kIOHIDManufacturerKey, "Y2S");
+	setProperty(kIOHIDVendorIDKey, getVendorID(), 32);
+	setProperty(kIOHIDProductIDKey, getProductID(), 32);
+	setProperty(kIOHIDLocationIDKey, (unsigned long long)getProductID(), 32);
+	setProperty(kIOHIDReportIntervalKey, getReportInterval(), 32);
+	setProperty(kIOHIDPrimaryUsagePageKey, getPrimaryUsagePage(), 32);
+	setProperty(kIOHIDPrimaryUsageKey, getPrimaryUsage(), 32);
+	setProperty(kIOHIDBuiltInKey, kOSBooleanTrue);
+	OSSafeReleaseNULL(transport);
+	OSSafeReleaseNULL(product);
+
+	OSDictionary *pair = OSDictionary::withCapacity(2);
+	OSArray *pairs = OSArray::withCapacity(1);
+	OSNumber *page = OSNumber::withNumber(getPrimaryUsagePage(), 32);
+	OSNumber *usage = OSNumber::withNumber(getPrimaryUsage(), 32);
+	if (pair && pairs && page && usage) {
+		pair->setObject(kIOHIDDeviceUsagePageKey, page);
+		pair->setObject(kIOHIDDeviceUsageKey, usage);
+		pairs->setObject(pair);
+		setProperty(kIOHIDDeviceUsagePairsKey, pairs);
+	}
+	OSSafeReleaseNULL(pair);
+	OSSafeReleaseNULL(pairs);
+	OSSafeReleaseNULL(page);
+	OSSafeReleaseNULL(usage);
+
+	/* What IOHIDFamily's "IOHIDEventServiceUserClient" personality merges in. */
+	setProperty("HIDServiceSupport", kOSBooleanTrue);
+	setProperty("IOUserClientClass", "IOHIDEventServiceUserClient");
+	return true;
+}
+
+void
+IOHIDEventService::free(void)
+{
+	if (_hidGate && _hidWorkLoop) {
+		_hidWorkLoop->removeEventSource(_hidGate);
+	}
+	OSSafeReleaseNULL(_hidGate);
+	OSSafeReleaseNULL(_hidWorkLoop);
+	OSSafeReleaseNULL(_clients);
+	if (_clientLock) {
+		IOLockFree(_clientLock);
+		_clientLock = NULL;
+	}
+	super::free();
+}
+
+bool
+IOHIDEventService::open(IOService *client, IOOptionBits options, void *context, Action action)
+{
+	IOHIDEventServiceClient *data = OSTypeAlloc(IOHIDEventServiceClient);
+	bool ok = false;
+
+	if (data && data->initClient()) {
+		data->client = client;
+		data->context = context;
+		data->action = action;
+		ok = super::open(client, options, data);
+	}
+	OSSafeReleaseNULL(data);
+	IOLog("Y2S HID: %s open by %s -> %d\n", getName(), client ? client->getName() : "?", ok);
+	return ok;
+}
+
+void
+IOHIDEventService::close(IOService *forClient, IOOptionBits options)
+{
+	super::close(forClient, options);
+}
+
+bool
+IOHIDEventService::handleOpen(IOService *client, IOOptionBits options __unused, void *argument)
+{
+	IOHIDEventServiceClient *data = OSDynamicCast(IOHIDEventServiceClient, (OSObject *)argument);
+	bool ok = false;
+
+	if (!data) {
+		return false;
+	}
+	IOLockLock(_clientLock);
+	if (!handleIsOpenLocked(client)) {
+		/* Copy on write: dispatchEvent iterates a snapshot without the lock. */
+		OSArray *next = OSArray::withArray(_clients, _clients->getCount() + 1);
+		if (next && next->setObject(data)) {
+			_clients->release();
+			_clients = next;
+			ok = true;
+		} else {
+			OSSafeReleaseNULL(next);
+		}
+	}
+	IOLockUnlock(_clientLock);
+	return ok;
+}
+
+void
+IOHIDEventService::handleClose(IOService *client, IOOptionBits options __unused)
+{
+	IOLockLock(_clientLock);
+	OSArray *next = OSArray::withCapacity(_clients->getCount());
+	if (next) {
+		for (unsigned int i = 0; i < _clients->getCount(); i++) {
+			IOHIDEventServiceClient *data = (IOHIDEventServiceClient *)_clients->getObject(i);
+			if (data->client != client) {
+				next->setObject(data);
+			}
+		}
+		_clients->release();
+		_clients = next;
+	}
+	IOLockUnlock(_clientLock);
+}
+
+bool
+IOHIDEventService::handleIsOpenLocked(const IOService *client) const
+{
+	for (unsigned int i = 0; i < _clients->getCount(); i++) {
+		IOHIDEventServiceClient *data = (IOHIDEventServiceClient *)_clients->getObject(i);
+		if (client == NULL || data->client == client) {
+			return true;
+		}
+	}
+	return false;
+}
+
+bool
+IOHIDEventService::handleIsOpen(const IOService *client) const
+{
+	IOLockLock(_clientLock);
+	bool open = handleIsOpenLocked(client);
+	IOLockUnlock(_clientLock);
+	return open;
+}
+
+void
+IOHIDEventService::dispatchEvent(IOHIDEvent *event, IOOptionBits options)
+{
+	OSArray *clients;
+
+	event->setSenderID(getRegistryEntryID());
+	IOLockLock(_clientLock);
+	clients = _clients;
+	clients->retain();
+	IOLockUnlock(_clientLock);
+
+	for (unsigned int i = 0; i < clients->getCount(); i++) {
+		IOHIDEventServiceClient *data = (IOHIDEventServiceClient *)clients->getObject(i);
+		if (data->action) {
+			(*data->action)(data->client, this, data->context, event, options);
+		}
+	}
+	clients->release();
+}
+
+IOHIDEvent *
+IOHIDEventService::copyEvent(IOHIDEventType type __unused, IOHIDEvent *matching __unused, IOOptionBits options __unused)
+{
+	return NULL;
+}
+
+IOHIDEvent *
+IOHIDEventService::copyMatchingEvent(OSDictionary *matching __unused)
+{
+	return NULL;
+}
+
+IOReturn
+IOHIDEventService::setElementValue(UInt32 usagePage __unused, UInt32 usage __unused, UInt32 value __unused)
+{
+	return kIOReturnUnsupported;
+}
+
+IOReturn
+IOHIDEventService::setProperties(OSObject *properties)
+{
+	/* The event system pushes its settings here; nothing to configure. */
+	return OSDynamicCast(OSDictionary, properties) ? kIOReturnSuccess : kIOReturnBadArgument;
+}
+
+UInt32
+IOHIDEventService::getPrimaryUsagePage()
+{
+	return 0;
+}
+
+UInt32
+IOHIDEventService::getPrimaryUsage()
+{
+	return 0;
+}
+
+OSString *
+IOHIDEventService::getTransport()
+{
+	return OSString::withCString("SPU");
+}
+
+OSString *
+IOHIDEventService::getProduct()
+{
+	return OSString::withCString(getName());
+}
+
+UInt32
+IOHIDEventService::getVendorID()
+{
+	return 0x05ac;
+}
+
+UInt32
+IOHIDEventService::getProductID()
+{
+	return 0;
+}
+
+UInt32
+IOHIDEventService::getReportInterval()
+{
+	return 10000;	/* us */
+}
+
+IOReturn
+IOHIDEventService::newUserClient(task_t owningTask, void *securityID, UInt32 type,
+    OSDictionary *properties, IOUserClient **handler)
+{
+	IOUserClient *client;
+
+	if (type != kIOHIDEventServiceUserClientType) {
+		IOLog("Y2S HID: %s user client type 0x%x unsupported\n", getName(), (unsigned)type);
+		return super::newUserClient(owningTask, securityID, type, properties, handler);
+	}
+	client = OSTypeAlloc(IOHIDEventServiceUserClient);
+	if (!client) {
+		return kIOReturnNoMemory;
+	}
+	if (!client->initWithTask(owningTask, securityID, type)) {
+		client->release();
+		IOLog("Y2S HID: %s user client init refused\n", getName());
+		return kIOReturnBadArgument;
+	}
+	if (!client->attach(this)) {
+		client->release();
+		return kIOReturnUnsupported;
+	}
+	if (!client->start(this)) {
+		client->detach(this);
+		client->release();
+		return kIOReturnUnsupported;
+	}
+	*handler = client;
+	return kIOReturnSuccess;
+}
+
+/*
+ * Buttons. iOS takes the side/volume/home buttons as consumer-control
+ * keyboard events (AppleM68Buttons publishes the same usage pair).
+ */
+class Y2SHIDButtons : public IOHIDEventService {
+	OSDeclareDefaultStructors(Y2SHIDButtons);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void key(UInt32 usage, bool down);
+protected:
+	virtual UInt32 getPrimaryUsagePage() APPLE_KEXT_OVERRIDE { return kHIDPage_Consumer; }
+	virtual UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return kHIDUsage_Csmr_ConsumerControl; }
+	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 1; }
+private:
+	static void testFired(OSObject *owner, IOTimerEventSource *sender);
+	IOTimerEventSource *fTest;
+	UInt32 fTestSecs;
+	UInt32 fTestCount;
+};
+OSDefineMetaClassAndStructors(Y2SHIDButtons, IOHIDEventService);
+
+/*
+ * Touch screen: digitizer collection events with finger children,
+ * coordinates normalized to 0..1 like IOHIDEventDriver produces for
+ * absolute digitizers.
+ */
+#define Y2S_TOUCH_FINGERS 10
+/*
+ * Contacts that start this close to a panel edge (pixels, ~3 mm) carry
+ * kIOHIDDigitizerEventFromEdgeTip for their whole life, as Apple's touch
+ * firmware reports them. UIKit derives UITouch's edge type from that bit
+ * (_UIEventHIDTouchEdgeTypeForHIDEvent); without it there is no home or
+ * app-switcher gesture.
+ */
+#define Y2S_TOUCH_EDGE_PX 48
+class Y2SHIDTouch : public IOHIDEventService {
+	OSDeclareDefaultStructors(Y2SHIDTouch);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void touch(int finger, bool down, int x, int y);
+protected:
+	virtual UInt32 getPrimaryUsagePage() APPLE_KEXT_OVERRIDE { return kHIDPage_Digitizer; }
+	virtual UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE { return kHIDUsage_Dig_TouchScreen; }
+	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 2; }
+private:
+	IOLock *fLock;
+	int fLogicalW, fLogicalH, fOffX, fOffY;
+	bool fDown[Y2S_TOUCH_FINGERS];
+	bool fEdge[Y2S_TOUCH_FINGERS];
+	IOFixed fX[Y2S_TOUCH_FINGERS];
+	IOFixed fY[Y2S_TOUCH_FINGERS];
+};
+OSDefineMetaClassAndStructors(Y2SHIDTouch, IOHIDEventService);
+
+static Y2SHIDButtons *gY2SButtons;
+static Y2SHIDTouch *gY2STouch;
+
+bool
+Y2SHIDButtons::start(IOService *provider)
+{
+	if (!IOHIDEventService::start(provider)) {
+		return false;
+	}
+	if (PE_parse_boot_argn("y2shidtest", &fTestSecs, sizeof(fTestSecs)) && fTestSecs) {
+		fTest = IOTimerEventSource::timerEventSource(this, &Y2SHIDButtons::testFired);
+		if (fTest && _hidWorkLoop->addEventSource(fTest) == kIOReturnSuccess) {
+			fTest->setTimeoutMS(fTestSecs * 1000);
+		}
+	}
+	gY2SButtons = this;
+	registerService();
+	IOLog("Y2S HID: buttons registered (test every %u s)\n", fTestSecs);
+	return true;
+}
+
+void
+Y2SHIDButtons::key(UInt32 usage, bool down)
+{
+	IOHIDEvent *event = IOHIDEvent::keyboardEvent(mach_absolute_time(), kHIDPage_Consumer, usage, down);
+
+	if (event) {
+		IOLog("Y2S HID: key 0x%x %s (%u clients)\n", (unsigned)usage, down ? "down" : "up",
+		    _clients ? _clients->getCount() : 0);
+		dispatchEvent(event);
+		event->release();
+	}
+}
+
+void
+Y2SHIDButtons::testFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	Y2SHIDButtons *self = (Y2SHIDButtons *)owner;
+
+	/*
+	 * Home (Menu) press, then the release 100 ms later; Setup's "Hello"
+	 * screen waits for it. Even counts press, odd counts release.
+	 */
+	bool press = (self->fTestCount & 1) == 0;
+	self->key(kHIDUsage_Csmr_Menu, press);
+	if (++self->fTestCount < 60) {
+		sender->setTimeoutMS(press ? 100 : self->fTestSecs * 1000);
+	}
+}
+
+bool
+Y2SHIDTouch::start(IOService *provider)
+{
+	fLock = IOLockAlloc();
+	if (!fLock || !IOHIDEventService::start(provider)) {
+		return false;
+	}
+	int native = 0;
+	PE_parse_boot_argn("y2sfb_native", &native, sizeof(native));
+	fLogicalW = native ? 1080 : 1125;
+	fLogicalH = native ? 2400 : 2436;
+	fOffX = (fLogicalW - 1080) / 2;
+	fOffY = (fLogicalH - 2400) / 2;
+	/* The digitizer covers the main display (backboardd maps it 1:1). */
+	setProperty("DisplayIntegrated", kOSBooleanTrue);
+	setProperty("SurfaceWidth", (unsigned long long)(68 << 16), 32);	/* mm, 16.16 */
+	setProperty("SurfaceHeight", (unsigned long long)(151 << 16), 32);
+	gY2STouch = this;
+	registerService();
+	IOLog("Y2S HID: touch registered\n");
+	return true;
+}
+
+/* Set by the S20 touch driver (bsd/dev/y2s_sects.c): x/y already in presented-display pixels. */
+extern "C" int y2s_touch_logical;
+int y2s_touch_logical;
+
+void
+Y2SHIDTouch::touch(int finger, bool down, int x, int y)
+{
+	uint64_t now = mach_absolute_time();
+	IOHIDEvent *collection;
+	bool any = false;
+
+	if (finger < 0 || finger >= Y2S_TOUCH_FINGERS) {
+		return;
+	}
+	int panelW = 1080, panelH = 2400, offX = fOffX, offY = fOffY;
+	if (y2s_touch_logical) {
+		panelW = (int)fLogicalW;
+		panelH = (int)fLogicalH;
+		offX = offY = 0;
+	}
+	x = x < 0 ? 0 : (x > panelW - 1 ? panelW - 1 : x);
+	y = y < 0 ? 0 : (y > panelH - 1 ? panelH - 1 : y);
+
+	IOLockLock(fLock);
+	bool was = fDown[finger];
+	/* Panel pixels -> the presented 1125x2436 display (Y2SFramebuffer.cpp). */
+	IOFixed nx = (IOFixed)(((int64_t)(x + offX) << 16) / fLogicalW);
+	IOFixed ny = (IOFixed)(((int64_t)(y + offY) << 16) / fLogicalH);
+	bool moved = down && (nx != fX[finger] || ny != fY[finger]);
+	if (was == down && !moved) {
+		IOLockUnlock(fLock);
+		return;
+	}
+	if (!was && down) {
+		fEdge[finger] = x < Y2S_TOUCH_EDGE_PX || x > panelW - 1 - Y2S_TOUCH_EDGE_PX ||
+		    y < Y2S_TOUCH_EDGE_PX || y > panelH - 1 - Y2S_TOUCH_EDGE_PX;
+	}
+
+	collection = IOHIDEvent::digitizerEvent(now, 0, kIOHIDDigitizerTransducerTypeHand, false, 0, 0, 0);
+	if (!collection) {
+		IOLockUnlock(fLock);
+		return;
+	}
+	collection->setIntegerValue(kIOHIDEventFieldDigitizerCollection, TRUE);
+
+	UInt32 cmask = 0;
+	for (int i = 0; i < Y2S_TOUCH_FINGERS; i++) {
+		bool d = (i == finger) ? down : fDown[i];
+		if (i != finger && !d) {
+			continue;
+		}
+		IOFixed fx = (i == finger && down) ? nx : fX[i];
+		IOFixed fy = (i == finger && down) ? ny : fY[i];
+		IOHIDEvent *child = IOHIDEvent::digitizerEvent(now, (UInt32)i + 2, kIOHIDDigitizerTransducerTypeFinger,
+		    d, d ? 1 : 0, fx, fy);
+		if (!child) {
+			continue;
+		}
+		UInt32 mask = fEdge[i] ? kIOHIDDigitizerEventFromEdgeTip : 0;
+		if (i == finger) {
+			if (was != down) {
+				mask |= kIOHIDDigitizerEventTouch | kIOHIDDigitizerEventRange;
+			}
+			if (moved) {
+				mask |= kIOHIDDigitizerEventPosition;
+			}
+			if (!was && down) {
+				mask |= kIOHIDDigitizerEventIdentity;
+			}
+		}
+		child->setIntegerValue(kIOHIDEventFieldDigitizerIndex, i);
+		child->setIntegerValue(kIOHIDEventFieldDigitizerIdentity, i + 2);
+		child->setIntegerValue(kIOHIDEventFieldDigitizerTouch, d);
+		child->setIntegerValue(kIOHIDEventFieldDigitizerEventMask, mask);
+		collection->appendChild(child);
+		child->release();
+		cmask |= mask;
+		any |= d;
+	}
+	fDown[finger] = down;
+	if (down) {
+		fX[finger] = nx;
+		fY[finger] = ny;
+	}
+	collection->setFixedValue(kIOHIDEventFieldDigitizerX, nx);
+	collection->setFixedValue(kIOHIDEventFieldDigitizerY, ny);
+	collection->setIntegerValue(kIOHIDEventFieldDigitizerRange, any);
+	collection->setIntegerValue(kIOHIDEventFieldDigitizerTouch, any);
+	collection->setIntegerValue(kIOHIDEventFieldDigitizerEventMask, cmask);
+	collection->setIntegerValue(kIOHIDEventFieldDigitizerButtonMask, any ? 1 : 0);
+	IOLockUnlock(fLock);
+
+	if (was != down) {
+		IOLog("Y2S HID: touch %d %s at %d,%d%s\n", finger, down ? "down" : "up", x, y,
+		    fEdge[finger] ? " edge" : "");
+	}
+	dispatchEvent(collection);
+	collection->release();
+}
+
+/* key: 0 power (side button), 1 volume up, 2 volume down, 3 home */
+extern "C" void
+y2s_hid_key(int key, int down)
+{
+	static const UInt32 usages[] = {
+		kHIDUsage_Csmr_Power, kHIDUsage_Csmr_VolumeIncrement,
+		kHIDUsage_Csmr_VolumeDecrement, kHIDUsage_Csmr_Menu,
+	};
+
+	if (gY2SButtons && key >= 0 && key < (int)(sizeof(usages) / sizeof(usages[0]))) {
+		gY2SButtons->key(usages[key], down != 0);
+	}
+}
+
+extern "C" void
+y2s_hid_touch(int finger, int down, int x, int y)
+{
+	if (gY2STouch) {
+		gY2STouch->touch(finger, down != 0, x, y);
+	}
+}
