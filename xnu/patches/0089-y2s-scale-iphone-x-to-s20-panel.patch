+/*
+ * Nearest-neighbour stretch of one layer by 32/25: panel pixel p shows
+ * logical pixel p * 25 / 32. Rows that repeat a logical row are copied
+ * from the panel row above.
+ */
+void
+AppleCLCD::presentScaled(Y2SSurface *s, uintptr_t src, uint32_t bpe, int32_t sx, int32_t sy,
+    int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	if (!fPadCleared) {
+		fPadCleared = true;
+		for (int32_t y = 0; y < (int32_t)fHeight; y++) {
+			if (y < fPadY || y >= (int32_t)fHeight - fPadY - 1) {
+				bzero((void *)(fPixels + (uint64_t)y * fRowBytes), (size_t)fWidth * 4);
+			}
+		}
+	}
+	if (src == 0 || bpe != 4 || s->elementWidth != 1 || s->elementHeight != 1 || s->memory == NULL) {
+		return;
+	}
+	/* Clip in logical coordinates: source surface and logical screen. */
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (w > (int32_t)fLogicalW - dx) {
+		w = (int32_t)fLogicalW - dx;
+	}
+	if (h > (int32_t)fLogicalH - dy) {
+		h = (int32_t)fLogicalH - dy;
+	}
+	if (w <= 0 || h <= 0) {
+		return;
+	}
+	uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow +
+	    (uint64_t)(sx + w) * 4;
+	if (last > s->memory->getLength()) {
+		return;
+	}
+	int32_t px0 = (dx * 32 + 24) / 25, px1 = ((dx + w) * 32 + 24) / 25;
+	int32_t py0 = fPadY + (dy * 32 + 24) / 25, py1 = fPadY + ((dy + h) * 32 + 24) / 25;
+	if (px1 > (int32_t)fWidth) {
+		px1 = (int32_t)fWidth;
+	}
+	if (py1 > (int32_t)fHeight) {
+		py1 = (int32_t)fHeight;
+	}
+	/*
+	 * Build each stretched row in a cached buffer and copy it to the panel
+	 * with one memcpy; repeated rows reuse the buffer. Per-pixel stores to
+	 * (and reads back from) the uncached framebuffer made every frame
+	 * visibly paint top to bottom on one CPU.
+	 */
+	static uint32_t rowbuf[2048];
+	static int32_t lxmap[2048];
+	if (px1 - px0 > 2048) {
+		px1 = px0 + 2048;
+	}
+	for (int32_t px = px0; px < px1; px++) {
+		int32_t lx = px * 25 / 32 - dx;
+		lxmap[px - px0] = lx < 0 ? 0 : (lx >= w ? w - 1 : lx);
+	}
+	const size_t rowlen = (size_t)(px1 - px0) * 4;
+	int32_t prev = -1;
+	for (int32_t py = py0; py < py1; py++) {
+		int32_t ly = (py - fPadY) * 25 / 32 - dy;
+		if (ly < 0) {
+			ly = 0;
+		} else if (ly >= h) {
+			ly = h - 1;
+		}
+		if (ly != prev) {
+			prev = ly;
+			const uint32_t *srow = (const uint32_t *)(src + s->offset + (uint64_t)(sy + ly) * s->bytesPerRow) + sx;
+			for (int32_t i = 0; i < px1 - px0; i++) {
+				rowbuf[i] = srow[lxmap[i]];
+			}
+		}
+		memcpy((void *)(fPixels + (uint64_t)py * fRowBytes + (uint64_t)px0 * 4), rowbuf, rowlen);
+	}
+}
