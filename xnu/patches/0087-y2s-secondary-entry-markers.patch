diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 741d0cf..29b1cf5 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -289,6 +289,16 @@ LEXT(bootstrap_instructions)
 	.globl EXT(y2s_secondary_entry)
 LEXT(y2s_secondary_entry)
 	msr		DAIFSet, #0xf
+	/* Marker: green = entered at EL1, yellow = EL2, red = other. */
+	mrs		x1, CurrentEL
+	MOV32	w2, 0xffff0000
+	cmp		x1, #0x4
+	b.ne	1f
+	MOV32	w2, 0xff00ff00
+1:	cmp		x1, #0x8
+	b.ne	2f
+	MOV32	w2, 0xffffff00
+2:	bl		Ly2s_secondary_mark
 	mrs		x1, CurrentEL
 	cmp		x1, #0x4
 	b.eq	Ly2s_secondary_el1
@@ -331,8 +341,28 @@ Ly2s_secondary_bad_el:
 	b		.
 Ly2s_secondary_el1:
 	/* x0 is deliberately unused; reset_vector selects CPU data by MPIDR. */
+	MOV32	w2, 0xff0000ff			// marker: blue = jumping to the reset vector
+	bl		Ly2s_secondary_mark
 	msr		SPSel, #1
 	b		EXT(LowResetVectorBase)
+/*
+ * S20 SMP bring-up marker: fill 24 rows of the boot framebuffer (MMU off,
+ * physical) at rows 3000 + 24 * x0 (x0 = context id = logical CPU) with w2.
+ * Clobbers x3-x6 only.
+ */
+Ly2s_secondary_mark:
+	MOV64	x3, (Y2S_FB_PA + 3000 * Y2S_FB_STRIDE)
+	MOV64	x4, (24 * Y2S_FB_STRIDE)
+	and		x5, x0, #7
+	madd	x3, x5, x4, x3
+	MOV64	x6, (24 * Y2S_FB_WIDTH)
+Ly2s_secondary_mark_loop:
+	str		w2, [x3], #4
+	subs	x6, x6, #1
+	b.ne	Ly2s_secondary_mark_loop
+	dsb		sy
+	ret
+
 #endif /* Y2S */
 
 	.align 2
