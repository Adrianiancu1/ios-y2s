+/*
+ * ufs_scsi_once, and if the host never processed the command (descriptor and
+ * response untouched), report the host state and restart the request list
+ * once, then retry.
+ */
+static int
+ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
+{
+	int error = ufs_scsi_once(cdb, cdb_len, len, write);
+	if (!error || !su.last_unprocessed) {
+		return error;
+	}
+	printf("Y2S UFS: unprocessed: rang %d IS 0x%x HCS 0x%x HCE 0x%x RSR 0x%x DBR 0x%x AHIT 0x%x LBA 0x%x\n",
+	    su.last_rang, su.last_is, ufs_rd(REG_HCS), ufs_rd(REG_HCE), ufs_rd(REG_UTRLRSR),
+	    ufs_rd(REG_UTRLDBR), ufs_rd(REG_AHIT), ufs_rd(REG_UTRLBA));
+	if (ufs_take_over_host() == 0) {
+		error = ufs_scsi_once(cdb, cdb_len, len, write);
+		printf("Y2S UFS: request list restarted, retry: %d\n", error);
+	}
+	return error;
+}
