+/*
+ * Get LUN 0 to answer TEST UNIT READY. A pending unit attention (sense key 6)
+ * is consumed by reporting it, so just retry. NOT READY (key 2), e.g. when
+ * the bootloader left the device in a low-power mode, needs START STOP UNIT
+ * (power condition ACTIVE) to the UFS Device W-LUN, as Linux sends at boot
+ * (ufshcd_set_dev_pwr_mode); the W-LUN may itself report a unit attention
+ * first, which REQUEST SENSE clears.
+ */
+static int
+ufs_wake_device(void)
+{
+	static const uint8_t tur[6] = { 0x00 };
+	static const uint8_t request_sense[6] = { 0x03, 0, 0, 0, 18, 0 };
+	static const uint8_t ssu_active[6] = { 0x1b, 0, 0, 0, 0x10, 0 };
+	int error = EIO;
+
+	for (int i = 0; i < 8; i++) {
+		su.target_lun = su.lun;
+		error = ufs_scsi(tur, sizeof(tur), 0, false);
+		if (!error) {
+			if (i) {
+				printf("Y2S UFS: LUN %u ready after %d tries\n", su.lun, i + 1);
+			}
+			return 0;
+		}
+		if (su.sense_key == 0x6) {
+			continue;               /* unit attention: reported now, cleared */
+		}
+		if (su.sense_key != 0x2) {
+			return error;
+		}
+		/* NOT READY: wake the device through the UFS Device W-LUN. */
+		su.target_lun = UFS_WLUN_DEVICE;
+		(void)ufs_scsi(request_sense, sizeof(request_sense), 18, false);
+		int ssu = ufs_scsi(ssu_active, sizeof(ssu_active), 0, false);
+		if (ssu) {
+			(void)ufs_scsi(request_sense, sizeof(request_sense), 18, false);
+			ssu = ufs_scsi(ssu_active, sizeof(ssu_active), 0, false);
+		}
+		printf("Y2S UFS: START STOP UNIT (active) to W-LUN 0x%x: %d\n", UFS_WLUN_DEVICE, ssu);
+		su.target_lun = su.lun;
+		delay(20000);                   /* 20 ms */
+	}
+	return error;
+}
