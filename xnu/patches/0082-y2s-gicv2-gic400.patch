 SECURITY_READ_ONLY_LATE(uint32_t) y2s_vtimer_intid = Y2S_VTIMER_INTID;
+
+/*
+ * GICv2 (GIC-400, e.g. Exynos 990) instead of GICv3. Chosen once on the boot
+ * CPU from /arm-io/gic "compatible". In this mode no ICC_* system register is
+ * ever touched: the CPU interface is the memory-mapped GICC, and the second
+ * "reg" pair of the GIC node is GICC instead of GICR.
+ */
+SECURITY_READ_ONLY_LATE(boolean_t) y2s_gic_v2 = FALSE;
+static vm_offset_t gicc_base;
+/* GICv2 CPU interface mask (GICD_ITARGETSR byte) per logical CPU, for SGIs. */
+static uint8_t y2s_gicv2_cpu_mask[GICV2_MAX_CPU_IF];
 #endif
 
 static vm_offset_t gicd_base;
@@ -49,6 +60,195 @@ _gic_write32(vm_offset_t addr, uint32_t value)
 #define gicr_read32(offset) (_gic_read32(gicr_pe_base + (offset)))
 #define gicr_write32(offset, data) (_gic_write32(gicr_pe_base + (offset), (data)))
 #define gicr_read64(offset) (_gic_read64(gicr_pe_base + (offset)))
+#if defined(Y2S)
+#define gicc_read32(offset) (_gic_read32(gicc_base + (offset)))
+#define gicc_write32(offset, data) (_gic_write32(gicc_base + (offset), (data)))
+
+/* Exact match of one entry of a NUL-separated "compatible" list. */
+static boolean_t
+y2s_compat_entry_is(const char *s, unsigned int len, const char *want)
+{
+	unsigned int i = 0;
+	for (; i < len && want[i] != '\0'; i++) {
+		if (s[i] != want[i]) {
+			return FALSE;
+		}
+	}
+	return i == len && want[i] == '\0';
+}
+
+static boolean_t
+y2s_gic_compatible_is_v2(DTEntry entry)
+{
+	void const *prop;
+	unsigned int size;
+	if (SecureDTGetProperty(entry, "compatible", &prop, &size) != kSuccess) {
+		return FALSE;
+	}
+	const char *list = (const char *)prop;
+	unsigned int start = 0;
+	while (start < size) {
+		unsigned int len = 0;
+		while (start + len < size && list[start + len] != '\0') {
+			len++;
+		}
+		const char *s = list + start;
+		if (y2s_compat_entry_is(s, len, "arm,gic-400") ||
+		    y2s_compat_entry_is(s, len, "arm,cortex-a15-gic") ||
+		    y2s_compat_entry_is(s, len, "arm,gic-v2")) {
+			return TRUE;
+		}
+		start += len + 1;
+	}
+	return FALSE;
+}
+
+/* Same mask Linux uses: this CPU's bit in the banked GICD_ITARGETSR0-7. */
+static uint8_t
+y2s_gicv2_local_cpu_mask(void)
+{
+	for (unsigned int i = 0; i < 32; i += 4) {
+		uint32_t mask = gicd_read32(GICD_ITARGETSR + i);
+		mask |= mask >> 16;
+		mask |= mask >> 8;
+		if (mask & 0xff) {
+			return (uint8_t)(mask & 0xff);
+		}
+	}
+	return 0;
+}
+
+static void
+y2s_gicv2_init_cpu(void)
+{
+	unsigned int cpu = (unsigned int)ml_get_cpu_number_local();
+	if (cpu >= GICV2_MAX_CPU_IF) {
+		panic("%s: logical CPU %u has no GICv2 CPU interface (max %u)",
+		    __func__, cpu, GICV2_MAX_CPU_IF);
+	}
+	uint8_t mask = y2s_gicv2_local_cpu_mask();
+	if (mask == 0) {
+		/*
+		 * GICv2 spec: in a uniprocessor implementation GICD_ITARGETSRn
+		 * are RAZ/WI (QEMU virt with -smp 1 does this). Only then is
+		 * CPU interface 0 the one and only target.
+		 */
+		uint32_t typer = gicd_read32(GICD_TYPER);
+		if (((typer >> GICD_TYPER_CPUNUMBER_SHIFT) & 0x7) != 0) {
+			panic("%s: GICD_ITARGETSR0-7 read 0 on CPU %u (GICD_TYPER 0x%x)",
+			    __func__, cpu, typer);
+		}
+		mask = 0x01;
+	}
+	__atomic_store_n(&y2s_gicv2_cpu_mask[cpu], mask, __ATOMIC_RELEASE);
+
+	/*
+	 * SGIs and PPIs are banked per CPU in the distributor. From the
+	 * non-secure side GICD_IGROUPR is RAZ/WI and Group 0 bits of the enable
+	 * and priority registers are WI: firmware must already have put these
+	 * in Group 1, which is what Linux on the same firmware relies on.
+	 * Priorities written here are the non-secure view.
+	 */
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicd_write32(GICD_IPRIORITYR + i, 0xA0A0A0A0);
+	}
+	gicd_write32(GICD_ISENABLER, (1U << y2s_vtimer_intid) | (1U << Y2S_IPI_SGI));
+
+	/* Accept everything above the lowest priority, no preemption groups. */
+	gicc_write32(GICC_PMR, 0xF0);
+	gicc_write32(GICC_BPR, 0);
+
+	/*
+	 * Distributor Group 1 forwarding (the NS alias of GICD_CTLR has only
+	 * this bit). Never clear anything: other CPUs and the secure side
+	 * share the distributor. Unlike Linux's gic_dist_init we do not reset
+	 * SPI configuration either.
+	 */
+	uint32_t gicd_ctlr = gicd_read32(GICD_CTLR);
+	if (!(gicd_ctlr & GICD_CTLR_ENABLEGRP1)) {
+		gicd_write32(GICD_CTLR, gicd_ctlr | GICD_CTLR_ENABLEGRP1);
+	}
+
+	/*
+	 * CPU interface: keep the bypass-disable bits as firmware left them
+	 * (like Linux gic_cpu_if_up), EOImodeNS=0 so one GICC_EOIR write both
+	 * drops priority and deactivates, Group 1 signalled as IRQ.
+	 */
+	uint32_t gicc_ctlr = gicc_read32(GICC_CTLR);
+	gicc_ctlr &= GICC_CTLR_BYPASS_MASK;
+	gicc_ctlr |= GICC_CTLR_ENABLEGRP1;
+	gicc_write32(GICC_CTLR, gicc_ctlr);
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+
+	kprintf("Y2S GICv2: cpu %u if-mask 0x%02x GICD_CTLR 0x%x GICC_CTLR 0x%x\n",
+	    cpu, mask, gicd_read32(GICD_CTLR), gicc_read32(GICC_CTLR));
+}
+
+/*
+ * Interrupt acknowledge/EOI for sleh_irq. Returns the raw IAR value (pass it
+ * back unchanged to y2s_gic_eoi: on GICv2 it carries the SGI source CPU)
+ * and stores the interrupt ID.
+ */
+uint32_t
+y2s_gic_ack(uint32_t *intid)
+{
+	if (y2s_gic_v2) {
+		uint32_t iar = gicc_read32(GICC_IAR);
+		*intid = iar & GICC_IAR_INTID_MASK;
+		return iar;
+	}
+	uint64_t iar = __builtin_arm_rsr64("ICC_IAR1_EL1");
+	*intid = (uint32_t)(iar & 0xFFFFFF);
+	return (uint32_t)iar;
+}
+
+void
+y2s_gic_eoi(uint32_t iar)
+{
+	if (y2s_gic_v2) {
+		gicc_write32(GICC_EOIR, iar);
+	} else {
+		__builtin_arm_wsr64("ICC_EOIR1_EL1", (uint64_t)iar);
+	}
+}
+
+/* Raise Y2S_IPI_SGI on a logical CPU. */
+void
+y2s_gic_send_ipi(unsigned int cpu, uint64_t target_mpidr)
+{
+	__builtin_arm_dsb(DSB_ISHST);
+	if (y2s_gic_v2) {
+		if (cpu == (unsigned int)ml_get_cpu_number_local()) {
+			/* TargetListFilter 0b10: the requesting CPU only. */
+			gicd_write32(GICD_SGIR, GICD_SGIR_TARGET_SELF | Y2S_IPI_SGI);
+			__builtin_arm_isb(ISB_SY);
+			return;
+		}
+		if (cpu >= GICV2_MAX_CPU_IF) {
+			panic("%s: CPU %u has no GICv2 CPU interface", __func__, cpu);
+		}
+		uint8_t mask = __atomic_load_n(&y2s_gicv2_cpu_mask[cpu], __ATOMIC_ACQUIRE);
+		if (mask == 0) {
+			panic("%s: CPU %u has not initialized its GICv2 CPU interface", __func__, cpu);
+		}
+		/* TargetListFilter 0 (use the list); NSATT is ignored for NS writes. */
+		gicd_write32(GICD_SGIR, ((uint32_t)mask << 16) | Y2S_IPI_SGI);
+	} else {
+		/* Use the TARGET affinity, including Aff1, never the sender's MPIDR. */
+		unsigned int aff0 = target_mpidr & 0xff;
+		if (aff0 >= 16) {
+			panic("%s: SGI target requires unsupported range selector", __func__);
+		}
+		uint64_t sgi = (((target_mpidr >> 32) & 0xff) << 48) |
+		    (((target_mpidr >> 16) & 0xff) << 32) |
+		    (((target_mpidr >> 8) & 0xff) << 16) |
+		    ((uint64_t)Y2S_IPI_SGI << 24) | (1ULL << aff0);
+		__builtin_arm_wsr64("ICC_SGI1R_EL1", sgi);
+	}
+	__builtin_arm_isb(ISB_SY);
+}
+#endif /* Y2S */
 
