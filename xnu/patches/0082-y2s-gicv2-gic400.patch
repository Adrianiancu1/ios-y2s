diff --git a/pexpert/pexpert/arm64/Y2S.h b/pexpert/pexpert/arm64/Y2S.h
index b99c2f4..b6a6e8f 100644
--- a/pexpert/pexpert/arm64/Y2S.h
+++ b/pexpert/pexpert/arm64/Y2S.h
@@ -80,4 +80,30 @@
 #define ICC_SRE_SRE                             0x1
 /* End of GICv3 register definitions */
 
+/*
+ * GICv2 (GIC-400) register definitions, non-secure view; see GICv2 spec
+ * (Arm IHI 0048B) and the GIC-400 TRM. Used when /arm-io/gic is
+ * "arm,gic-400" (Exynos 990): reg = <GICD base, size, GICC base, size>.
+ */
+#define GICV2_MAX_CPU_IF          8       // GICv2 supports at most 8 CPU interfaces
+
+#define GICD_TYPER                0x004
+#define GICD_TYPER_CPUNUMBER_SHIFT 5      // bits [7:5]: number of CPU interfaces - 1
+#define GICD_ISENABLER            0x100   // banked word 0: SGIs + PPIs
+#define GICD_IPRIORITYR           0x400
+#define GICD_ITARGETSR            0x800   // words 0-7 banked, read-only
+#define GICD_SGIR                 0xF00
+#define GICD_SGIR_TARGET_SELF     (0x2U << 24) // TargetListFilter: requesting CPU only
+
+#define GICC_CTLR                 0x00
+#define GICC_PMR                  0x04
+#define GICC_BPR                  0x08
+#define GICC_IAR                  0x0C
+#define GICC_EOIR                 0x10
+
+#define GICC_CTLR_ENABLEGRP1      0x1     // NS view: bit 0 enables Group 1
+#define GICC_CTLR_BYPASS_MASK     0x1E0   // FIQ/IRQBypDisGrp0/1
+#define GICC_IAR_INTID_MASK       0x3FF
+/* End of GICv2 register definitions */
+
 #endif /* ! _PEXPERT_ARM64_Y2S_H */
